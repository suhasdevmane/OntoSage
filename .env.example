# ╔════════════════════════════════════════════════════════════════════════════╗
# ║                OntoSage 2.0 Environment Configuration                      ║
# ║                                                                            ║
# ║  QUICK START:                                                             ║
# ║  1. For FREE local models:  Copy .env.local to .env                       ║
# ║  2. For PAID cloud models:  Copy .env.cloud to .env and add OpenAI key   ║
# ║  3. Run: ./startup.ps1                                                    ║
# ╚════════════════════════════════════════════════════════════════════════════╝


# ==================== 🎯 MODEL PROVIDER SELECTION ====================
# Core decision: Where do models run?
#
# LOCAL OPTION (Recommended for testing):
#   - MODEL_PROVIDER=local
#   - EMBEDDING_PROVIDER=local
#   - STT_PROVIDER=local
#   - ✅ FREE (no API costs)
#   - ✅ Privacy (data stays local)
#   - ✅ No rate limits
#   - ⚠️ Slower inference
#   - ⚠️ Requires 8GB+ RAM
#   - Uses: Ollama (OLLAMA_MODEL below), sentence-transformers, faster-whisper
#   - NOTE: MODEL_PROVIDER also auto-falls-back to 'local' whenever
#     MODEL_PROVIDER=openai is set but OPENAI_API_KEY is blank.
#
# CLOUD OPTION (Recommended for production):
#   - MODEL_PROVIDER=openai
#   - EMBEDDING_PROVIDER=openai
#   - STT_PROVIDER=openai
#   - ✅ Fast inference
#   - ✅ State-of-the-art models
#   - ⚠️ Costs money (~$0.01 per 1K tokens)
#   - ⚠️ Requires internet
#   - ⚠️ Needs OpenAI API key
#   - Uses: GPT-4, ada-002, Whisper API

MODEL_PROVIDER=local
EMBEDDING_PROVIDER=local
STT_PROVIDER=local


# ==================== ☁️ OPENAI CONFIGURATION ====================
# Required only if MODEL_PROVIDER=openai, EMBEDDING_PROVIDER=openai, or STT_PROVIDER=openai
#
# Get your API key from: https://platform.openai.com/api-keys
# Pricing: https://openai.com/pricing
#
# SECURITY WARNING:
# - Never commit .env with real API keys to Git
# - Rotate keys if exposed
# - Monitor usage: https://platform.openai.com/usage

# Your OpenAI API key (starts with sk-...)
OPENAI_API_KEY=your_openai_api_key_here

# LLM Model for conversations, SPARQL generation, analytics
# Options:
#   - gpt-4-turbo-preview (best quality, $0.01/1K tokens input, $0.03/1K output)
#   - gpt-4 (proven stable, $0.03/1K input, $0.06/1K output)
#   - gpt-3.5-turbo (cheapest, $0.0005/1K input, $0.0015/1K output)
OPENAI_MODEL=gpt-4-turbo-preview

# Temperature: Controls randomness (0.0 = deterministic, 1.0 = creative)
# For ontology queries: 0.0-0.2 recommended (precise)
# For conversations: 0.5-0.7 (natural)
OPENAI_TEMPERATURE=0.1
# Retry backoff for OpenAI (seconds) to avoid 429 thrashing
OPENAI_RETRY_DELAY_S=20

# Embedding model for RAG (Retrieval-Augmented Generation)
# Options:
#   - text-embedding-3-small (recommended, 1536 dims, $0.00002/1K tokens)
#   - text-embedding-3-large (best quality, 3072 dims, $0.00013/1K tokens)
#   - text-embedding-ada-002 (legacy, 1536 dims, $0.0001/1K tokens)
EMBEDDING_MODEL_OPENAI=text-embedding-3-small
EMBEDDING_DIMENSION_OPENAI=1536

# Whisper STT (Speech-to-Text)
# Fixed model: whisper-1 ($0.006/minute)
# Max file size: 25MB
# Supports: mp3, mp4, mpeg, mpga, m4a, wav, webm


# ==================== 🖥️ LOCAL MODEL CONFIGURATION ====================
# Used only if MODEL_PROVIDER=local, EMBEDDING_PROVIDER=local, or STT_PROVIDER=local

# Ollama (Local LLM)
# Two ways to run Ollama:
#   1. Natively on the host (simplest — just `ollama serve`, any OS/GPU):
#      docker-compose.yml reaches it via host.docker.internal:11434 (Ollama's
#      default port). Nothing else to configure.
#   2. Inside Docker with GPU passthrough (NVIDIA only):
#      docker compose --profile local-gpu up -d  (see the commented `ollama:`
#      service in docker-compose.yml)
# Verify from the host: curl http://localhost:11434/api/tags
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Model to use — must already be pulled (`ollama pull <name>`, or `ollama list`
# to see what's installed). Any tag with tool/function-calling support works
# best; check via: curl http://localhost:11434/api/tags | grep -A2 '"name"'
# Default gpt-oss:20b — fully fits a 16GB GPU (100% on-GPU, ~6x faster than a
# CPU-offloaded 26b). Larger models (gemma4:26b/31b, ~18-20GB) spill to CPU on a
# 16GB card and run much slower. Admin can change this here or in the AI & Models tab.
OLLAMA_MODEL=gpt-oss:20b

# Local Embeddings (sentence-transformers)
# Model is downloaded on first use (~90MB)
# Options:
#   - sentence-transformers/all-MiniLM-L6-v2 (384 dims, fast, good quality)
#   - sentence-transformers/all-mpnet-base-v2 (768 dims, slower, better quality)
#   - sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2 (384 dims, multilingual)
EMBEDDING_MODEL_LOCAL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION_LOCAL=384

# Local Whisper (faster-whisper)
# Model size affects accuracy vs speed (download size shown)
# Options:
#   - tiny (39MB, fast, low accuracy)
#   - base (74MB, balanced, recommended)
#   - small (244MB, good accuracy)
#   - medium (769MB, better accuracy)
#   - large (2.9GB, best accuracy, slow)
WHISPER_MODEL_LOCAL=base


# ==================== 🔗 SERVICE URLS ====================
# Internal Docker network URLs (do not change unless modifying docker-compose.yml)

# Qdrant Vector Database (semantic search)
# Stores ontology embeddings, query history
# Dashboard: http://localhost:6333/dashboard
QDRANT_URL=http://qdrant:6333

# Redis (conversation state, caching)
# Stores conversation history, SPARQL cache, user preferences
# TTL: CONVERSATION_TTL seconds (default: 3600 = 1 hour)
REDIS_URL=redis://redis:6379/0

# RAG Service (Retrieval-Augmented Generation)
# Provides ontology context for SPARQL generation
# Health check: http://localhost:8001/health
RAG_SERVICE_URL=http://rag-service:8001

# Code Executor (Sandboxed Python execution)
# Runs analytics code in isolated environment
# Security: SAFE_BUILTINS only, no os/sys/subprocess
CODE_EXECUTOR_URL=http://code-executor:8002
CODE_EXECUTOR_TIMEOUT=30              # Max execution time (seconds)
CODE_EXECUTOR_MEMORY_LIMIT=1g         # RAM limit per execution
CODE_EXECUTOR_CPU_LIMIT=1.0           # CPU cores (1.0 = 1 full core)

# Whisper STT (Speech-to-Text)
# Converts audio to text for voice queries
WHISPER_STT_URL=http://whisper-stt:8003


# ==================== 🗄️ MULTI-DATABASE REGISTRY ====================
# config/database_registry.yaml maps TTL storedAt identifiers → adapters.
# Add env vars here for each new database you reference in your TTL files.
#
# TTL example:  _:ref ref:storedAt bldg:database4 .
# YAML maps:    database4: { type: mongodb, host: ${MONGO_HOST}, ... }

# ── PostgreSQL (Building 2) ──────────────────────────────────────────
PG_HOST=postgres
PG_PORT=5432
PG_USER=ontosage
PG_PASSWORD=ontosage
PG_DATABASE=bldg2

# ── TimescaleDB (Building 3) ─────────────────────────────────────────
TIMESCALE_HOST=timescaledb
TIMESCALE_PORT=5432
TIMESCALE_USER=ontosage
TIMESCALE_PASSWORD=ontosage
TIMESCALE_DATABASE=bldg3

# ── MongoDB (Building 4) ─────────────────────────────────────────────
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_USER=
MONGO_PASSWORD=
MONGO_DATABASE=bldg4
MONGO_COLLECTION=sensor_data

# ── InfluxDB 2.x (Building 5) ────────────────────────────────────────
INFLUX_URL=http://influxdb:8086
INFLUX_TOKEN=your_influx_token_here   # ⚠️ Required — generate in InfluxDB UI
INFLUX_ORG=ontosage
INFLUX_BUCKET=sensors

# ── SQLite local file (Building 6) ───────────────────────────────────
SQLITE_PATH=/app/data/bldg6.db

# ── Apache Cassandra (Building 7) ────────────────────────────────────
CASSANDRA_HOST=cassandra
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=bldg7
CASSANDRA_USER=
CASSANDRA_PASSWORD=
CASSANDRA_TABLE=sensor_data

# ── Redis TimeSeries (Building 8) ────────────────────────────────────
REDIS_TS_URL=redis://redis:6379/1
REDIS_TS_PASSWORD=
REDIS_TS_KEY_PREFIX=sensor


# ==================== 🏢 BUILDING CONFIGURATION ====================
#
# OntoSage v1 serves ONE building at a time.  The active building's files live
# DIRECTLY in `input/` (flat layout) — no per-building subdirectory.
#
# Active building files: input/building.yaml, input/capability.yaml,
#   input/feeds.yaml, input/rules.yaml, input/intents.yaml,
#   input/<bldg>_*.ttl, input/data/, input/documents/, input/personas/
#
# Shared files (leave in place): input/Brick_v1.4.ttl, input/Brick+extensions.ttl,
#   input/Abacws floor *.dwg/pdf, input/_templates/, input/database_registry.yaml
#
# To swap to a new building safely:
#   1. Stage the new building's files into input/<new_id>/
#   2. python scripts/swap_building.py --to <new_id> --dry-run   (validate)
#   3. python scripts/swap_building.py --to <new_id> --archive   (apply + archive old)
#   4. docker-compose restart orchestrator
#
# The TTL validator runs at startup and HARD-FAILS the boot if any TTL's
# `@prefix bldg:` does not match the ontology_namespace declared in
# `input/building.yaml`.
#
# OntoSage v2 (Onto-community) will support multiple simultaneous buildings.

# ── Building identity ────────────────────────────────────────────────────────
# These seven values ARE the active building. They must agree with
# input/building.yaml and with the @prefix bldg: declared in your TTL — the
# orchestrator hard-fails on a mismatch rather than answering from the wrong graph.
# Each building folder carries its own copy in <folder>/env.building; when you
# activate a building, copy that block over the values below.
#
# Using your OWN building? Choose a NEW BUILDING_ID. Per-building state lives in
# volumes/<BUILDING_ID>/, so a new id starts from an empty GraphDB/Qdrant/Redis,
# while reusing a shipped id inherits that demo building's triples.

# Building identifier (drives volumes/<id>/*, logs, responses; matches input/building.yaml)
BUILDING_ID=bldg1
BUILDING_NAME=Abacws Building
# Ontology identity — MUST equal `@prefix bldg:` in your TTL and `ontology_namespace`
# in input/building.yaml, trailing '#' included.
BUILDING_NAMESPACE=http://abacwsbuilding.cardiff.ac.uk/abacws#
BUILDING_PREFIX=bldg
# IANA timezone used to interpret "today" / "yesterday" in questions.
BUILDING_TIMEZONE=Europe/London
# Namespaces this building's containers, networks and named volumes.
COMPOSE_PROJECT_NAME=ontosage_bldg1

# Optional — enable SHACL Brick conformance check on each TTL at startup.
# Requires the brickschema package; adds 5–30s per file.  Off by default.
# TTL_VALIDATION_SHACL=false

# Fuseki SPARQL Endpoint
# Triple store for Brick ontology (Building 1 sensors, locations, equipment)
# Query UI: http://localhost:3030/#/dataset/abacws/query
# Dataset contains:
#   - ~500 triples (sensors, spaces, equipment, relationships)
#   - Brick Schema classes (hasLocation, feeds, isPointOf, etc.)
FUSEKI_URL=http://fuseki:3030/abacws

# MySQL — time-series sensor readings
#
# ⚠️ MySQL IS A HOST PREREQUISITE. There is no MySQL container: the service block in
# docker-compose.yml is commented out, and every deployment here talks to a MySQL running
# on the Docker host. `docker compose up -d` will NOT provide one.
#
# This block used to read `MYSQL_HOST=mysql` and `MYSQL_DATABASE=abacws`, and both were
# wrong for a fresh clone: `mysql` resolves to nothing because that service is commented
# out, and the live database is `sensordb` — `abacws` is the legacy name that
# data/mysql-init/init.sql still creates. A clone copying this file booted green and
# failed every sensor question, with nothing naming the cause.
#
# Before starting the stack:
#   1. Install/run MySQL 8 on the host, listening on 3306
#   2. Create the database and a user that can read it
#   3. Load readings (see README) — an empty database answers nothing, honestly
#
# To use a CONTAINERISED MySQL instead, uncomment the `mysql:` service block in
# docker-compose.yml and set MYSQL_HOST=mysql here.
MYSQL_HOST=host.docker.internal       # the Docker host, not a container
MYSQL_PORT=3306
MYSQL_USER=ontosage
MYSQL_PASSWORD=change-me              # ⚠️ STRICT_SECRETS refuses to boot on a default
MYSQL_DATABASE=sensordb

# PostgreSQL Database (ThingsBoard)
# Contains:
#   - ThingsBoard device registry, telemetry, and time-series data
#   - Used for IoT device management and sensor data storage
# Access via pgAdmin: http://localhost:5050
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=thingsboard
POSTGRES_PASSWORD=thingsboard         # ⚠️ Change in production!
POSTGRES_DB=thingsboard

# pgAdmin (PostgreSQL Web UI)
# Web interface for managing PostgreSQL databases
# Access: http://localhost:5050
# Login with credentials below
PGADMIN_DEFAULT_EMAIL=pgadmin@example.com
PGADMIN_DEFAULT_PASSWORD=admin        # ⚠️ Change in production!


# ==================== 🏗️ ABACWS API & VISUALISER CONFIGURATION ====================
# Building management API with support for multiple database backends

# API Key for authentication
API_KEY=change_me                     # ⚠️ Change in production!

# Database Engine Selection
# Options: mysql, postgres, mongo, disabled
API_DB_ENGINE=mysql

# Abacws API PostgreSQL Connection (when API_DB_ENGINE=postgres)
API_PGHOST=postgres
API_PGPORT=5432
API_PGUSER=thingsboard
API_PGPASSWORD=thingsboard
API_PGDATABASE=thingsboard

# Abacws API MySQL Connection (when API_DB_ENGINE=mysql)
API_MYSQL_HOST=mysql-bldg1
API_MYSQL_PORT=3307
API_MYSQL_USER=root
API_MYSQL_PASSWORD=mysql
API_MYSQL_DATABASE=sensordb

# Abacws Visualiser Debug Mode
# Set to '1' to enable verbose 3D loader logging in browser console
ABACWS_DEBUG=0


# ==================== 🌐 THINGSBOARD IOT PLATFORM CONFIGURATION ====================
# ThingsBoard for sensor management and IoT device connectivity

# ThingsBoard PostgreSQL Database
# Uses the same Postgres container as other services
PG_THINGSBOARD_DB=thingsboard
PG_THINGSBOARD_USER=thingsboard
PG_THINGSBOARD_PASSWORD=thingsboard

# ThingsBoard Access
# Web UI: http://localhost:8082
# Default credentials: tenant@thingsboard.org / tenant
# MQTT Port: 1883
# HTTP Port: 8081


# ==================== 💬 CONVERSATION SETTINGS ====================

# Conversation state TTL (seconds)
# 0 = no time-based expiry; bounded instead by CONVERSATION_MAX_MESSAGES below.
# Set to e.g. 3600 (1h) or 86400 (24h) to re-enable time-based expiry.
CONVERSATION_TTL=0

# Max verbatim messages kept per conversation in the Redis blob (count-based eviction)
# Older messages are dropped (sliding window). 20 = 10 user + 10 assistant.
CONVERSATION_MAX_MESSAGES=20

# Max prior turns injected into LLM context from Redis
MAX_CONVERSATION_HISTORY=20

# Max retry attempts for failed operations
# Applies to:
#   - SPARQL query errors (auto-repair)
#   - Code execution errors (auto-fix)
#   - LLM API failures (retry with backoff)
MAX_RETRY_ATTEMPTS=3


# ==================== 🌦️ LIVE-DATA AUGMENTATION (general knowledge) ====================
# When a general-knowledge question needs CURRENT info the LLM can't know from its
# training cutoff (weather, latest news/prices/versions), the general_knowledge node
# fetches live data and asks the LLM to summarise it.

# Master switch + per-capability toggles
LIVE_DATA_ENABLED=true
WEATHER_ENABLED=true        # Open-Meteo (free, no API key)
WEB_SEARCH_ENABLED=true

# Web-search backend: 'duckduckgo' (free, keyless — DEFAULT) | 'tavily' | 'none'
WEB_SEARCH_PROVIDER=duckduckgo

# Tavily (optional, better LLM-ready results). Only used when WEB_SEARCH_PROVIDER=tavily.
# Get a free key at https://app.tavily.com. Falls back to DuckDuckGo if empty or failing.
TAVILY_API_KEY=

# Max results fed to the summariser, and per-fetch timeout (seconds)
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_S=8.0


# ==================== 📊 QDRANT COLLECTION CONFIGURATION ====================
# Vector database collections (created by scripts/init_qdrant.py)

# Collection names
QDRANT_ONTOLOGY_COLLECTION=ontology   # Brick Schema triples
QDRANT_QUERIES_COLLECTION=queries     # Historical SPARQL queries
QDRANT_ANALYTICS_COLLECTION=analytics # Analytics code snippets
QDRANT_DOCS_COLLECTION=documentation  # System docs, help text

# Vector similarity threshold (0.0-1.0)
# Higher = stricter matching (fewer, more relevant results)
# Lower = looser matching (more results, less relevant)
# 0.7 = good balance
SIMILARITY_THRESHOLD=0.7

# Max results returned per RAG query
# More results = more context for LLM but slower inference
RAG_TOP_K=5


# ==================== 🔐 SECURITY SETTINGS ====================

# Code Executor Sandbox
# Forbidden imports (security): os, sys, subprocess, socket, requests, urllib
# Allowed imports: pandas, numpy, matplotlib, plotly, datetime, math, statistics
# All code runs in isolated environment with resource limits

# Pipeline API key — bearer key required on the OpenAI-compatible
# /v1/chat/completions endpoint (sent by Open WebUI as OPENAI_API_KEY).
# MUST be changed from the default in production; STRICT_SECRETS=true refuses
# startup if left at the default. Comma-separate multiple keys for rotation.
PIPELINE_API_KEY=sk-ontobot-pipeline

# STRICT_SECRETS — default True (refuses startup when any password is the insecure
# default). COOKIE_SECURE — default True (sets Secure flag on session cookie; must
# be false when the stack runs over plain HTTP).
#
# ---- LOCAL DEV ONLY — uncomment both lines below for local HTTP development ----
# STRICT_SECRETS=false
# COOKIE_SECURE=false
# ---------------------------------------------------------------------------------

# File upload limits (Whisper STT)
MAX_UPLOAD_SIZE_MB=25                 # OpenAI Whisper limit
ALLOWED_AUDIO_FORMATS=wav,mp3,m4a,ogg,webm


# ==================== 📝 LOGGING ====================

# Log level controls verbosity
# Options:
#   - DEBUG: Everything (function calls, variables, SQL queries)
#   - INFO: Important events (requests, responses, errors)
#   - WARNING: Potential issues (retries, timeouts)
#   - ERROR: Failures only
# Production: INFO, Development: DEBUG
LOG_LEVEL=INFO

# Log format (Python logging)
# %(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s


# ==================== 🎨 FRONTEND CONFIGURATION ====================

# React app proxies /api/* to orchestrator
# Set via REACT_APP_API_URL in frontend/.env
# Default: http://localhost:8000 (local development)
# Production: Update to public orchestrator URL


# ==================== 📈 MONITORING (OPTIONAL) ====================
# Enable with: docker-compose --profile monitoring up -d

# Prometheus (metrics)
# Scrapes: orchestrator, rag-service, code-executor, whisper-stt, redis, qdrant, mysql
# UI: http://localhost:9090

# Grafana (dashboards)
# UI: http://localhost:3001
# Login: admin/admin
# Dashboards: OntoSage Overview (service health, latency, throughput)


# ==================== CAPABILITY SEMANTIC ROUTING ====================
# Migration flag for the capability intent routing refactor (added 2026-05-21).
# See docs/superpowers/specs/2026-05-21-capability-semantic-routing-design.md
#
# When false (default): legacy keyword-based routing in dialogue_agent.py
#   (_CAPABILITY_KW + _STRONG_FACILITY_KW frozensets + CapabilityKB.search()).
# When true: SemanticRouter classifies via Qdrant before LLM intent call.
#   Requires capability_<bldg> collection in Qdrant — created automatically by
#   CapabilityIndexer at orchestrator startup if a capability.yaml exists for
#   that building.
#
# Per-building tuning (threshold, top_k, override_min) lives in
# input/<bldg>/building.yaml under `capability_routing:`.
CAPABILITY_SEMANTIC_ROUTING_ENABLED=false

# Toggleable synthetic data sources + per-answer provenance tags + config panel
# (http://127.0.0.1:3001). When true: loads input/datasources.yaml, exposes the
# /api/v1/datasources admin API, gates disabled-source questions with a
# locked-capability decline, and tags answers with per-source provenance chips.
# See tasks/IMPLEMENTATION_PLAN_DATASOURCE_TOGGLES_AND_PROVENANCE.md.
DATASOURCE_TOGGLES_ENABLED=false

# Admin bootstrap for the console at http://127.0.0.1:3001. When BOTH are set,
# the orchestrator creates this admin-role user at startup if it doesn't already
# exist (safe-create: never overwrites an existing account). Leave blank to skip.
# This is the account you sign in with to manage .env, databases, and users.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# TTL for Redis-cached embeddings (cache:embed:* keys). Default 24h.
# Embeddings are deterministic per (text, provider, model), so a long TTL
# minimises OpenAI/local-model load. Lower this for testing churn.
EMBEDDING_CACHE_TTL_SECONDS=86400


# ==================== 🛠️ DEVELOPMENT SETTINGS ====================

# Hot reload (for development)
# Set to 'true' to enable auto-restart on code changes
# Requires mounting code as volumes in docker-compose.yml
# DEV_MODE=false

# Skip model downloads (if already cached)
# SKIP_MODEL_DOWNLOAD=false

# Use mock LLM responses (for testing without LLM)
# MOCK_LLM=false


# ╔════════════════════════════════════════════════════════════════════════════╗
# ║  TROUBLESHOOTING                                                          ║
# ║                                                                            ║
# ║  • Services not starting?                                                 ║
# ║    → Run: docker-compose logs <service_name>                             ║
# ║    → Check: Docker has 8GB+ RAM allocated (Docker Desktop settings)      ║
# ║                                                                            ║
# ║  • Ollama model not found?                                                ║
# ║    → Run on the HOST (not in Docker): ollama pull gpt-oss:20b            ║
# ║    → Verify: curl http://localhost:11434/api/tags                       ║
# ║                                                                            ║
# ║  • OpenAI API errors?                                                     ║
# ║    → Verify: OPENAI_API_KEY is valid                                     ║
# ║    → Check: https://platform.openai.com/usage for rate limits           ║
# ║                                                                            ║
# ║  • Qdrant collections not found?                                          ║
# ║    → Run: docker-compose exec orchestrator python -m scripts.init_qdrant ║
# ║                                                                            ║
# ║  • No ontology data?                                                      ║
# ║    → Run: docker-compose exec rag-service python -m scripts.ingest_ontology ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# ── Per-user RBAC through the chat proxy ─────────────────────────────────────
# Open WebUI authenticates with ONE shared PIPELINE_API_KEY, so without this every
# chat user reaches OntoSage as the same least-privilege identity and roles cannot
# differentiate answers. With it on, the proxy's forwarded identity header is
# resolved to that OntoSage account and ITS role drives RBAC — a readonly user is
# declined a setpoint change, a facility_manager gets it queued for approval.
#
# Safe in the shipped Docker topology because Open WebUI is the sole holder of
# PIPELINE_API_KEY on the internal network. Set to false if port 8000 is reachable
# by anything else: with the key, a caller could otherwise set the header themselves
# and claim any role.
TRUST_FORWARDED_USER=true
FORWARDED_USER_HEADER=X-OpenWebUI-User-Email

# ══════════════════════════════════════════════════════════════════════════════
#  SETTINGS THE RUNNING SYSTEM USES THAT THIS FILE NEVER MENTIONED
# ══════════════════════════════════════════════════════════════════════════════
#
# Thirty-one keys were live in `.env` and absent here, so a fresh clone booted with
# the code defaults for all of them and had no way to discover that they existed --
# including the GraphDB connection, the strict-secrets boot guard, the model context
# window and the PROTECT enforcement switch (CAVEAT-449).
#
# EVERY SECRET BELOW IS A PLACEHOLDER. This file is committed; a real value here is
# the security incident the file exists to prevent.

# ── GraphDB connection ───────────────────────────────────────────────────────
# The repository is `bldg` for every building. Per-building isolation comes from the
# NAMESPACE and from volumes/<BUILDING_ID>/, not from a separate repository -- so this
# value does NOT change when you swap buildings.
GRAPHDB_URL=http://graphdb:7200
GRAPHDB_REPOSITORY=bldg
GRAPHDB_USER=admin
GRAPHDB_PASSWORD=change-me
# Vector similarity inside GraphDB, used by the RAG fallback when SPARQL returns nothing.
GRAPHDB_USE_SIMILARITY=true
GRAPHDB_SIMILARITY_INDEX=bldg_index

# ── Boot guard ───────────────────────────────────────────────────────────────
# Refuses to start when any password still equals its shipped default. Leave it ON
# for anything reachable from outside this machine; set false only for local dev.
STRICT_SECRETS=true

# ── Local model (Ollama) ─────────────────────────────────────────────────────
# OLLAMA_NUM_CTX must be large enough for the longest prompt this system builds.
# At 8192 it silently returned EMPTY completions for 2.7% of turns against a
# 29,705-character prompt (BUG-188); 16384 costs about 200 MiB and keeps the model
# entirely on GPU.
OLLAMA_NUM_CTX=16384
# Most tokens one local call may generate, reasoning included. Without it a reasoning model
# that never stops fills the whole context (161 s, empty answer) and every other user queues
# behind it (CAVEAT-727). 8192 cut 6 of 7,167 measured real completions. 0 = unlimited.
OLLAMA_NUM_PREDICT=8192

# Claim binding (ARCH-02). Every figure an answer states must appear in that turn's own
# evidence. Measured over 147 recorded answers: 58 of 709 claims (8.2%), in 31% of answers,
# were stated without support. record = count only; true = remove the sentence carrying an
# unevidenced figure and say so. Universals and inferences are caveated, never deleted.
CLAIM_BINDING_ENABLED=false
OLLAMA_KEEP_ALIVE=30m
LLM_TIMEOUT_S=180
# ── Deliberation (ARBITER) ──────────────────────────────────────────────────
# Ablation switch from the V4-T29 experiment arms, read at CALL time so a run can toggle
# it without a restart. With it on, the deliberation lane never asks its one clarifying
# question: it proceeds on declared assumptions instead. Leave it off outside an
# experiment — an unasked question becomes an undeclared guess.
# It existed in the code and in no Settings, no .env and no .env.example (W4-1).
DELIBERATE_CLARIFY_OFF=false
# 0 = derive from LLM_TIMEOUT_S. The workflow deadline must OUTLAST one full-length LLM
# call: leaving it unset used to mean 120s against an LLM allowed 180s, so any multi-step
# lane was killed mid-flight and reported a degraded answer (BUG-473).
WORKFLOW_TIMEOUT_S=0
# Reasoning effort for models that accept it. Empty means "use the model's default".
LLM_REASONING_EFFORT=

# ── Hosted Ollama (MODEL_PROVIDER=cloud) ─────────────────────────────────────
OLLAMA_CLOUD_BASE_URL=https://ollama.com/v1
OLLAMA_CLOUD_MODEL=gpt-oss:120b-cloud
OLLAMA_CLOUD_API_KEY=

# ── OpenAI (MODEL_PROVIDER=openai) ───────────────────────────────────────────
# The cheaper model used for short, high-volume calls (classification, rewriting).
OPENAI_MODEL_FAST=gpt-4o-mini
AGENT_MEMORY_EMBED_MODEL=text-embedding-3-large

# ── Feature switches ─────────────────────────────────────────────────────────
# Capabilities are ontosage:Amenity / ontosage:KnowledgeTopic TRIPLES, not a sidecar
# YAML (TODO-012). Leave true.
CAPABILITIES_TTL_FIRST=true
# PROTECT policy decision point: `on` enforces, `shadow` logs the verdict without
# applying it. Run shadow first on a new building, then switch to on.
PROTECT_ENFORCE=on
# Which retrieval-augmented path the rag-service serves.
RAG_SYSTEM=graphdbRAG
# Set true when the app is served over HTTPS, so session cookies are marked Secure.
COOKIE_SECURE=false

# ── MySQL root, for the container's own init ─────────────────────────────────
MYSQL_ROOT_PASSWORD=change-me

# ── Optional: a second, EXTERNAL datasource for the onboarding demo ──────────
# Only needed to exercise "register a database you did not ship with". Leave unset
# and the admin Databases tab simply has one fewer example.
DEMO_EXTERNAL_HOST=demo-mysql
DEMO_EXTERNAL_PORT=3306
DEMO_EXTERNAL_USER=demo
DEMO_EXTERNAL_PASSWORD=change-me
DEMO_EXTERNAL_DATABASE=demodb

# ── Optional: the datasource-wizard test target ──────────────────────────────
# Used by the onboarding wizard's "test connection" step. Unset is fine.
WIZTEST_HOST=host.docker.internal
WIZTEST_PORT=3306
WIZTEST_USER=change-me
WIZTEST_PASSWORD=change-me
WIZTEST_DATABASE=sensordb

# ==================== ⚙️ EVERY REMAINING SETTING THE CODE READS ====================
#
# V12-27. `Settings` in shared/config.py read 122 settings; this template named 69 of
# them. The other 53 were undiscoverable: a fresh clone booted on their code defaults with
# no way to learn they existed, which is the deployment half of the failure this project
# keeps finding elsewhere — the thing works, and nothing tells you what it is doing.
#
# Two of the 53 were worse than undiscoverable. `STRICT_SECRETS=true` REFUSES TO BOOT when
# a password equals its default, and both `SECRET_KEY` and `POSTGRES_USER_PASSWORD` were
# absent here — so a fresh clone met a boot refusal naming settings this file had never
# mentioned.
#
# Every value below is the DEFAULT the code already uses, copied from shared/config.py.
# Uncommenting a line changes nothing until you edit it; that is the point — you can see
# what the system is doing before you decide to change it.
#
# `tests/test_every_setting_is_discoverable.py` derives this list from the Settings class
# and fails when a new field is added without a line here. It does NOT skip in a parked
# tree, unlike the older live-.env comparison, which could only run where a live .env
# existed — that is, never in CI and never in a fresh clone.

# ── Service hosts and ports (the URLs above are built from these) ─────────────
# Container names, because that is what compose resolves. Change only when running a
# service outside the compose network.
# GRAPHDB_HOST=graphdb
# GRAPHDB_PORT=7200
# REDIS_HOST=redis
# REDIS_PORT=6379
# RAG_SERVICE_HOST=rag-service
# RAG_SERVICE_PORT=8001
# CODE_EXECUTOR_HOST=code-executor
# CODE_EXECUTOR_PORT=8002
# FUSEKI_HOST=jena-fuseki
# FUSEKI_PORT=3030

# ── Users / RBAC database (Postgres) ─────────────────────────────────────────
# SEPARATE from the timeseries Postgres above. POSTGRES_USER_PASSWORD is one of the four
# STRICT_SECRETS checks: leave it at the default and the orchestrator refuses to boot.
# POSTGRES_USER_HOST=postgres-user-data
# POSTGRES_USER_PORT=5432
# POSTGRES_USER_DB=ontobot
# POSTGRES_USER_USER=ontobot
# POSTGRES_USER_PASSWORD=ontobot_secret

# ── Session signing ──────────────────────────────────────────────────────────
# The second STRICT_SECRETS check. 32 random bytes; `python -c "import secrets;
# print(secrets.token_urlsafe(32))"` produces one.
# SECRET_KEY=change-me-in-production-use-32-random-bytes

# ── Authentication policy ────────────────────────────────────────────────────
# ADMIN_USERNAMES is a comma-separated list; those accounts get system:admin.
# ADMIN_USERNAMES=admin
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_SECONDS=900
# RBAC_ENABLED=true
# CORS_ORIGINS=*
# TRUSTED_PROXY_CIDRS=
# STATIC_BASE_URL=http://localhost:8000

# ── Ontology sources and Qdrant collections ──────────────────────────────────
# ONTOLOGY_QUERY_MODE=semantic selects the embedding-backed path; "sparql" forces direct
# GraphDB only. The three FILE settings are legacy trial paths, still read at boot.
# ONTOLOGY_QUERY_MODE=semantic
# USE_SEMANTIC_ONTOLOGY=true
# ONTOLOGY_COLLECTION=ontology
# TBOX_COLLECTION=brick_schema
# ABOX_COLLECTION=building_instances
# BRICK_TBOX_FILE=trial/dataset/Brick.ttl
# BUILDING_ABOX_FILE=trial/dataset/bldg1_protege.ttl
# BUILDING_CONFIG_FILE=config/building_config.yaml
# SENSOR_MAP_PATH=input/.sensor_map.cache.json

# ── Pipeline feature switches ────────────────────────────────────────────────
# Each defaults ON except the two noted. Turning one OFF removes a behaviour rather than
# breaking the pipeline — see the named module for what is lost.
# COREFERENCE_REWRITE_ENABLED=true      # dialogue_agent.rewrite_to_standalone
# Answer relevance gate (services/answer_relevance_gate.py): one extra model call per answer from
# the listed lanes; a non-responsive answer becomes the honest decline. Fails open.
# ANSWER_RELEVANCE_GATE=true
# ANSWER_RELEVANCE_GATE_LANES=sensor_data,events,automation_capability,diagnosis,compare,analytics,trend,planner,report,deliberate,observability,discovery,floor_plan,register,asset_state,anomaly
# ANSWER_RELEVANCE_TIMEOUT_S=8
# ENTITY_ENRICHMENT_ENABLED=true
# REFERENT_VALIDATION_ENABLED=true      # the existence gate: OFF permits fabrication
# REPORT_INTAKE_ENABLED=true
# RESPONSE_CACHE_ENABLED=true
# MULTI_INTENT_ENABLED=true
# MULTI_INTENT_MIN_LENGTH=50
# RESPONSE_SYNTHESIS_ENABLED=false      # OFF by default
STRUCTURED_PLAN_ENABLED=false          # OFF by default: the model fills a JSON schema
#                                       # the provider enforces (CQ-IR compile + intent
#                                       # classification) instead of writing free-text
#                                       # JSON that code slices and repairs. ON, a
#                                       # response that does not match is retried once
#                                       # and then fails TYPED — never quietly patched.
# GOAL_PLANNER_ENABLED=false            # OFF by default
# PLANNER_MAX_STEPS=6
# DOCUMENT_SCORE_FLOOR=                 # unset = the provider-appropriate floor

# ── Background schedulers ────────────────────────────────────────────────────
# Seconds. READINESS_CHECK_INTERVAL_SECS=0 disables that loop entirely.
# ALERT_POLL_INTERVAL_SECS=60
# ANOMALY_SCAN_INTERVAL_SECS=3600
# READINESS_CHECK_INTERVAL_SECS=0
# READINESS_LEAD_MINUTES=30
# ALERT_THRESHOLDS_PATH=/app/config/alert_thresholds.yaml

# ── Request deadline ─────────────────────────────────────────────────────────
# NOT the workflow deadline. See WORKFLOW_TIMEOUT_S above: it is DERIVED from
# LLM_TIMEOUT_S, and a model slower than the workflow deadline cannot serve this
# pipeline (CAVEAT-185 — eight empty plan hashes at exactly 120.0s).
# REQUEST_TIMEOUT_SECS=150

# ── Output directories (inside the container) ────────────────────────────────
# EXPORTS_DIR=/app/outputs/exports
# QUERY_RESULTS_DIR=/app/outputs/query_results
# OUTPUT_DATA_DIR=outputs/data

# ── Building management system endpoint ──────────────────────────────────────
# Empty = no BMS. Actuation stays on the simulated driver regardless of this value;
# see building.yaml `actuation:` for the real switch.
# BMS_ENDPOINT=

# ── Behaviour flags read straight from the environment (TODO-494) ──────────────
# These are read with os.environ.get() rather than through Settings, so they never
# appeared here and were undiscoverable without grepping the source. Every one has a
# working default — the values below ARE the defaults, so copying this file changes
# nothing until you edit one.
#
# The remaining raw env names are internal tuning (queue sizes, poll intervals) and are
# documented in ONTOSAGE.md rather than here: listing all of them would bury the
# settings that actually change behaviour, which is what this file is for.

# Conversation memory across turns and sessions
AGENT_MEMORY_ENABLED=true
AGENT_MEMORY_MAX=200
AGENT_MEMORY_TOP_K=5
CROSS_SESSION_MEMORY_ENABLED=true

# Language detection on incoming questions
I18N_ENABLED=true
I18N_DETECT_CONFIDENCE=0.85
I18N_SKIP_SHORT=10

# ARBITER's compile cache. Turn it OFF to measure the compiler's own repeatability —
# with it ON, a repeated question replays its own plan and any invariance benchmark
# reports a perfect score for the property it is trying to test.
CQIR_COMPILE_CACHE=true

# LLM retry policy. LLM_RUNNER_RESTART_WAIT_S is the wait for a CRASHED local model
# runner to respawn (measured 5-14s on a CUDA fault, CAVEAT-619); the ordinary backoff
# is far shorter and would retry into the reload window.
# LLM_TIMEOUT_S is set once, in the "Local model (Ollama)" section, and OPENAI_RETRY_DELAY_S
# with the OpenAI settings: this block repeated both, with LLM_TIMEOUT_S=60, and the later
# assignment wins (CAVEAT-728).
LLM_MAX_RETRIES=3
LLM_BACKOFF_BASE_S=1.0
LLM_BACKOFF_FACTOR=2.0
LLM_RUNNER_RESTART_WAIT_S=10.0

# Local model runtime: OLLAMA_NUM_CTX, OLLAMA_NUM_PREDICT and OLLAMA_KEEP_ALIVE are set once,
# in the "Local model (Ollama)" section above. This block used to set them AGAIN, with
# OLLAMA_NUM_CTX=8192 — the value BUG-188 removed — and a dotenv loader keeps the LAST
# assignment, so a fresh clone booted on the broken context size (CAVEAT-728).

# Response cache. FUZZY matching answers a near-identical question from the cache; it is
# OFF because "CO2 in room 5.01" and "CO2 in room 5.02" are near-identical as text and
# entirely different as questions.
RESPONSE_CACHE_TTL=3600
RESPONSE_CACHE_FUZZY=false
RESPONSE_CACHE_MIN_SIMILARITY=0.85

# Per-session request limits
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_S=60
OPENAI_RATE_LIMIT_DELAY=1.0

# Translation providers. Both EMPTY by default, and the system answers in English without
# them; set one only if you want replies translated back to the asker's language.
DEEPL_API_KEY=
GOOGLE_TRANSLATE_KEY=

# How confident the ontology detector must be before it claims a question is about the
# building's own model rather than general knowledge.
ONTOLOGY_DETECT_THRESHOLD=0.75

# Comma-separated plugin module names, loaded at start-up. Empty = none.
ONTOSAGE_PLUGINS=

# Register lane: answer a simple who / when / which / how-many question about a register directly from its rows,
# instead of asking the model to narrate them (BUG-835, BUG-811). Set false to fall back to the narration alone.
REGISTER_PROJECTION_ANSWER=true

# Document lane: keep an uploaded-document passage only when it is about the question (BUG-218). 'off' restores
# the older score-only behaviour. The margin is how far a passage must score above the runner-up.
DOCUMENT_RELEVANCE_GATE=on
DOCUMENT_RELEVANCE_MARGIN=0.10

# An answer that says the building holds nothing gets one second look: the registers and the
# records' own text that the answering lane never read are probed, and either that lane answers
# (once) or the false universal is reworded to name what was actually searched. Set false to
# publish such answers exactly as the lane wrote them.
ABSENCE_SECOND_CHANCE=true
