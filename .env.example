# ╔════════════════════════════════════════════════════════════════════════════╗
# ║                OntoSage 2.0 Environment Configuration                      ║
# ║                                                                            ║
# ║  QUICK START:                                                             ║
# ║  1. For FREE local models:  Copy .env.local to .env                       ║
# ║  2. For PAID cloud models:  Copy .env.cloud to .env and add OpenAI key   ║
# ║  3. Run: ./startup.ps1                                                    ║
# ╚════════════════════════════════════════════════════════════════════════════╝


# ==================== 🎯 MODEL PROVIDER SELECTION ====================
# Core decision: Where do models run?
#
# LOCAL OPTION (Recommended for testing):
#   - MODEL_PROVIDER=local
#   - EMBEDDING_PROVIDER=local
#   - STT_PROVIDER=local
#   - ✅ FREE (no API costs)
#   - ✅ Privacy (data stays local)
#   - ✅ No rate limits
#   - ⚠️ Slower inference
#   - ⚠️ Requires 8GB+ RAM
#   - Uses: Ollama (OLLAMA_MODEL below), sentence-transformers, faster-whisper
#   - NOTE: MODEL_PROVIDER also auto-falls-back to 'local' whenever
#     MODEL_PROVIDER=openai is set but OPENAI_API_KEY is blank.
#
# CLOUD OPTION (Recommended for production):
#   - MODEL_PROVIDER=openai
#   - EMBEDDING_PROVIDER=openai
#   - STT_PROVIDER=openai
#   - ✅ Fast inference
#   - ✅ State-of-the-art models
#   - ⚠️ Costs money (~$0.01 per 1K tokens)
#   - ⚠️ Requires internet
#   - ⚠️ Needs OpenAI API key
#   - Uses: GPT-4, ada-002, Whisper API

MODEL_PROVIDER=local
EMBEDDING_PROVIDER=local
STT_PROVIDER=local


# ==================== ☁️ OPENAI CONFIGURATION ====================
# Required only if MODEL_PROVIDER=openai, EMBEDDING_PROVIDER=openai, or STT_PROVIDER=openai
#
# Get your API key from: https://platform.openai.com/api-keys
# Pricing: https://openai.com/pricing
#
# SECURITY WARNING:
# - Never commit .env with real API keys to Git
# - Rotate keys if exposed
# - Monitor usage: https://platform.openai.com/usage

# Your OpenAI API key (starts with sk-...)
OPENAI_API_KEY=your_openai_api_key_here

# LLM Model for conversations, SPARQL generation, analytics
# Options:
#   - gpt-4-turbo-preview (best quality, $0.01/1K tokens input, $0.03/1K output)
#   - gpt-4 (proven stable, $0.03/1K input, $0.06/1K output)
#   - gpt-3.5-turbo (cheapest, $0.0005/1K input, $0.0015/1K output)
OPENAI_MODEL=gpt-4-turbo-preview

# Temperature: Controls randomness (0.0 = deterministic, 1.0 = creative)
# For ontology queries: 0.0-0.2 recommended (precise)
# For conversations: 0.5-0.7 (natural)
OPENAI_TEMPERATURE=0.1
# Retry backoff for OpenAI (seconds) to avoid 429 thrashing
OPENAI_RETRY_DELAY_S=20

# Embedding model for RAG (Retrieval-Augmented Generation)
# Options:
#   - text-embedding-3-small (recommended, 1536 dims, $0.00002/1K tokens)
#   - text-embedding-3-large (best quality, 3072 dims, $0.00013/1K tokens)
#   - text-embedding-ada-002 (legacy, 1536 dims, $0.0001/1K tokens)
EMBEDDING_MODEL_OPENAI=text-embedding-3-small
EMBEDDING_DIMENSION_OPENAI=1536

# Whisper STT (Speech-to-Text)
# Fixed model: whisper-1 ($0.006/minute)
# Max file size: 25MB
# Supports: mp3, mp4, mpeg, mpga, m4a, wav, webm


# ==================== 🖥️ LOCAL MODEL CONFIGURATION ====================
# Used only if MODEL_PROVIDER=local, EMBEDDING_PROVIDER=local, or STT_PROVIDER=local

# Ollama (Local LLM)
# Two ways to run Ollama:
#   1. Natively on the host (simplest — just `ollama serve`, any OS/GPU):
#      docker-compose.yml reaches it via host.docker.internal:11434 (Ollama's
#      default port). Nothing else to configure.
#   2. Inside Docker with GPU passthrough (NVIDIA only):
#      docker compose --profile local-gpu up -d  (see the commented `ollama:`
#      service in docker-compose.yml)
# Verify from the host: curl http://localhost:11434/api/tags
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Model to use — must already be pulled (`ollama pull <name>`, or `ollama list`
# to see what's installed). Any tag with tool/function-calling support works
# best; check via: curl http://localhost:11434/api/tags | grep -A2 '"name"'
OLLAMA_MODEL=gemma4:26b

# Local Embeddings (sentence-transformers)
# Model is downloaded on first use (~90MB)
# Options:
#   - sentence-transformers/all-MiniLM-L6-v2 (384 dims, fast, good quality)
#   - sentence-transformers/all-mpnet-base-v2 (768 dims, slower, better quality)
#   - sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2 (384 dims, multilingual)
EMBEDDING_MODEL_LOCAL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION_LOCAL=384

# Local Whisper (faster-whisper)
# Model size affects accuracy vs speed (download size shown)
# Options:
#   - tiny (39MB, fast, low accuracy)
#   - base (74MB, balanced, recommended)
#   - small (244MB, good accuracy)
#   - medium (769MB, better accuracy)
#   - large (2.9GB, best accuracy, slow)
WHISPER_MODEL_LOCAL=base


# ==================== 🔗 SERVICE URLS ====================
# Internal Docker network URLs (do not change unless modifying docker-compose.yml)

# Qdrant Vector Database (semantic search)
# Stores ontology embeddings, query history
# Dashboard: http://localhost:6333/dashboard
QDRANT_URL=http://qdrant:6333

# Redis (conversation state, caching)
# Stores conversation history, SPARQL cache, user preferences
# TTL: CONVERSATION_TTL seconds (default: 3600 = 1 hour)
REDIS_URL=redis://redis:6379/0

# RAG Service (Retrieval-Augmented Generation)
# Provides ontology context for SPARQL generation
# Health check: http://localhost:8001/health
RAG_SERVICE_URL=http://rag-service:8001

# Code Executor (Sandboxed Python execution)
# Runs analytics code in isolated environment
# Security: SAFE_BUILTINS only, no os/sys/subprocess
CODE_EXECUTOR_URL=http://code-executor:8002
CODE_EXECUTOR_TIMEOUT=30              # Max execution time (seconds)
CODE_EXECUTOR_MEMORY_LIMIT=1g         # RAM limit per execution
CODE_EXECUTOR_CPU_LIMIT=1.0           # CPU cores (1.0 = 1 full core)

# Whisper STT (Speech-to-Text)
# Converts audio to text for voice queries
WHISPER_STT_URL=http://whisper-stt:8003


# ==================== 🗄️ MULTI-DATABASE REGISTRY ====================
# config/database_registry.yaml maps TTL storedAt identifiers → adapters.
# Add env vars here for each new database you reference in your TTL files.
#
# TTL example:  _:ref ref:storedAt bldg:database4 .
# YAML maps:    database4: { type: mongodb, host: ${MONGO_HOST}, ... }

# ── PostgreSQL (Building 2) ──────────────────────────────────────────
PG_HOST=postgres
PG_PORT=5432
PG_USER=ontosage
PG_PASSWORD=ontosage
PG_DATABASE=bldg2

# ── TimescaleDB (Building 3) ─────────────────────────────────────────
TIMESCALE_HOST=timescaledb
TIMESCALE_PORT=5432
TIMESCALE_USER=ontosage
TIMESCALE_PASSWORD=ontosage
TIMESCALE_DATABASE=bldg3

# ── MongoDB (Building 4) ─────────────────────────────────────────────
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_USER=
MONGO_PASSWORD=
MONGO_DATABASE=bldg4
MONGO_COLLECTION=sensor_data

# ── InfluxDB 2.x (Building 5) ────────────────────────────────────────
INFLUX_URL=http://influxdb:8086
INFLUX_TOKEN=your_influx_token_here   # ⚠️ Required — generate in InfluxDB UI
INFLUX_ORG=ontosage
INFLUX_BUCKET=sensors

# ── SQLite local file (Building 6) ───────────────────────────────────
SQLITE_PATH=/app/data/bldg6.db

# ── Apache Cassandra (Building 7) ────────────────────────────────────
CASSANDRA_HOST=cassandra
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=bldg7
CASSANDRA_USER=
CASSANDRA_PASSWORD=
CASSANDRA_TABLE=sensor_data

# ── Redis TimeSeries (Building 8) ────────────────────────────────────
REDIS_TS_URL=redis://redis:6379/1
REDIS_TS_PASSWORD=
REDIS_TS_KEY_PREFIX=sensor


# ==================== 🏢 BUILDING CONFIGURATION ====================
#
# OntoSage v1 serves ONE building at a time.  The active building's files live
# DIRECTLY in `input/` (flat layout) — no per-building subdirectory.
#
# Active building files: input/building.yaml, input/capability.yaml,
#   input/feeds.yaml, input/rules.yaml, input/intents.yaml,
#   input/<bldg>_*.ttl, input/data/, input/documents/, input/personas/
#
# Shared files (leave in place): input/Brick_v1.4.ttl, input/Brick+extensions.ttl,
#   input/Abacws floor *.dwg/pdf, input/_templates/, input/database_registry.yaml
#
# To swap to a new building safely:
#   1. Stage the new building's files into input/<new_id>/
#   2. python scripts/swap_building.py --to <new_id> --dry-run   (validate)
#   3. python scripts/swap_building.py --to <new_id> --archive   (apply + archive old)
#   4. docker-compose restart orchestrator
#
# The TTL validator runs at startup and HARD-FAILS the boot if any TTL's
# `@prefix bldg:` does not match the ontology_namespace declared in
# `input/building.yaml`.
#
# OntoSage v2 (Onto-community) will support multiple simultaneous buildings.

# Building identifier (used in logs, responses, and to match input/building.yaml)
BUILDING_ID=bldg1
BUILDING_NAME=Abacws Building

# Optional — enable SHACL Brick conformance check on each TTL at startup.
# Requires the brickschema package; adds 5–30s per file.  Off by default.
# TTL_VALIDATION_SHACL=false

# Fuseki SPARQL Endpoint
# Triple store for Brick ontology (Building 1 sensors, locations, equipment)
# Query UI: http://localhost:3030/#/dataset/abacws/query
# Dataset contains:
#   - ~500 triples (sensors, spaces, equipment, relationships)
#   - Brick Schema classes (hasLocation, feeds, isPointOf, etc.)
FUSEKI_URL=http://fuseki:3030/abacws

# MySQL Database (Time-series sensor data)
# Contains:
#   - sensors table: 21 sensors (7 temp, 5 humidity, 3 CO2, 3 occupancy, 3 energy)
#   - sensor_data: ~14K records (7 days, 15-minute intervals)
#   - sensor_hourly_aggregates: Pre-computed hourly stats
# PhpMyAdmin (optional): http://localhost:8080
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root                   # ⚠️ Change in production!
MYSQL_DATABASE=abacws

# PostgreSQL Database (ThingsBoard)
# Contains:
#   - ThingsBoard device registry, telemetry, and time-series data
#   - Used for IoT device management and sensor data storage
# Access via pgAdmin: http://localhost:5050
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=thingsboard
POSTGRES_PASSWORD=thingsboard         # ⚠️ Change in production!
POSTGRES_DB=thingsboard

# pgAdmin (PostgreSQL Web UI)
# Web interface for managing PostgreSQL databases
# Access: http://localhost:5050
# Login with credentials below
PGADMIN_DEFAULT_EMAIL=pgadmin@example.com
PGADMIN_DEFAULT_PASSWORD=admin        # ⚠️ Change in production!


# ==================== 🏗️ ABACWS API & VISUALISER CONFIGURATION ====================
# Building management API with support for multiple database backends

# API Key for authentication
API_KEY=change_me                     # ⚠️ Change in production!

# Database Engine Selection
# Options: mysql, postgres, mongo, disabled
API_DB_ENGINE=mysql

# Abacws API PostgreSQL Connection (when API_DB_ENGINE=postgres)
API_PGHOST=postgres
API_PGPORT=5432
API_PGUSER=thingsboard
API_PGPASSWORD=thingsboard
API_PGDATABASE=thingsboard

# Abacws API MySQL Connection (when API_DB_ENGINE=mysql)
API_MYSQL_HOST=mysql-bldg1
API_MYSQL_PORT=3307
API_MYSQL_USER=root
API_MYSQL_PASSWORD=mysql
API_MYSQL_DATABASE=sensordb

# Abacws Visualiser Debug Mode
# Set to '1' to enable verbose 3D loader logging in browser console
ABACWS_DEBUG=0


# ==================== 🌐 THINGSBOARD IOT PLATFORM CONFIGURATION ====================
# ThingsBoard for sensor management and IoT device connectivity

# ThingsBoard PostgreSQL Database
# Uses the same Postgres container as other services
PG_THINGSBOARD_DB=thingsboard
PG_THINGSBOARD_USER=thingsboard
PG_THINGSBOARD_PASSWORD=thingsboard

# ThingsBoard Access
# Web UI: http://localhost:8082
# Default credentials: tenant@thingsboard.org / tenant
# MQTT Port: 1883
# HTTP Port: 8081


# ==================== 💬 CONVERSATION SETTINGS ====================

# Conversation state TTL (seconds)
# 0 = no time-based expiry; bounded instead by CONVERSATION_MAX_MESSAGES below.
# Set to e.g. 3600 (1h) or 86400 (24h) to re-enable time-based expiry.
CONVERSATION_TTL=0

# Max verbatim messages kept per conversation in the Redis blob (count-based eviction)
# Older messages are dropped (sliding window). 20 = 10 user + 10 assistant.
CONVERSATION_MAX_MESSAGES=20

# Max prior turns injected into LLM context from Redis
MAX_CONVERSATION_HISTORY=20

# Max retry attempts for failed operations
# Applies to:
#   - SPARQL query errors (auto-repair)
#   - Code execution errors (auto-fix)
#   - LLM API failures (retry with backoff)
MAX_RETRY_ATTEMPTS=3


# ==================== 🌦️ LIVE-DATA AUGMENTATION (general knowledge) ====================
# When a general-knowledge question needs CURRENT info the LLM can't know from its
# training cutoff (weather, latest news/prices/versions), the general_knowledge node
# fetches live data and asks the LLM to summarise it.

# Master switch + per-capability toggles
LIVE_DATA_ENABLED=true
WEATHER_ENABLED=true        # Open-Meteo (free, no API key)
WEB_SEARCH_ENABLED=true

# Web-search backend: 'duckduckgo' (free, keyless — DEFAULT) | 'tavily' | 'none'
WEB_SEARCH_PROVIDER=duckduckgo

# Tavily (optional, better LLM-ready results). Only used when WEB_SEARCH_PROVIDER=tavily.
# Get a free key at https://app.tavily.com. Falls back to DuckDuckGo if empty or failing.
TAVILY_API_KEY=

# Max results fed to the summariser, and per-fetch timeout (seconds)
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_S=8.0


# ==================== 📊 QDRANT COLLECTION CONFIGURATION ====================
# Vector database collections (created by scripts/init_qdrant.py)

# Collection names
QDRANT_ONTOLOGY_COLLECTION=ontology   # Brick Schema triples
QDRANT_QUERIES_COLLECTION=queries     # Historical SPARQL queries
QDRANT_ANALYTICS_COLLECTION=analytics # Analytics code snippets
QDRANT_DOCS_COLLECTION=documentation  # System docs, help text

# Vector similarity threshold (0.0-1.0)
# Higher = stricter matching (fewer, more relevant results)
# Lower = looser matching (more results, less relevant)
# 0.7 = good balance
SIMILARITY_THRESHOLD=0.7

# Max results returned per RAG query
# More results = more context for LLM but slower inference
RAG_TOP_K=5


# ==================== 🔐 SECURITY SETTINGS ====================

# Code Executor Sandbox
# Forbidden imports (security): os, sys, subprocess, socket, requests, urllib
# Allowed imports: pandas, numpy, matplotlib, plotly, datetime, math, statistics
# All code runs in isolated environment with resource limits

# Pipeline API key — bearer key required on the OpenAI-compatible
# /v1/chat/completions endpoint (sent by Open WebUI as OPENAI_API_KEY).
# MUST be changed from the default in production; STRICT_SECRETS=true refuses
# startup if left at the default. Comma-separate multiple keys for rotation.
PIPELINE_API_KEY=sk-ontobot-pipeline

# STRICT_SECRETS — default True (refuses startup when any password is the insecure
# default). COOKIE_SECURE — default True (sets Secure flag on session cookie; must
# be false when the stack runs over plain HTTP).
#
# ---- LOCAL DEV ONLY — uncomment both lines below for local HTTP development ----
# STRICT_SECRETS=false
# COOKIE_SECURE=false
# ---------------------------------------------------------------------------------

# File upload limits (Whisper STT)
MAX_UPLOAD_SIZE_MB=25                 # OpenAI Whisper limit
ALLOWED_AUDIO_FORMATS=wav,mp3,m4a,ogg,webm


# ==================== 📝 LOGGING ====================

# Log level controls verbosity
# Options:
#   - DEBUG: Everything (function calls, variables, SQL queries)
#   - INFO: Important events (requests, responses, errors)
#   - WARNING: Potential issues (retries, timeouts)
#   - ERROR: Failures only
# Production: INFO, Development: DEBUG
LOG_LEVEL=INFO

# Log format (Python logging)
# %(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s


# ==================== 🎨 FRONTEND CONFIGURATION ====================

# React app proxies /api/* to orchestrator
# Set via REACT_APP_API_URL in frontend/.env
# Default: http://localhost:8000 (local development)
# Production: Update to public orchestrator URL


# ==================== 📈 MONITORING (OPTIONAL) ====================
# Enable with: docker-compose --profile monitoring up -d

# Prometheus (metrics)
# Scrapes: orchestrator, rag-service, code-executor, whisper-stt, redis, qdrant, mysql
# UI: http://localhost:9090

# Grafana (dashboards)
# UI: http://localhost:3001
# Login: admin/admin
# Dashboards: OntoSage Overview (service health, latency, throughput)


# ==================== CAPABILITY SEMANTIC ROUTING ====================
# Migration flag for the capability intent routing refactor (added 2026-05-21).
# See docs/superpowers/specs/2026-05-21-capability-semantic-routing-design.md
#
# When false (default): legacy keyword-based routing in dialogue_agent.py
#   (_CAPABILITY_KW + _STRONG_FACILITY_KW frozensets + CapabilityKB.search()).
# When true: SemanticRouter classifies via Qdrant before LLM intent call.
#   Requires capability_<bldg> collection in Qdrant — created automatically by
#   CapabilityIndexer at orchestrator startup if a capability.yaml exists for
#   that building.
#
# Per-building tuning (threshold, top_k, override_min) lives in
# input/<bldg>/building.yaml under `capability_routing:`.
CAPABILITY_SEMANTIC_ROUTING_ENABLED=false

# Toggleable synthetic data sources + per-answer provenance tags + config panel
# (http://127.0.0.1:3001). When true: loads input/datasources.yaml, exposes the
# /api/v1/datasources admin API, gates disabled-source questions with a
# locked-capability decline, and tags answers with per-source provenance chips.
# See tasks/IMPLEMENTATION_PLAN_DATASOURCE_TOGGLES_AND_PROVENANCE.md.
DATASOURCE_TOGGLES_ENABLED=false

# Admin bootstrap for the console at http://127.0.0.1:3001. When BOTH are set,
# the orchestrator creates this admin-role user at startup if it doesn't already
# exist (safe-create: never overwrites an existing account). Leave blank to skip.
# This is the account you sign in with to manage .env, databases, and users.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# TTL for Redis-cached embeddings (cache:embed:* keys). Default 24h.
# Embeddings are deterministic per (text, provider, model), so a long TTL
# minimises OpenAI/local-model load. Lower this for testing churn.
EMBEDDING_CACHE_TTL_SECONDS=86400


# ==================== 🛠️ DEVELOPMENT SETTINGS ====================

# Hot reload (for development)
# Set to 'true' to enable auto-restart on code changes
# Requires mounting code as volumes in docker-compose.yml
# DEV_MODE=false

# Skip model downloads (if already cached)
# SKIP_MODEL_DOWNLOAD=false

# Use mock LLM responses (for testing without LLM)
# MOCK_LLM=false


# ╔════════════════════════════════════════════════════════════════════════════╗
# ║  TROUBLESHOOTING                                                          ║
# ║                                                                            ║
# ║  • Services not starting?                                                 ║
# ║    → Run: docker-compose logs <service_name>                             ║
# ║    → Check: Docker has 8GB+ RAM allocated (Docker Desktop settings)      ║
# ║                                                                            ║
# ║  • Ollama model not found?                                                ║
# ║    → Run on the HOST (not in Docker): ollama pull gemma4:26b             ║
# ║    → Verify: curl http://localhost:11434/api/tags                       ║
# ║                                                                            ║
# ║  • OpenAI API errors?                                                     ║
# ║    → Verify: OPENAI_API_KEY is valid                                     ║
# ║    → Check: https://platform.openai.com/usage for rate limits           ║
# ║                                                                            ║
# ║  • Qdrant collections not found?                                          ║
# ║    → Run: docker-compose exec orchestrator python -m scripts.init_qdrant ║
# ║                                                                            ║
# ║  • No ontology data?                                                      ║
# ║    → Run: docker-compose exec rag-service python -m scripts.ingest_ontology ║
