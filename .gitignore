##############################
# Paper: NOT tracked at all.
# paper/ was listed above but its contents had been force-added (git add -f), so
# 131 files — the survey analysis, participant response data and the unpublished
# writeup — kept syncing despite the ignore rule. They are untracked as of
# 2026-08-11 and stay on disk locally. The per-file exclusions that used to live
# here only made sense while the subtree was force-tracked; the single paper/
# rule above now covers everything, so nothing inside it needs listing.
# Do NOT `git add -f` this folder.
##############################
##############################
# Claude Code local settings (machine-specific, not for sharing)
##############################
.claude/settings.local.json
markdown/
presentation/

##############################
# Local review / planning notes (not for sharing)
##############################
review docs/
review\ docs/
# Generated survey/test-run artifacts (ad-hoc outputs, not source)
survey_run*.json
survey_test_results*.json
survey_*_post.txt
survey_test_output*.txt

# Harness scheduled-task lock
.claude/scheduled_tasks.lock
.claude/*.lock

# Admin GUI <-> input/ TTL sync: cross-process write lock + reversible backups
input/.ttl_write.lock
input/.trash/

# Per-run QA suite results (timestamped, local only)
results/

# ── Parked alternate-building inputs (single-building deployment: bldg1 active) ──
# archive/buildings/ holds bldg2 (+ example) for the future swap/portability test.
# input/bldg2/ stays ignored so a restored test copy is never committed by accident.
/archive/
/input/bldg2/
bandit-report.json

# Redundant generated ontology serializations (keep only the canonical .ttl per building)
bldg2/trial/dataset/*_protege.ttl
bldg2/trial/dataset/*_rdf.rdf
bldg3/trial/dataset/*_protege.ttl
bldg3/trial/dataset/*_rdf.rdf
bldg3/trial/dataset/_sanitized_*.ttl

# ── Multi-building layout (swap-by-rename; ONE building active at a time) ──────
# bldg1/, bldg2/, bldg3/ are parked per-building input sets; the ACTIVE building's
# set is renamed to input/. ALL building folders are fully tracked (Brick schema
# copies are identical, so git stores one blob) — each folder must be complete and
# self-contained so any building can be activated from a fresh clone.
# Per-building env deltas live in <folder>/env.building (no secrets there).
# Only runtime-generated junk inside them is ignored:
input/renders/
bldg*/renders/
bldg*/.trash/
bldg*/.ttl_write.lock

# Raw building-generation workspaces (notebooks, scripts, all TTL variants) — local only
bldg2_source/
bldg3_source/
# Real env files carry secrets (API keys, DB passwords) — NEVER track any of them.
# Building identity deltas are tracked instead as <folder>/env.building.
.env1
.env2
.env3

# Auto-generated per-building sensor-map cache (rebuilt from the live graph on boot)
input/.sensor_map.cache.json
bldg*/.sensor_map.cache.json
