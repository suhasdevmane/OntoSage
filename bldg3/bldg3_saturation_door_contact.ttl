# SATURATE (V4-T08): simulated door_contact sensors for spaces the coverage
# audit found uninstrumented. Every sensor is labeled ontosage:isSimulated.
# Rows live in the narrow table 'contact_data' (database_registry.yaml key).
@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix ref:   <https://brickschema.org/schema/Brick/ref#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ontosage: <http://ontosage.org/capabilities#> .
@prefix bldg:  <http://buildsys.org/ontologies/bldg3#> .

<http://buildsys.org/ontologies/bldg3#contact_data>
    a ref:Database ;
    rdfs:label "Contact Data" .

<http://buildsys.org/ontologies/bldg3#RM007_room_sat_door_contact>
    a brick:Contact_Sensor ;
    rdfs:label "RM007_room door_contact (simulated)"@en ;
    brick:hasLocation <http://buildsys.org/ontologies/bldg3#RM007_room> ;
    ontosage:isSimulated "true"^^xsd:boolean ;
