# Building context for bldg3: knowledge topics, service state, drinkability.
#
# GENERATED by scripts/generate_building_context.py. Every subject declares
# ontosage:isSimulated, because each of these is authored rather than measured.
#
# DISCOVERED, not assumed: the namespace, floors, rooms and amenities below were read
# from bldg3's own TTLs. This building names its floors ['floor0', 'floor1']
# and its rooms in its own style; nothing here was written against another building's
# naming, which is the only way this demonstrates building-agnosticism rather than
# demonstrating that someone was told the answer.
#
# The CONTENT differs from every other building's on purpose. Cloning one building's
# topics into another would make them answer identically for the wrong reason, and a
# portability test that passes because the fixtures are the same file tests nothing.

@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix ontosage: <http://ontosage.org/capabilities#> .
@prefix bldg:     <http://buildsys.org/ontologies/bldg3#> .

# ── knowledge topics ────────────────────────────────────────────────────────

bldg:Topic_AccessCards a ontosage:KnowledgeTopic , ontosage:InformationTopic ;
    rdfs:label "Access Cards"@en ;
    ontosage:capabilityCategory "INFORMATION" ;
    ontosage:layTerms "access card, badge, door won't open, card not working, entry" ;
    ontosage:answerText "Access cards are issued by the site office; a card that stops working is usually re-enabled the same day." ;
    ontosage:contactEmail "site@buildsys.example.org" ;
    ontosage:contactPhone "+44 20 7946 0812" ;
    ontosage:isSimulated "true"^^xsd:boolean .

bldg:Topic_Cycling a ontosage:KnowledgeTopic , ontosage:InformationTopic ;
    rdfs:label "Cycling"@en ;
    ontosage:capabilityCategory "INFORMATION" ;
    ontosage:layTerms "bike, bicycle, cycle storage, where do i leave my bike, showers" ;
    ontosage:answerText "Covered cycle racks are at the rear entrance, with showers and lockers on the ground floor." ;
    ontosage:contactEmail "site@buildsys.example.org" ;
    ontosage:contactPhone "+44 20 7946 0812" ;
    ontosage:isSimulated "true"^^xsd:boolean .

bldg:Topic_Cleaning a ontosage:KnowledgeTopic , ontosage:InformationTopic ;
    rdfs:label "Cleaning"@en ;
    ontosage:capabilityCategory "INFORMATION" ;
    ontosage:layTerms "cleaning, cleaner, spill, my office is dirty, bins not emptied" ;
    ontosage:answerText "Offices are cleaned overnight on weekdays. Spills and one-off issues go to the site office." ;
    ontosage:contactEmail "site@buildsys.example.org" ;
    ontosage:contactPhone "+44 20 7946 0812" ;
    ontosage:isSimulated "true"^^xsd:boolean .

bldg:Topic_Catering a ontosage:KnowledgeTopic , ontosage:InformationTopic ;
    rdfs:label "Catering"@en ;
    ontosage:capabilityCategory "INFORMATION" ;
    ontosage:layTerms "coffee, food, canteen, vending, where can i eat, lunch" ;
    ontosage:answerText "There is no canteen on site; vending is on the ground floor and the nearest cafe is a short walk." ;
    ontosage:contactEmail "site@buildsys.example.org" ;
    ontosage:contactPhone "+44 20 7946 0812" ;
    ontosage:isSimulated "true"^^xsd:boolean .

bldg:Topic_QuietSpace a ontosage:KnowledgeTopic , ontosage:InformationTopic ;
    rdfs:label "Quiet Space"@en ;
    ontosage:capabilityCategory "INFORMATION" ;
    ontosage:layTerms "quiet, quiet room, focus, prayer room, contemplation" ;
    ontosage:answerText "A bookable quiet room is available on the top floor for focused work and contemplation." ;
    ontosage:contactEmail "site@buildsys.example.org" ;
    ontosage:contactPhone "+44 20 7946 0812" ;
    ontosage:isSimulated "true"^^xsd:boolean .

bldg:Topic_OpeningHours a ontosage:KnowledgeTopic , ontosage:InformationTopic ;
    rdfs:label "Opening hours"@en ;
    ontosage:capabilityCategory "INFORMATION" ;
    ontosage:layTerms "opening hours, when is the building open, access hours, closing time, is it open" ;
    ontosage:answerText "Open 07:00-19:00 weekdays, closed weekends and public holidays." ;
    ontosage:isSimulated "true"^^xsd:boolean .

# ── amenity service state ───────────────────────────────────────────────────

bldg:Status_Amenity_DrinkingWater_floor1 a ontosage:AssetStatus ;
    ontosage:statusOf bldg:Amenity_DrinkingWater_floor1 ;
    ontosage:statusValue "out_of_service" ;
    ontosage:statusReason "isolated during adjacent works" ;
    rdfs:label "Service state - Drinking water point — RM100A_room"@en ;
    ontosage:isSimulated "true"^^xsd:boolean .

bldg:Status_Amenity_StudyArea_floor1 a ontosage:AssetStatus ;
    ontosage:statusOf bldg:Amenity_StudyArea_floor1 ;
    ontosage:statusValue "out_of_service" ;
    ontosage:statusReason "reported faulty and booked for repair" ;
    rdfs:label "Service state - Study area — RM107_room"@en ;
    ontosage:isSimulated "true"^^xsd:boolean .

bldg:Status_Amenity_ToiletFacility_floor0 a ontosage:AssetStatus ;
    ontosage:statusOf bldg:Amenity_ToiletFacility_floor0 ;
    ontosage:statusValue "out_of_service" ;
    ontosage:statusReason "isolated during adjacent works" ;
    rdfs:label "Service state - Toilet facility — RM039_room"@en ;
    ontosage:isSimulated "true"^^xsd:boolean .

# ── drinkability ────────────────────────────────────────────────────────────
#
# Authored only because this building is FICTIONAL (building.yaml declares
# provenance.nature: synthetic). A simulated drinkability claim about a real
# building is a false health claim, and five of them had to be removed from this
# repository once already.

bldg:Potability_DrinkingWater a ontosage:PotabilityStatement ;
    rdfs:label "Drinking water quality"@en ;
    ontosage:layTerms "is the water safe to drink, can i drink the water, potable, drinkable, tap water safe, water quality" ;
    ontosage:potabilityValue "potable" ;
    ontosage:potabilityAuthority "BuildSys Site Management" ;
    ontosage:potabilityIssuedOn "2024-01-01"^^xsd:date ;
    ontosage:appliesToOutlet bldg:Amenity_DrinkingWater_floor0 ,
        bldg:Amenity_DrinkingWater_floor1 ,
        bldg:Amenity_DrinkingWater_floor2 ,
        bldg:Amenity_DrinkingWater_floor3 ;
    ontosage:isSimulated "true"^^xsd:boolean .
