# SATURATE (V4-T08): simulated noise sensors for spaces the coverage
# audit found uninstrumented. Every sensor is labeled ontosage:isSimulated.
# Rows live in the narrow table 'noise_data' (database_registry.yaml key).
@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix ref:   <https://brickschema.org/schema/Brick/ref#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ontosage: <http://ontosage.org/capabilities#> .
@prefix bldg:  <http://buildsys.org/ontologies/bldg3#> .

<http://buildsys.org/ontologies/bldg3#noise_data>
    a ref:Database ;
    rdfs:label "Noise Data" .

<http://buildsys.org/ontologies/bldg3#RM007_room_sat_noise>
    a ontosage:Sound_Level_Sensor ;
    rdfs:label "RM007_room noise (simulated) [dB]"@en ;
    brick:hasLocation <http://buildsys.org/ontologies/bldg3#RM007_room> ;
    ontosage:isSimulated "true"^^xsd:boolean ;
    rdfs:comment "synthetic-saturation-v4" ;
    ref:hasExternalReference [
        a ref:TimeseriesReference ;
        ref:hasTimeseriesId "2ac03036-e554-5021-9e12-5a65b8299d52" ;
        ref:storedAt <http://buildsys.org/ontologies/bldg3#noise_data> ;
    ] .

