    <!-- file:/C:/Users/suhas/Documents/GitHub/OntoBot/bldg3/trial/dataset/na99033713e994d3fac6c613af3f33cc0b3604 -->

    <owl:NamedIndividual rdf:about="file:/C:/Users/suhas/Documents/GitHub/OntoBot/bldg3/trial/dataset/na99033713e994d3fac6c613af3f33cc0b3604">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#SPARQLRule"/>
        <sh:prefixes rdf:resource="https://brickschema.org/schema/1.3/Brick"/>
        <sh:construct>
            CONSTRUCT {
$this ?invP ?o .
}
WHERE {
?o ?p $this .
{?invP owl:inverseOf ?p} UNION {?invP s223:inverseOf ?p} .
}
			</sh:construct>
    </owl:NamedIndividual>
    


    <!-- file:/C:/Users/suhas/Documents/GitHub/OntoBot/bldg3/trial/dataset/na99033713e994d3fac6c613af3f33cc0b3605 -->

    <owl:NamedIndividual rdf:about="file:/C:/Users/suhas/Documents/GitHub/OntoBot/bldg3/trial/dataset/na99033713e994d3fac6c613af3f33cc0b3605">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#SPARQLRule"/>
        <sh:prefixes rdf:resource="https://brickschema.org/schema/1.3/Brick"/>
        <sh:construct>
CONSTRUCT {
?o ?prop $this .
$this ?prop ?o .
}
WHERE {
  { $this ?prop ?o } UNION { ?o ?prop $this } .
  {?prop a owl:SymmetricProperty} UNION {?prop a s223:SymmetricProperty} .
}
			</sh:construct>
