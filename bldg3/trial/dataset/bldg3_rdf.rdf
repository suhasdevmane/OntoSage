    <rdf:Description rdf:about="https://brickschema.org/schema/Brick#Ceiling_Fan">
        <rdfs:label>Ceiling Fan</rdfs:label>
        <skos:definition xml:lang="en">A fan installed on the ceiling of a room for the purpose of air circulation</skos:definition>
