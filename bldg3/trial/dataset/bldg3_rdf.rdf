        <rdfs:label>Copy Room</rdfs:label>
        <skos:definition xml:lang="en">A room set aside for common office equipment, including printers and copiers</skos:definition>
        <sh:rule>na99033713e994d3fac6c613af3f33cc0b463</sh:rule>
