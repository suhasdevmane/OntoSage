    <!-- file:/C:/Users/suhas/Documents/GitHub/OntoBot/bldg3/trial/dataset/na99033713e994d3fac6c613af3f33cc0b3165 -->

    <owl:NamedIndividual rdf:about="file:/C:/Users/suhas/Documents/GitHub/OntoBot/bldg3/trial/dataset/na99033713e994d3fac6c613af3f33cc0b3165">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#SPARQLRule"/>
        <sh:prefixes rdf:resource="https://brickschema.org/schema/1.3/Brick"/>
        <sh:construct>
        CONSTRUCT {
            $this rdf:type ?newtype .
        }
        WHERE {
            $this brick:meters ?bldg .
            ?bldg rdf:type/rdfs:subClassOf* brick:Building .
            $this rdf:type ?type .
            BIND(IRI(CONCAT(&quot;https://brickschema.org/schema/Brick#Building_&quot;, strafter(str(?type), &quot;https://brickschema.org/schema/Brick#&quot;))) as ?newtype) .
            FILTER (strEnds(str(?type), &quot;_Meter&quot;))
        }
        </sh:construct>
    </owl:NamedIndividual>
    


