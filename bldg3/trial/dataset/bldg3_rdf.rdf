        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Constant_air_volume"/>
        <skos:definition xml:lang="en">A terminal unit for which supply air flow rate is constant and the supply air temperature is varied to meet thermal load</skos:definition>
        <sh:rule>na99033713e994d3fac6c613af3f33cc0b5017</sh:rule>
        <sh:rule>na99033713e994d3fac6c613af3f33cc0b5018</sh:rule>
