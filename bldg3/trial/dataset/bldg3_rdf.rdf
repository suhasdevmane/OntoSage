    <rdf:Description rdf:about="https://brickschema.org/schema/Brick#area">
        <rdfs:label>Area</rdfs:label>
        <skos:definition>Entity has 2-dimensional area</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://brickschema.org/schema/Brick#buildingThermalTransmittance">
        <rdfs:label>Building thermal transmittance</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.iso.org/obp/ui/#iso:std:iso:13789:ed-3:v1:en"/>
        <skos:definition>The area-weighted average heat transfer coefficient (commonly referred to as a U-value) for a building envelope</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://brickschema.org/schema/Brick#conversionEfficiency">
        <rdfs:label>Conversion efficiency</rdfs:label>
        <skos:definition>The percent efficiency of the conversion process (usually to power or energy) carried out by the entity</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://brickschema.org/schema/Brick#feeds">
        <rdfs:label>Feeds</rdfs:label>
        <skos:definition xml:lang="en">The subject is upstream of the object in the context of some sequential process; some media is passed between them</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://brickschema.org/schema/Brick#grossArea">
        <rdfs:label>Gross area</rdfs:label>
        <skos:definition>Entity has gross 2-dimensional area</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://brickschema.org/schema/Brick#hasAddress">
        <rdfs:label>Has address</rdfs:label>
        <skos:definition xml:lang="en">To specify the address of a building.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://brickschema.org/schema/Brick#hasAssociatedTag">
        <rdfs:label>Has associated tag</rdfs:label>
        <skos:definition xml:lang="en">The class is associated with the given tag</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://brickschema.org/schema/Brick#hasInputSubstance">
        <rdfs:label>Has input substance</rdfs:label>
        <skos:definition xml:lang="en">The subject receives the given substance as an input to its internal process</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://brickschema.org/schema/Brick#hasLocation">
        <rdfs:label>Has location</rdfs:label>
        <skos:definition xml:lang="en">Subject is physically located in the location given by the object</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://brickschema.org/schema/Brick#hasOutputSubstance">
        <rdfs:label>Has output substance</rdfs:label>
        <skos:definition xml:lang="en">The subject produces or exports the given substance from its internal process</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://brickschema.org/schema/Brick#hasPart">
        <rdfs:label>Has part</rdfs:label>
        <skos:definition xml:lang="en">The subject is composed in part of the entity given by the object</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://brickschema.org/schema/Brick#hasPoint">
        <rdfs:label>Has point</rdfs:label>
        <skos:definition xml:lang="en">The subject has a source of telemetry identified by the object. In some systems the source of telemetry may be represented as a digital/analog input/output point</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://brickschema.org/schema/Brick#hasQUDTReference">
        <rdfs:label>Has QUDT reference</rdfs:label>
        <skos:definition xml:lang="en">Points to the relevant QUDT definition</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://brickschema.org/schema/Brick#hasQuantity">
        <rdfs:label>Has QUDT reference</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://brickschema.org/schema/Brick#hasSubMeter">
        <rdfs:label>has sub-meter</rdfs:label>
        <skos:definition xml:lang="en">Indicates a submeter of this meter</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://brickschema.org/schema/Brick#hasSubstance">
        <rdfs:label>Has QUDT reference</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://brickschema.org/schema/Brick#hasTag">
        <rdfs:label>Has tag</rdfs:label>
        <skos:definition xml:lang="en">The subject has the given tag</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://brickschema.org/schema/Brick#hasUnit">
        <rdfs:label>Has unit</rdfs:label>
        <skos:definition xml:lang="en">The QUDT unit associated with this Brick entity (usually a Brick Point instance or Entity Property)</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://brickschema.org/schema/Brick#isAssociatedWith">
        <rdfs:label>Is associated with</rdfs:label>
        <skos:definition xml:lang="en">The tag is associated with the given class</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://brickschema.org/schema/Brick#isFedBy">
        <rdfs:label>Is fed by</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://brickschema.org/schema/Brick#isLocationOf">
        <rdfs:label>Is location of</rdfs:label>
        <skos:definition xml:lang="en">Subject is the physical location encapsulating the object</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://brickschema.org/schema/Brick#isMeteredBy">
        <rdfs:label>is metered by</rdfs:label>
        <skos:definition xml:lang="en">Indicates the meter measuring the consumption/production of some substance by the subject entity</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://brickschema.org/schema/Brick#isPartOf">
        <rdfs:label>Is part of</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://brickschema.org/schema/Brick#isPointOf">
        <rdfs:label>Is point of</rdfs:label>
        <skos:definition xml:lang="en">The subject is a source of telemetry related to the object. In some systems the source of telemetry may be represented as a digital/analog input/output point</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://brickschema.org/schema/Brick#isReplacedBy">
        <rdfs:label>Is replaced by</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://brickschema.org/schema/Brick#isSubMeterOf">
        <rdfs:label>is sub-meter of</rdfs:label>
        <skos:definition xml:lang="en">Indicates the parent for which this meter is a submeter</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://brickschema.org/schema/Brick#isTagOf">
        <rdfs:label>Is tag of</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://brickschema.org/schema/Brick#latitude">
        <rdfs:label>Latitude</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://brickschema.org/schema/Brick#longitude">
        <rdfs:label>Longitude</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://brickschema.org/schema/Brick#measuredModuleConversionEfficiency">
        <rdfs:label>Measured module conversion efficiency</rdfs:label>
        <skos:definition>The measured percentage of sunlight that is converted into usable power</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://brickschema.org/schema/Brick#meters">
        <rdfs:label>meters</rdfs:label>
        <skos:definition xml:lang="en">Indicates the entity whose consumption/production of some substance is measured by this meter</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://brickschema.org/schema/Brick#netArea">
        <rdfs:label>Net area</rdfs:label>
        <skos:definition>Entity has net 2-dimensional area</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://brickschema.org/schema/Brick#panelArea">
        <rdfs:label>Panel area</rdfs:label>
        <skos:definition>Surface area of a panel, such as a PV panel</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://brickschema.org/schema/Brick#ratedCurrentInput">
        <rdfs:label>Rated current input</rdfs:label>
        <skos:definition>The nominal rated current input of the entity</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://brickschema.org/schema/Brick#ratedCurrentOutput">
        <rdfs:label>Rated current output</rdfs:label>
        <skos:definition>The nominal rated current output of the entity</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://brickschema.org/schema/Brick#ratedMaximumCurrentInput">
        <rdfs:label>Rated maximum current input</rdfs:label>
        <skos:definition>The maximum current that can be input to the entity</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://brickschema.org/schema/Brick#ratedMaximumCurrentOutput">
        <rdfs:label>Rated maximum current output</rdfs:label>
        <skos:definition>The maximum current that can be output by the entity</skos:definition>
    </rdf:Description>
