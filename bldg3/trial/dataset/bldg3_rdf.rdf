    <rdf:Description rdf:about="https://brickschema.org/schema/Brick#Transfer_Fan">
        <rdfs:label>Transfer Fan</rdfs:label>
        <skos:definition xml:lang="en">A fan that transfers air from a space to another space.</skos:definition>
