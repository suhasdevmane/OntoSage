    <!-- https://brickschema.org/schema/Brick#Reactive_Power -->

    <owl:NamedIndividual rdf:about="https://brickschema.org/schema/Brick#Reactive_Power">
        <rdf:type rdf:resource="https://brickschema.org/schema/Brick#Quantity"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloV-A_Reactive"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MegaV-A_Reactive"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/V-A_Reactive"/>
        <skos:broader rdf:resource="https://brickschema.org/schema/Brick#Electric_Power"/>
        <brick:hasQUDTReference rdf:resource="http://qudt.org/vocab/quantitykind/ReactivePower"/>
        <rdfs:label>Reactive Power</rdfs:label>
        <skos:definition xml:lang="en">Reactive Power}, for a linear two-terminal element or two-terminal circuit, under sinusoidal conditions, is the quantity equal to the product of the apparent power (S) and the sine of the displacement angle (\psi). The absolute value of the reactive power is equal to the non-active power. The ISO (and SI) unit for reactive power is the voltampere. The special name var and symbol \textit{var are given in IEC 60027 1.</skos:definition>
    </owl:NamedIndividual>
    


