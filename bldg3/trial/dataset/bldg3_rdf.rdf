    <!-- https://brickschema.org/schema/Brick#Operative_Temperature -->

    <owl:NamedIndividual rdf:about="https://brickschema.org/schema/Brick#Operative_Temperature">
        <rdf:type rdf:resource="https://brickschema.org/schema/Brick#Quantity"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/DEG_C"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/DEG_F"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/K"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H1T0D0"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/Temperature"/>
        <skos:broader rdf:resource="https://brickschema.org/schema/Brick#Temperature"/>
        <rdfs:isDefinedBy rdf:resource="https://brickschema.org/schema/Brick"/>
        <rdfs:label>Operative_Temperature</rdfs:label>
        <skos:definition xml:lang="en">The uniform temperature of an imaginary black enclosure in which an occupant would exchange the same amount of heat by radiation plus convection as in the actual nonuniform environment (https://en.wikipedia.org/wiki/Operative_temperature)</skos:definition>
        <skos:definition>The uniform temperature of an imaginary black enclosure in which an occupant would exchange the same amount of heat by radiation plus convection as in the actual nonuniform environment (https://en.wikipedia.org/wiki/Operative_temperature)</skos:definition>
    </owl:NamedIndividual>
    


