        <rdfs:label>Cooling Command</rdfs:label>
        <skos:definition xml:lang="en">Controls the amount of cooling to be delivered (typically as a proportion of total cooling output)</skos:definition>
        <sh:rule>na99033713e994d3fac6c613af3f33cc0b437</sh:rule>
        <sh:rule>na99033713e994d3fac6c613af3f33cc0b438</sh:rule>
