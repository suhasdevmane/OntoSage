        <rdfs:label>Cooling Valve</rdfs:label>
        <skos:definition xml:lang="en">A valve that controls air temperature by modulating the amount of cold water flowing through a cooling coil</skos:definition>
        <sh:rule>na99033713e994d3fac6c613af3f33cc0b460</sh:rule>
        <sh:rule>na99033713e994d3fac6c613af3f33cc0b461</sh:rule>
        <sh:rule>na99033713e994d3fac6c613af3f33cc0b462</sh:rule>
    </rdf:Description>
