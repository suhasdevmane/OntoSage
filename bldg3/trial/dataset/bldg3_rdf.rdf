    <!-- https://brickschema.org/schema/Brick#Frequency -->

    <owl:NamedIndividual rdf:about="https://brickschema.org/schema/Brick#Frequency">
        <rdf:type rdf:resource="https://brickschema.org/schema/Brick#Quantity"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/GigaHZ"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/HZ"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloHZ"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MegaHZ"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/NUM-PER-HR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/NUM-PER-SEC"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/NUM-PER-YR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PER-DAY"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PER-HR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PER-MIN"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PER-MO"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PER-MilliSEC"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PER-SEC"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PER-WK"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PER-YR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PERCENT-PER-DAY"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PERCENT-PER-HR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PERCENT-PER-WK"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PlanckFrequency"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/SAMPLE-PER-SEC"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/TeraHZ"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/failures-in-time"/>
        <skos:narrower rdf:resource="https://brickschema.org/schema/Brick#Alternating_Current_Frequency"/>
        <brick:hasQUDTReference rdf:resource="http://qudt.org/vocab/quantitykind/Frequency"/>
        <rdfs:label>Frequency</rdfs:label>
        <skos:definition xml:lang="en">Frequency is the number of occurrences of a repeating event per unit time. The repetition of the events may be periodic (that is. the length of time between event repetitions is fixed) or aperiodic (i.e. the length of time between event repetitions varies). Therefore, we distinguish between periodic and aperiodic frequencies. In the SI system, periodic frequency is measured in hertz (Hz) or multiples of hertz, while aperiodic frequency is measured in becquerel (Bq).  In spectroscopy, ( u) is mostly used. Light passing through different media keeps its frequency, but not its wavelength or wavenumber.</skos:definition>
    </owl:NamedIndividual>
    


