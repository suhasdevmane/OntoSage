    </rdf:Description>
    <rdf:Description rdf:about="https://brickschema.org/schema/Brick/ref#TimeseriesReference">
        <skos:definition>A reference to a stream of timeseries data in a database. Contains the data for this entity</skos:definition>
        <sh:property>na99033713e994d3fac6c613af3f33cc0b6174</sh:property>
