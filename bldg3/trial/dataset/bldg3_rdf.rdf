        <brick:hasAssociatedTag rdf:resource="https://brickschema.org/schema/BrickTag#Sensor"/>
        <brick:hasQuantity rdf:resource="https://brickschema.org/schema/Brick#Reactive_Power"/>
    </owl:NamedIndividual>
    


    <!-- https://brickschema.org/schema/Brick#Real_Power -->

    <owl:NamedIndividual rdf:about="https://brickschema.org/schema/Brick#Real_Power">
        <rdf:type rdf:resource="https://brickschema.org/schema/Brick#Quantity"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/GigaW"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloW"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MegaW"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MicroW"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliW"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/NanoW"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PicoW"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/TeraW"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/W"/>
        <skos:broader rdf:resource="https://brickschema.org/schema/Brick#Electric_Power"/>
        <brick:hasQUDTReference rdf:resource="http://qudt.org/vocab/quantitykind/ActivePower"/>
        <rdfs:label>Real Power</rdfs:label>
        <skos:definition xml:lang="en">(Active Power) is, under periodic conditions, the mean value, taken over one period (T), of the instantaneous power (p). In complex notation, (P = Re \; S), where (S) is (complex power)&quot;.</skos:definition>
    </owl:NamedIndividual>
    


