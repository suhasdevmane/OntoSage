    <!-- file:/C:/Users/suhas/Documents/GitHub/OntoBot/bldg3/trial/dataset/na99033713e994d3fac6c613af3f33cc0b3699 -->

    <owl:NamedIndividual rdf:about="file:/C:/Users/suhas/Documents/GitHub/OntoBot/bldg3/trial/dataset/na99033713e994d3fac6c613af3f33cc0b3699">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#SPARQLRule"/>
        <sh:prefixes rdf:resource="https://brickschema.org/schema/1.3/Brick"/>
        <sh:construct>
        CONSTRUCT {
            $this rdf:type ?metertype .
        } WHERE {
            $this rdf:type/rdfs:subClassOf* brick:Building_Meter .
            $this brick:hasSubstance ?substance .
            ?metertype brick:hasSubstance ?substance .
            ?metertype rdfs:subClassOf+ brick:Building_Meter .
        }
        </sh:construct>
    </owl:NamedIndividual>
    


    <!-- file:/C:/Users/suhas/Documents/GitHub/OntoBot/bldg3/trial/dataset/na99033713e994d3fac6c613af3f33cc0b37 -->

