    <!-- https://brickschema.org/schema/Brick#Voltage -->

    <owl:NamedIndividual rdf:about="https://brickschema.org/schema/Brick#Voltage">
        <rdf:type rdf:resource="https://brickschema.org/schema/Brick#Quantity"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloV"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MegaV"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MicroV"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliV"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PlanckVolt"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/V"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/V_Ab"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/V_Stat"/>
        <skos:related rdf:resource="https://brickschema.org/schema/Brick#Voltage_Angle"/>
        <skos:related rdf:resource="https://brickschema.org/schema/Brick#Voltage_Imbalance"/>
        <brick:hasQUDTReference rdf:resource="http://qudt.org/vocab/quantitykind/Voltage"/>
        <rdfs:label>Voltage</rdfs:label>
        <skos:definition xml:lang="en">Voltage, also referred to as Electric Tension, is the difference between electrical potentials of two points. For an electric field within a medium, (U_{ab} = - \int_{r_a}^{r_b} E . {dr}), where (E) is electric field strength. For an irrotational electric field, the voltage is independent of the path between the two points (a) and (b).</skos:definition>
    </owl:NamedIndividual>
    


