        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MegaV-A-HR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MegaV-A_Reactive-HR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MegaW-HR"/>
