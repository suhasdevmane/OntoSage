        <rdfs:label>Cooling Demand Sensor</rdfs:label>
        <skos:definition xml:lang="en">Measures the amount of power consumed by a cooling process; typically found by multiplying the tonnage of a unit (e.g. RTU) by the efficiency rating in kW/ton</skos:definition>
        <sh:rule>na99033713e994d3fac6c613af3f33cc0b4240</sh:rule>
        <sh:rule>na99033713e994d3fac6c613af3f33cc0b4241</sh:rule>
