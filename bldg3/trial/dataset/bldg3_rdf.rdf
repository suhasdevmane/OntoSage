    <!-- file:/C:/Users/suhas/Documents/GitHub/OntoBot/bldg3/trial/dataset/na99033713e994d3fac6c613af3f33cc0b4057 -->

    <owl:NamedIndividual rdf:about="file:/C:/Users/suhas/Documents/GitHub/OntoBot/bldg3/trial/dataset/na99033713e994d3fac6c613af3f33cc0b4057">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#SPARQLConstraint"/>
        <sh:prefixes rdf:resource="https://brickschema.org/schema/1.3/Brick"/>
        <sh:select>
            SELECT $this
            WHERE {
                $this ref:hasExternalReference ?ref .
                ?ref rdf:type ref:TimeseriesReference .
                FILTER NOT EXISTS { $this rdf:type/rdfs:subClassOf* brick:Point }
            }
        </sh:select>
        <sh:message>Only Brick Points can have external timeseries references</sh:message>
    </owl:NamedIndividual>
    


