    <!-- https://brickschema.org/schema/Brick#Relative_Humidity -->

    <owl:NamedIndividual rdf:about="https://brickschema.org/schema/Brick#Relative_Humidity">
        <rdf:type rdf:resource="https://brickschema.org/schema/Brick#Quantity"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PERCENT"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PERCENT_RH"/>
        <skos:broader rdf:resource="https://brickschema.org/schema/Brick#Humidity"/>
        <brick:hasQUDTReference rdf:resource="http://qudt.org/vocab/quantitykind/RelativeHumidity"/>
        <rdfs:label>Relative Humidity</rdfs:label>
        <skos:definition xml:lang="en">Relative Humidity} is the ratio of the partial pressure of water vapor in an air-water mixture to the saturated vapor pressure of water at a prescribed temperature. The relative humidity of air depends not only on temperature but also on the pressure of the system of interest. Relative Humidity is also referred to as \text{Relative Partial Pressure. Relative partial pressure is often referred to as (RH) and expressed in percent.</skos:definition>
    </owl:NamedIndividual>
    


