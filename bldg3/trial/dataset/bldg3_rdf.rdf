    <!-- file:/C:/Users/suhas/Documents/GitHub/OntoBot/bldg3/trial/dataset/na99033713e994d3fac6c613af3f33cc0b4127 -->

    <owl:NamedIndividual rdf:about="file:/C:/Users/suhas/Documents/GitHub/OntoBot/bldg3/trial/dataset/na99033713e994d3fac6c613af3f33cc0b4127">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#SPARQLConstraint"/>
        <sh:prefixes rdf:resource="https://brickschema.org/schema/1.3/Brick"/>
        <sh:select>
            SELECT $this WHERE {
                $this brick:isVirtualMeter/brick:value true .
                FILTER NOT EXISTS { $this rdf:type/rdfs:subClassOf* brick:Meter } .
            }
        </sh:select>
        <sh:message>Only meters can have the isVirtualMeter property be true</sh:message>
    </owl:NamedIndividual>
    


