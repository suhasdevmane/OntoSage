        <rdfs:label>Rated maximum voltage input</rdfs:label>
        <skos:definition>The maximum voltage that can be input to the entity</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://brickschema.org/schema/Brick#ratedMaximumVoltageOutput">
        <rdfs:label>Rated maximum voltage output</rdfs:label>
        <skos:definition>The maximum voltage that can be output by the entity</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://brickschema.org/schema/Brick#ratedMinimumCurrentInput">
        <rdfs:label>Rated minimum current input</rdfs:label>
        <skos:definition>The minimum current that can be input to the entity</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://brickschema.org/schema/Brick#ratedMinimumCurrentOutput">
        <rdfs:label>Rated minimum current output</rdfs:label>
        <skos:definition>The minimum current that can be output by the entity</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://brickschema.org/schema/Brick#ratedMinimumVoltageInput">
        <rdfs:label>Rated minimum voltage input</rdfs:label>
        <skos:definition>The minimum voltage that can be input to the entity</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://brickschema.org/schema/Brick#ratedMinimumVoltageOutput">
        <rdfs:label>Rated minimum voltage output</rdfs:label>
        <skos:definition>The minimum voltage that can be output by the entity</skos:definition>
    </rdf:Description>
