    <!-- file:/C:/Users/suhas/Documents/GitHub/OntoBot/bldg3/trial/dataset/na99033713e994d3fac6c613af3f33cc0b3214 -->

    <owl:NamedIndividual rdf:about="file:/C:/Users/suhas/Documents/GitHub/OntoBot/bldg3/trial/dataset/na99033713e994d3fac6c613af3f33cc0b3214">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#SPARQLRule"/>
        <sh:prefixes rdf:resource="https://brickschema.org/schema/1.3/Brick"/>
        <sh:construct>CONSTRUCT {
$this a ?newClass .
}
WHERE {
$this a ?class .
?class owl:deprecated true .
?class brick:isReplacedBy ?newClass .
FILTER NOT EXISTS {$this a ?newClass}
}</sh:construct>
        <sh:message>Deprecated class is temporarily augmented by the new class</sh:message>
    </owl:NamedIndividual>
    


