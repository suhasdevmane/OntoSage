        <brick:hasAssociatedTag rdf:resource="https://brickschema.org/schema/BrickTag#Sensor"/>
        <brick:hasQuantity rdf:resource="https://brickschema.org/schema/Brick#Relative_Humidity"/>
        <brick:hasSubstance rdf:resource="https://brickschema.org/schema/Brick#Air"/>
    </owl:NamedIndividual>
    


