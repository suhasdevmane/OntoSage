        <skos:definition>The *rated* percentage of sunlight that is converted into usable power, as measured using Standard Test Conditions (STC): 1000 W/sqm irradiance, 25 degC panel temperature, no wind</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://brickschema.org/schema/Brick#ratedVoltageInput">
        <rdfs:label>Measured voltage input</rdfs:label>
        <skos:definition>The nominal rated voltage input of the entity</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://brickschema.org/schema/Brick#ratedVoltageOutput">
        <rdfs:label>Rated voltage output</rdfs:label>
        <skos:definition>The nominal rated voltage output of the entity</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://brickschema.org/schema/Brick#thermalTransmittance">
