        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/HP_Brake"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/HP_Electric"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/HP_Metric"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/J-PER-HR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/J-PER-SEC"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloBTU_IT-PER-HR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloCAL-PER-MIN"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloCAL-PER-SEC"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloV-A"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloV-A_Reactive"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloW"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MegaBTU_IT-PER-HR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MegaJ-PER-SEC"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MegaPA-L-PER-SEC"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MegaPA-M3-PER-SEC"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MegaV-A"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MegaV-A_Reactive"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MegaW"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MicroW"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliBAR-L-PER-SEC"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliBAR-M3-PER-SEC"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliW"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/NanoW"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PA-L-PER-SEC"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PA-M3-PER-SEC"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PSI-IN3-PER-SEC"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PSI-M3-PER-SEC"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PSI-YD3-PER-SEC"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PicoW"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PlanckPower"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/THM_US-PER-HR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/TON_FG"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/TeraW"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/V-A"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/V-A_Reactive"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/W"/>
        <skos:broader rdf:resource="https://brickschema.org/schema/Brick#Power"/>
        <skos:narrower rdf:resource="https://brickschema.org/schema/Brick#Active_Power"/>
        <skos:narrower rdf:resource="https://brickschema.org/schema/Brick#Apparent_Power"/>
        <skos:narrower rdf:resource="https://brickschema.org/schema/Brick#Complex_Power"/>
        <skos:narrower rdf:resource="https://brickschema.org/schema/Brick#Reactive_Power"/>
        <skos:narrower rdf:resource="https://brickschema.org/schema/Brick#Real_Power"/>
        <brick:hasQUDTReference rdf:resource="http://qudt.org/vocab/quantitykind/ElectricPower"/>
        <rdfs:label>Electric Power</rdfs:label>
        <skos:definition xml:lang="en">Electric Power is the rate at which electrical energy is transferred by an electric circuit. In the simple case of direct current circuits, electric power can be calculated as the product of the potential difference in the circuit (V) and the amount of current flowing in the circuit (I): (P = VI), where (P) is the power, (V) is the potential difference, and (I) is the current. However, in general electric power is calculated by taking the integral of the vector cross-product of the electrical and magnetic fields over a specified area.</skos:definition>
    </owl:NamedIndividual>
    


