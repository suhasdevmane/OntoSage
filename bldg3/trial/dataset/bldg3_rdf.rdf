    <owl:NamedIndividual rdf:about="https://brickschema.org/schema/Brick#Reactive_Power_Sensor">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
        <brick:hasAssociatedTag rdf:resource="https://brickschema.org/schema/BrickTag#Electric"/>
