        <rdfs:label>Trace Heat Sensor</rdfs:label>
        <skos:definition xml:lang="en">Measures the surface temperature of pipelines carrying temperature-sensitive products; typically used to avoid frosting/freezing</skos:definition>
        <sh:rule>na99033713e994d3fac6c613af3f33cc0b2763</sh:rule>
        <sh:rule>na99033713e994d3fac6c613af3f33cc0b2764</sh:rule>
