    <rdf:Description rdf:about="https://brickschema.org/schema/Brick#Cooling_Coil">
        <rdfs:label>Cooling Coil</rdfs:label>
        <skos:definition xml:lang="en">A cooling element made of pipe or tube that removes heat from equipment, machines or airflows. Typically filled with either refrigerant or cold water.</skos:definition>
        <sh:rule>na99033713e994d3fac6c613af3f33cc0b5022</sh:rule>
        <sh:rule>na99033713e994d3fac6c613af3f33cc0b5023</sh:rule>
