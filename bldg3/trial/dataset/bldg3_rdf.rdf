        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloLB_F-PER-IN2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloPA"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloPA_A"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/LB_F-PER-FT2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/LB_F-PER-IN2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MegaBAR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MegaPA"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MicroATM"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MicroBAR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MicroPA"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MicroTORR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliBAR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliM_H2O"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliM_HG"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliM_HGA"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliPA"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliTORR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/N-PER-CentiM2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/N-PER-M2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/N-PER-MilliM2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PA"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PDL-PER-FT2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PSI"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PicoPA"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PlanckPressure"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/TORR"/>
        <skos:broader rdf:resource="https://brickschema.org/schema/Brick#Pressure"/>
        <brick:hasQUDTReference rdf:resource="http://qudt.org/vocab/quantitykind/AtmosphericPressure"/>
        <rdfs:label>Atmospheric Pressure</rdfs:label>
        <skos:definition xml:lang="en">The pressure exerted by the weight of the air above it at any point on the earth&apos;s surface. At sea level the atmosphere will support a column of mercury about (760 mm) high. This decreases with increasing altitude. The standard value for the atmospheric pressure at sea level in SI units is (101,325 pascals).</skos:definition>
    </owl:NamedIndividual>
    


