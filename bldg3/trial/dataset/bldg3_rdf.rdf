    <rdf:Description rdf:about="https://brickschema.org/schema/Brick#Contact_Sensor">
        <rdfs:label>Contact Sensor</rdfs:label>
        <skos:definition xml:lang="en">Senses or detects contact, such as for determining if a door is closed.</skos:definition>
