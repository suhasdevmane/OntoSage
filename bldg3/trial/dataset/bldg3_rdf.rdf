    <!-- file:/C:/Users/suhas/Documents/GitHub/OntoBot/bldg3/trial/dataset/na99033713e994d3fac6c613af3f33cc0b3221 -->

    <owl:NamedIndividual rdf:about="file:/C:/Users/suhas/Documents/GitHub/OntoBot/bldg3/trial/dataset/na99033713e994d3fac6c613af3f33cc0b3221">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#SPARQLRule"/>
        <sh:prefixes rdf:resource="https://brickschema.org/schema/1.3/Brick"/>
        <sh:construct>
        CONSTRUCT { $this owl:deprecated true }
        WHERE { $this brick:deprecation ?dep }
        </sh:construct>
    </owl:NamedIndividual>
    


    <!-- file:/C:/Users/suhas/Documents/GitHub/OntoBot/bldg3/trial/dataset/na99033713e994d3fac6c613af3f33cc0b3222 -->

    <owl:NamedIndividual rdf:about="file:/C:/Users/suhas/Documents/GitHub/OntoBot/bldg3/trial/dataset/na99033713e994d3fac6c613af3f33cc0b3222">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#SPARQLConstraint"/>
        <sh:prefixes rdf:resource="https://brickschema.org/schema/1.3/Brick"/>
        <sh:select>SELECT $this ?class ?newClass ?depver WHERE {
$this a ?class .
?class owl:deprecated true .
?class brick:deprecatedInVersion ?depver .
?class brick:isReplacedBy ?newClass .
}</sh:select>
        <sh:message>{$this} has type {?class} which was deprecated in version {?depver}. For now, it has been updated to also be of type {?newClass}.</sh:message>
    </owl:NamedIndividual>
    


