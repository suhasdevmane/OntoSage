        <rdfs:label>Transformer</rdfs:label>
        <skos:definition xml:lang="en">A Transformer is usually fed by a high-voltage source and then steps down the voltage to a lower-voltage feed for low-voltage application (such as lights). Transformers also can step up voltage, but this generally does not apply to in building distribution.</skos:definition>
        <sh:rule>na99033713e994d3fac6c613af3f33cc0b2770</sh:rule>
        <sh:rule>na99033713e994d3fac6c613af3f33cc0b2771</sh:rule>
