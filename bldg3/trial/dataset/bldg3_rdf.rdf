        <brick:hasAssociatedTag rdf:resource="https://brickschema.org/schema/BrickTag#Reactive"/>
        <brick:hasAssociatedTag rdf:resource="https://brickschema.org/schema/BrickTag#Sensor"/>
        <brick:hasQuantity rdf:resource="https://brickschema.org/schema/Brick#Reactive_Energy"/>
