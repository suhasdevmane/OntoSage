        <rdfs:label>Torque Sensor</rdfs:label>
        <skos:definition xml:lang="en">Measures torque, the tendency of a force to rotate an object about some axis</skos:definition>
        <sh:rule>na99033713e994d3fac6c613af3f33cc0b4737</sh:rule>
