    <rdf:Description rdf:about="https://brickschema.org/schema/Brick#Centrifugal_Chiller">
        <rdfs:label>Centrifugal Chiller</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://bellomyims.com/your-definitive-guide-to-centrifugal-chillers/"/>
        <skos:definition xml:lang="en">A chiller that uses the vapor compression cycle to chill water. It throws off the heat collected from the chilled water plus the heat from the compressor to a water loop</skos:definition>
        <sh:rule>na99033713e994d3fac6c613af3f33cc0b236</sh:rule>
        <sh:rule>na99033713e994d3fac6c613af3f33cc0b237</sh:rule>
