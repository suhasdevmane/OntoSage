        <rdfs:comment>The property of the BACnet object to read to get the current value of this entity.</rdfs:comment>
        <rdfs:label>bacnet-read-property</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://brickschema.org/schema/Brick/ref#hasExternalReference">
        <rdfs:label>hasExternalReference</rdfs:label>
        <skos:definition>Points to the external reference for this entity, which contains additional metadata/data not included in this graph.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://brickschema.org/schema/Brick/ref#hasIfcProjectReference">
        <rdfs:label>hasIfcProjectReference</rdfs:label>
        <skos:definition>A reference to the IFC Project that defines this entity</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://brickschema.org/schema/Brick/ref#hasTimeseriesId">
        <rdfs:label>hasTimeseriesId</rdfs:label>
        <skos:definition xml:lang="en">The unique identifier (primary key) for this TimeseriesReference in some database</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://brickschema.org/schema/Brick/ref#hasTimeseriesReference">
        <rdfs:label>hasTimeseriesReference</rdfs:label>
