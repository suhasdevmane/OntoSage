        <rdfs:isDefinedBy rdf:resource="https://brickschema.org/schema/Brick"/>
        <rdfs:label>Radiant_Temperature</rdfs:label>
        <skos:definition xml:lang="en">the uniform temperature of an imaginary enclosure in which the radiant heat transfer from the human body is equal to the radiant heat transfer in the actual non-uniform enclosure. (https://en.wikipedia.org/wiki/Mean_radiant_temperature)</skos:definition>
        <skos:definition>the uniform temperature of an imaginary enclosure in which the radiant heat transfer from the human body is equal to the radiant heat transfer in the actual non-uniform enclosure. (https://en.wikipedia.org/wiki/Mean_radiant_temperature)</skos:definition>
    </owl:NamedIndividual>
    


