# SATURATE (V4-T08): simulated temperature sensors for spaces the coverage
# audit found uninstrumented. Every sensor is labeled ontosage:isSimulated.
# Rows live in the narrow table 'temperature_data' (database_registry.yaml key).
@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix ref:   <https://brickschema.org/schema/Brick/ref#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ontosage: <http://ontosage.org/capabilities#> .
@prefix bldg:  <http://buildsys.org/ontologies/bldg3#> .

<http://buildsys.org/ontologies/bldg3#temperature_data>
    a ref:Database ;
    rdfs:label "Temperature Data" .

<http://buildsys.org/ontologies/bldg3#RM007_room_sat_temperature>
    a brick:Zone_Air_Temperature_Sensor ;
    rdfs:label "RM007_room temperature (simulated) [degC]"@en ;
    brick:hasLocation <http://buildsys.org/ontologies/bldg3#RM007_room> ;
    ontosage:isSimulated "true"^^xsd:boolean ;
    rdfs:comment "synthetic-saturation-v4" ;
    ref:hasExternalReference [
        a ref:TimeseriesReference ;
        ref:hasTimeseriesId "6fcec3d9-f0ee-54a6-90d3-74e194f5ad7d" ;
        ref:storedAt <http://buildsys.org/ontologies/bldg3#temperature_data> ;
    ] .

<http://buildsys.org/ontologies/bldg3#RM039_room_sat_temperature>
    a brick:Zone_Air_Temperature_Sensor ;
    rdfs:label "RM039_room temperature (simulated) [degC]"@en ;
    brick:hasLocation <http://buildsys.org/ontologies/bldg3#RM039_room> ;
    ontosage:isSimulated "true"^^xsd:boolean ;
    rdfs:comment "synthetic-saturation-v4" ;
    ref:hasExternalReference [
        a ref:TimeseriesReference ;
        ref:hasTimeseriesId "ca52b093-b608-5d75-a54c-061eb194c681" ;
        ref:storedAt <http://buildsys.org/ontologies/bldg3#temperature_data> ;
    ] .

<http://buildsys.org/ontologies/bldg3#RM259A_room_sat_temperature>
    a brick:Zone_Air_Temperature_Sensor ;
    rdfs:label "RM259A_room temperature (simulated) [degC]"@en ;
    brick:hasLocation <http://buildsys.org/ontologies/bldg3#RM259A_room> ;
    ontosage:isSimulated "true"^^xsd:boolean ;
    rdfs:comment "synthetic-saturation-v4" ;
    ref:hasExternalReference [
        a ref:TimeseriesReference ;
        ref:hasTimeseriesId "151cbe41-4660-57a4-9d33-c9e6c760c27f" ;
        ref:storedAt <http://buildsys.org/ontologies/bldg3#temperature_data> ;
    ] .
