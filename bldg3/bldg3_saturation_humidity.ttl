# SATURATE (V4-T08): simulated humidity sensors for spaces the coverage
# audit found uninstrumented. Every sensor is labeled ontosage:isSimulated.
# Rows live in the narrow table 'humidity_data' (database_registry.yaml key).
@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix ref:   <https://brickschema.org/schema/Brick/ref#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ontosage: <http://ontosage.org/capabilities#> .
@prefix bldg:  <http://buildsys.org/ontologies/bldg3#> .

<http://buildsys.org/ontologies/bldg3#humidity_data>
    a ref:Database ;
    rdfs:label "Humidity Data" .

<http://buildsys.org/ontologies/bldg3#RM007_room_sat_humidity>
    a brick:Relative_Humidity_Sensor ;
    rdfs:label "RM007_room humidity (simulated) [percent]"@en ;
    brick:hasLocation <http://buildsys.org/ontologies/bldg3#RM007_room> ;
    ontosage:isSimulated "true"^^xsd:boolean ;
    rdfs:comment "synthetic-saturation-v4" ;
    ref:hasExternalReference [
        a ref:TimeseriesReference ;
        ref:hasTimeseriesId "d373b1cc-11a4-579a-a79e-4fa35f84943a" ;
        ref:storedAt <http://buildsys.org/ontologies/bldg3#humidity_data> ;
    ] .

