# Per-building .env delta — bldg4 (Northgate Test House, WHOLLY FICTIONAL).
# When THIS building is active (this folder is named input/), the root .env must
# contain exactly these values. Everything else in .env is building-independent.
# NEVER commit the real .env — .env4 is gitignored, this delta is what is tracked.
#
# bldg4 exists only to test GUI onboarding (TODO-072), so the normal swap-by-rename
# is NOT how it is used: start it with an EMPTY input/ and upload bldg4/'s files
# through the Admin Console. Renaming bldg4/ to input/ would test the file loader,
# which already works, instead of the console, which is the claim under test.
BUILDING_ID=bldg4
BUILDING_NAME=Northgate Test House (bldg4)
BUILDING_NAMESPACE=http://example.org/ontosage/bldg4#
BUILDING_PREFIX=bldg
BUILDING_TIMEZONE=Europe/London
MYSQL_DATABASE=bldg4db
COMPOSE_PROJECT_NAME=ontosage_bldgtest
