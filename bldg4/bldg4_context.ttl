# Building context for bldg4: knowledge topics, service state, drinkability.
#
# GENERATED by scripts/generate_building_context.py. Every subject declares
# ontosage:isSimulated, because each of these is authored rather than measured.
#
# DISCOVERED, not assumed: the namespace, floors, rooms and amenities below were read
# from bldg4's own TTLs. This building names its floors ['Floor0', 'Floor1']
# and its rooms in its own style; nothing here was written against another building's
# naming, which is the only way this demonstrates building-agnosticism rather than
# demonstrating that someone was told the answer.
#
# The CONTENT differs from every other building's on purpose. Cloning one building's
# topics into another would make them answer identically for the wrong reason, and a
# portability test that passes because the fixtures are the same file tests nothing.

@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix ontosage: <http://ontosage.org/capabilities#> .
@prefix bldg:     <http://example.org/ontosage/bldg4#> .

# ── knowledge topics ────────────────────────────────────────────────────────

bldg:Topic_Wifi a ontosage:KnowledgeTopic , ontosage:InformationTopic ;
    rdfs:label "Wifi"@en ;
    ontosage:capabilityCategory "INFORMATION" ;
    ontosage:layTerms "wifi, wi-fi, wireless, internet, network access" ;
    ontosage:answerText "The building has a single wireless network; the services desk issues guest access." ;
    ontosage:contactEmail "services@northgate.example.org" ;
    ontosage:contactPhone "+44 20 7946 0999" ;
    ontosage:isSimulated "true"^^xsd:boolean .

bldg:Topic_LostProperty a ontosage:KnowledgeTopic , ontosage:InformationTopic ;
    rdfs:label "Lost Property"@en ;
    ontosage:capabilityCategory "INFORMATION" ;
    ontosage:layTerms "lost, found, lost property, i left, missing" ;
    ontosage:answerText "Lost property is held at the services desk for thirty days." ;
    ontosage:contactEmail "services@northgate.example.org" ;
    ontosage:contactPhone "+44 20 7946 0999" ;
    ontosage:isSimulated "true"^^xsd:boolean .

bldg:Topic_OpeningHours a ontosage:KnowledgeTopic , ontosage:InformationTopic ;
    rdfs:label "Opening hours"@en ;
    ontosage:capabilityCategory "INFORMATION" ;
    ontosage:layTerms "opening hours, when is the building open, access hours, closing time, is it open" ;
    ontosage:answerText "Open 07:00-19:00 weekdays, closed at weekends." ;
    ontosage:isSimulated "true"^^xsd:boolean .

# ── amenity service state ───────────────────────────────────────────────────

bldg:Status_Amenity_DrinkingWater_Floor0 a ontosage:AssetStatus ;
    ontosage:statusOf bldg:Amenity_DrinkingWater_Floor0 ;
    ontosage:statusValue "out_of_service" ;
    ontosage:statusReason "isolated during adjacent works" ;
    rdfs:label "Service state - Drinking water point"@en ;
    ontosage:isSimulated "true"^^xsd:boolean .

# ── drinkability ────────────────────────────────────────────────────────────
#
# Authored only because this building is FICTIONAL (building.yaml declares
# provenance.nature: synthetic). A simulated drinkability claim about a real
# building is a false health claim, and five of them had to be removed from this
# repository once already.

bldg:Potability_DrinkingWater a ontosage:PotabilityStatement ;
    rdfs:label "Drinking water quality"@en ;
    ontosage:layTerms "is the water safe to drink, can i drink the water, potable, drinkable, tap water safe, water quality" ;
    ontosage:potabilityValue "potable" ;
    ontosage:potabilityAuthority "Northgate Building Services" ;
    ontosage:potabilityIssuedOn "2024-01-01"^^xsd:date ;
    ontosage:appliesToOutlet bldg:Amenity_DrinkingWater_Floor0 ;
    ontosage:isSimulated "true"^^xsd:boolean .
