# SATURATE (V4-T08): simulated illuminance sensors for spaces the coverage
# audit found uninstrumented. Every sensor is labeled ontosage:isSimulated.
# Rows live in the narrow table 'light_data' (database_registry.yaml key).
@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix ref:   <https://brickschema.org/schema/Brick/ref#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ontosage: <http://ontosage.org/capabilities#> .
@prefix bldg:  <http://buildsys.org/ontologies/bldg2#> .

<http://buildsys.org/ontologies/bldg2#light_data>
    a ref:Database ;
    rdfs:label "Light Data" .

<http://buildsys.org/ontologies/bldg2#RM001A_room_sat_illuminance>
    a brick:Illuminance_Sensor ;
    rdfs:label "RM001A_room illuminance (simulated) [lux]"@en ;
    brick:hasLocation <http://buildsys.org/ontologies/bldg2#RM001A_room> ;
    ontosage:isSimulated "true"^^xsd:boolean ;
    rdfs:comment "synthetic-saturation-v4" ;
    ref:hasExternalReference [
        a ref:TimeseriesReference ;
        ref:hasTimeseriesId "89ba1abf-bdb8-5237-a657-56b35d414238" ;
        ref:storedAt <http://buildsys.org/ontologies/bldg2#light_data> ;
    ] .

