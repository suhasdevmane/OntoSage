# Building context for bldg2: knowledge topics, service state, drinkability.
#
# GENERATED by scripts/generate_building_context.py. Every subject declares
# ontosage:isSimulated, because each of these is authored rather than measured.
#
# DISCOVERED, not assumed: the namespace, floors, rooms and amenities below were read
# from bldg2's own TTLs. This building names its floors ['floor0', 'floor1']
# and its rooms in its own style; nothing here was written against another building's
# naming, which is the only way this demonstrates building-agnosticism rather than
# demonstrating that someone was told the answer.
#
# The CONTENT differs from every other building's on purpose. Cloning one building's
# topics into another would make them answer identically for the wrong reason, and a
# portability test that passes because the fixtures are the same file tests nothing.

@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix ontosage: <http://ontosage.org/capabilities#> .
@prefix bldg:     <http://buildsys.org/ontologies/bldg2#> .

# ── knowledge topics ────────────────────────────────────────────────────────

bldg:Topic_Recycling a ontosage:KnowledgeTopic , ontosage:InformationTopic ;
    rdfs:label "Recycling"@en ;
    ontosage:capabilityCategory "INFORMATION" ;
    ontosage:layTerms "recycling, bins, waste, rubbish, where do i put" ;
    ontosage:answerText "Mixed recycling and landfill bins sit on every floor by the stair core; glass goes to the loading bay." ;
    ontosage:contactEmail "estates@wellman.example.org" ;
    ontosage:contactPhone "+1 555 0147" ;
    ontosage:isSimulated "true"^^xsd:boolean .

bldg:Topic_Deliveries a ontosage:KnowledgeTopic , ontosage:InformationTopic ;
    rdfs:label "Deliveries"@en ;
    ontosage:capabilityCategory "INFORMATION" ;
    ontosage:layTerms "delivery, parcel, courier, goods in, post" ;
    ontosage:answerText "Deliveries are received at the loading bay and held at the estates office for collection." ;
    ontosage:contactEmail "estates@wellman.example.org" ;
    ontosage:contactPhone "+1 555 0147" ;
    ontosage:isSimulated "true"^^xsd:boolean .

bldg:Topic_Bookings a ontosage:KnowledgeTopic , ontosage:InformationTopic ;
    rdfs:label "Bookings"@en ;
    ontosage:capabilityCategory "INFORMATION" ;
    ontosage:layTerms "book a room, reserve, meeting room booking, how do i book" ;
    ontosage:answerText "Rooms are booked through the campus booking system; the estates office can help with recurring bookings." ;
    ontosage:contactEmail "estates@wellman.example.org" ;
    ontosage:contactPhone "+1 555 0147" ;
    ontosage:isSimulated "true"^^xsd:boolean .

bldg:Topic_OpeningHours a ontosage:KnowledgeTopic , ontosage:InformationTopic ;
    rdfs:label "Opening hours"@en ;
    ontosage:capabilityCategory "INFORMATION" ;
    ontosage:layTerms "opening hours, when is the building open, access hours, closing time, is it open" ;
    ontosage:answerText "Open 06:30-20:00 Monday to Friday, 09:00-13:00 Saturday." ;
    ontosage:isSimulated "true"^^xsd:boolean .

# ── amenity service state ───────────────────────────────────────────────────

bldg:Status_Amenity_DrinkingWater_floor2 a ontosage:AssetStatus ;
    ontosage:statusOf bldg:Amenity_DrinkingWater_floor2 ;
    ontosage:statusValue "out_of_service" ;
    ontosage:statusReason "isolated during adjacent works" ;
    rdfs:label "Service state - Drinking water point — RM201_room"@en ;
    ontosage:isSimulated "true"^^xsd:boolean .

bldg:Status_Amenity_StudyArea_floor1 a ontosage:AssetStatus ;
    ontosage:statusOf bldg:Amenity_StudyArea_floor1 ;
    ontosage:statusValue "out_of_service" ;
    ontosage:statusReason "reported faulty and booked for repair" ;
    rdfs:label "Service state - Study area — RM103_room"@en ;
    ontosage:isSimulated "true"^^xsd:boolean .

bldg:Status_Amenity_ToiletFacility_floor2 a ontosage:AssetStatus ;
    ontosage:statusOf bldg:Amenity_ToiletFacility_floor2 ;
    ontosage:statusValue "out_of_service" ;
    ontosage:statusReason "isolated during adjacent works" ;
    rdfs:label "Service state - Toilet facility — RM202_room"@en ;
    ontosage:isSimulated "true"^^xsd:boolean .

# ── drinkability ────────────────────────────────────────────────────────────
#
# Authored only because this building is FICTIONAL (building.yaml declares
# provenance.nature: synthetic). A simulated drinkability claim about a real
# building is a false health claim, and five of them had to be removed from this
# repository once already.

bldg:Potability_DrinkingWater a ontosage:PotabilityStatement ;
    rdfs:label "Drinking water quality"@en ;
    ontosage:layTerms "is the water safe to drink, can i drink the water, potable, drinkable, tap water safe, water quality" ;
    ontosage:potabilityValue "potable" ;
    ontosage:potabilityAuthority "Wellman Estates Office" ;
    ontosage:potabilityIssuedOn "2024-01-01"^^xsd:date ;
    ontosage:appliesToOutlet bldg:Amenity_DrinkingWater_floor0 ,
        bldg:Amenity_DrinkingWater_floor1 ,
        bldg:Amenity_DrinkingWater_floor2 ;
    ontosage:isSimulated "true"^^xsd:boolean .
