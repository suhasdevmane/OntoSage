# SATURATE (V4-T08): simulated occupancy sensors for spaces the coverage
# audit found uninstrumented. Every sensor is labeled ontosage:isSimulated.
# Rows live in the narrow table 'occupancy_data' (database_registry.yaml key).
@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix ref:   <https://brickschema.org/schema/Brick/ref#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ontosage: <http://ontosage.org/capabilities#> .
@prefix bldg:  <http://buildsys.org/ontologies/bldg2#> .

<http://buildsys.org/ontologies/bldg2#occupancy_data>
    a ref:Database ;
    rdfs:label "Occupancy Data" .

<http://buildsys.org/ontologies/bldg2#RM001A_room_sat_occupancy>
    a brick:Occupancy_Count_Sensor ;
    rdfs:label "RM001A_room occupancy (simulated) [persons]"@en ;
    brick:hasLocation <http://buildsys.org/ontologies/bldg2#RM001A_room> ;
    ontosage:isSimulated "true"^^xsd:boolean ;
    rdfs:comment "synthetic-saturation-v4" ;
    ref:hasExternalReference [
        a ref:TimeseriesReference ;
        ref:hasTimeseriesId "3ff5a76b-bf8f-5f70-8652-d6ca218b4f8e" ;
        ref:storedAt <http://buildsys.org/ontologies/bldg2#occupancy_data> ;
    ] .

