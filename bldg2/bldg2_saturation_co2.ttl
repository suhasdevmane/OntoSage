# SATURATE (V4-T08): simulated co2 sensors for spaces the coverage
# audit found uninstrumented. Every sensor is labeled ontosage:isSimulated.
# Rows live in the narrow table 'co2_data' (database_registry.yaml key).
@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix ref:   <https://brickschema.org/schema/Brick/ref#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ontosage: <http://ontosage.org/capabilities#> .
@prefix bldg:  <http://buildsys.org/ontologies/bldg2#> .

<http://buildsys.org/ontologies/bldg2#co2_data>
    a ref:Database ;
    rdfs:label "Co2 Data" .

<http://buildsys.org/ontologies/bldg2#RM001A_room_sat_co2>
    a brick:CO2_Level_Sensor ;
    rdfs:label "RM001A_room co2 (simulated) [ppm]"@en ;
    brick:hasLocation <http://buildsys.org/ontologies/bldg2#RM001A_room> ;
    ontosage:isSimulated "true"^^xsd:boolean ;
    rdfs:comment "synthetic-saturation-v4" ;
    ref:hasExternalReference [
        a ref:TimeseriesReference ;
        ref:hasTimeseriesId "0587b84f-97bf-509b-b58e-47041c6d52ce" ;
        ref:storedAt <http://buildsys.org/ontologies/bldg2#co2_data> ;
