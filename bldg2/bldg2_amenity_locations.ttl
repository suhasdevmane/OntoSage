# SATURATE (V4-T12): per-instance amenities with STRUCTURED locations
# (ontosage:locatedIn <space>) so proximity constraints are computable.
# Placement is simulated and labeled as such; replace with surveyed
# locations for a real building — the structure is what matters.
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ontosage: <http://ontosage.org/capabilities#> .
@prefix bldg:  <http://buildsys.org/ontologies/bldg2#> .

<http://buildsys.org/ontologies/bldg2#Amenity_DrinkingWater_floor0>
    a ontosage:Amenity , ontosage:DrinkingWater ;
    rdfs:label "Drinking water point — RM001A_room"@en ;
    ontosage:layTerms "water, drinking water, water fountain, water cooler, bottle filling, fill my bottle" ;
    ontosage:locatedIn <http://buildsys.org/ontologies/bldg2#RM001A_room> ;
    ontosage:onFloor "floor0" ;
    ontosage:locationText "Drinking water point in RM001A_room (floor floor0)" ;
    ontosage:answerText "There is a drinking water point in RM001A_room on floor floor0." ;
    ontosage:isSimulated "true"^^xsd:boolean .

