# Measured forecast skill for bldg2 (OCBV Module J, CAVEAT-324).
#
# GENERATED by scripts/publish_forecast_skill.py from
# volumes/bldg2/artifacts/forecast_skill.json, which the forecast grader
# writes from walk-forward backtesting. NOTHING HERE IS MEASURED BY THIS SCRIPT:
# it transcribes what the grader measured, and carries graded_at through as
# ontosage:skillMeasuredAt so a stale cell reads as stale rather than as current.
#
# A modality with no measured cell gets no triple. An absent skill record is the
# honest state; inventing a plausible MAE for an unmeasured modality is exactly
# the fabrication the evidence discipline exists to prevent.

@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix ontosage: <http://ontosage.org/capabilities#> .
@prefix bldg:     <http://buildsys.org/ontologies/bldg2#> .

bldg:ForecastSkill_co2_1h a ontosage:ForecastSkill ;
    rdfs:label "Forecast skill - co2 at 1h"@en ;
    ontosage:skillOf "co2" ;
    ontosage:horizonHours 1 ;
    ontosage:backtestMAE 112.455 ;
    ontosage:backtestMAPE 24.3433 ;
    ontosage:ciCoverage80 0.8333 ;
    ontosage:skillMeasuredAt "2026-08-19T02:07:52"^^xsd:dateTime ;
    rdfs:comment "Measured over 6 walk-forward fit(s)." .

