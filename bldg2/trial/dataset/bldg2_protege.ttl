<file:///C:/Users/suhas/Documents/GitHub/OntoBot/bldg2/trial/dataset/na99033713e994d3fac6c613af3f33cc0b3221> rdf:type owl:NamedIndividual ,
                                                                                                                      sh:SPARQLRule ;
                                                                                                             sh:prefixes <https://brickschema.org/schema/1.3/Brick> ;
                                                                                                             sh:construct """
        CONSTRUCT { $this owl:deprecated true }
