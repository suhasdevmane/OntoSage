###  file:///C:/Users/suhas/Documents/GitHub/OntoBot/bldg2/trial/dataset/na99033713e994d3fac6c613af3f33cc0b3604
<file:///C:/Users/suhas/Documents/GitHub/OntoBot/bldg2/trial/dataset/na99033713e994d3fac6c613af3f33cc0b3604> rdf:type owl:NamedIndividual ,
                                                                                                                      sh:SPARQLRule ;
                                                                                                             sh:prefixes <https://brickschema.org/schema/1.3/Brick> ;
                                                                                                             sh:construct """
            CONSTRUCT {
$this ?invP ?o .
}
WHERE {
?o ?p $this .
{?invP owl:inverseOf ?p} UNION {?invP s223:inverseOf ?p} .
}
			""" .


###  file:///C:/Users/suhas/Documents/GitHub/OntoBot/bldg2/trial/dataset/na99033713e994d3fac6c613af3f33cc0b3605
<file:///C:/Users/suhas/Documents/GitHub/OntoBot/bldg2/trial/dataset/na99033713e994d3fac6c613af3f33cc0b3605> rdf:type owl:NamedIndividual ,
                                                                                                                      sh:SPARQLRule ;
                                                                                                             sh:prefixes <https://brickschema.org/schema/1.3/Brick> ;
                                                                                                             sh:construct """
CONSTRUCT {
?o ?prop $this .
$this ?prop ?o .
}
WHERE {
  { $this ?prop ?o } UNION { ?o ?prop $this } .
  {?prop a owl:SymmetricProperty} UNION {?prop a s223:SymmetricProperty} .
}
			""" .


