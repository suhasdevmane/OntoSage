###  http://data.ashrae.org/bacnet/2020#latitude
bacnet:latitude rdf:type owl:ObjectProperty .


###  http://data.ashrae.org/bacnet/2020#longitude
bacnet:longitude rdf:type owl:ObjectProperty .


###  http://www.w3.org/2004/02/skos/core#broader
skos:broader owl:inverseOf skos:narrower ;
             rdfs:label "has broader"@en .


###  http://www.w3.org/2004/02/skos/core#narrower
skos:narrower rdfs:label "has narrower"@en .


###  http://www.w3.org/2006/vcard/ns#hasAddress
vcard:hasAddress rdf:type owl:ObjectProperty .


###  https://brickschema.org/schema/Brick#Relationship
brick:Relationship rdf:type owl:ObjectProperty ;
                   rdfs:label "Relationship" ;
                   skos:definition "Super-property of all Brick relationships between entities (Equipment, Location, Point)" .


###  https://brickschema.org/schema/Brick#aggregationFunction
brick:aggregationFunction rdf:type owl:ObjectProperty .


###  https://brickschema.org/schema/Brick#ambientTemperatureOfMeasurement
brick:ambientTemperatureOfMeasurement rdf:type owl:ObjectProperty .


###  https://brickschema.org/schema/Brick#deprecationMitigationRule
brick:deprecationMitigationRule rdf:type owl:ObjectProperty .


###  https://brickschema.org/schema/Brick#feeds
brick:feeds rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf brick:Relationship ;
            owl:inverseOf brick:isFedBy ;
            rdf:type owl:AsymmetricProperty ,
                     owl:IrreflexiveProperty .


###  https://brickschema.org/schema/Brick#hasAddress
brick:hasAddress rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf vcard:hasAddress ,
                                    brick:Relationship .


###  https://brickschema.org/schema/Brick#hasAssociatedTag
brick:hasAssociatedTag rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf brick:Relationship ;
                       owl:inverseOf brick:isAssociatedWith ;
                       rdf:type owl:AsymmetricProperty ,
                                owl:IrreflexiveProperty .


###  https://brickschema.org/schema/Brick#hasInputSubstance
brick:hasInputSubstance rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf brick:Relationship ;
                        rdf:type owl:AsymmetricProperty ,
                                 owl:IrreflexiveProperty .


###  https://brickschema.org/schema/Brick#hasLocation
brick:hasLocation rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf brick:Relationship ;
                  owl:inverseOf brick:isLocationOf ;
                  rdf:type owl:AsymmetricProperty ,
                           owl:IrreflexiveProperty .


###  https://brickschema.org/schema/Brick#hasOutputSubstance
brick:hasOutputSubstance rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf brick:Relationship ;
                         rdf:type owl:AsymmetricProperty ,
                                  owl:IrreflexiveProperty .


###  https://brickschema.org/schema/Brick#hasPart
brick:hasPart rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf brick:Relationship ;
              owl:inverseOf brick:isPartOf ;
              rdf:type owl:AsymmetricProperty ,
                       owl:IrreflexiveProperty .


###  https://brickschema.org/schema/Brick#hasPoint
brick:hasPoint rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf brick:Relationship ;
               owl:inverseOf brick:isPointOf ;
               rdf:type owl:AsymmetricProperty ,
                        owl:IrreflexiveProperty .


###  https://brickschema.org/schema/Brick#hasQUDTReference
brick:hasQUDTReference rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf brick:Relationship ;
                       rdf:type owl:AsymmetricProperty ,
                                owl:IrreflexiveProperty .


###  https://brickschema.org/schema/Brick#hasQuantity
brick:hasQuantity rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf qudt:hasQuantityKind ,
                                     brick:Relationship ;
                  rdf:type owl:AsymmetricProperty ,
                           owl:IrreflexiveProperty .


###  https://brickschema.org/schema/Brick#hasSubMeter
brick:hasSubMeter rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf brick:Relationship ;
                  owl:inverseOf brick:isSubMeterOf ;
                  rdf:type owl:AsymmetricProperty ,
                           owl:IrreflexiveProperty .


###  https://brickschema.org/schema/Brick#hasSubstance
brick:hasSubstance rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf brick:Relationship ;
                   rdf:type owl:AsymmetricProperty ,
                            owl:IrreflexiveProperty .


###  https://brickschema.org/schema/Brick#hasTag
brick:hasTag rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf brick:Relationship ;
             owl:inverseOf brick:isTagOf ;
             rdf:type owl:AsymmetricProperty ,
                      owl:IrreflexiveProperty .


###  https://brickschema.org/schema/Brick#hasUnit
brick:hasUnit rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf brick:Relationship ;
              rdf:type owl:AsymmetricProperty ,
                       owl:IrreflexiveProperty .


###  https://brickschema.org/schema/Brick#isAssociatedWith
brick:isAssociatedWith rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf brick:Relationship ;
                       rdf:type owl:AsymmetricProperty ,
                                owl:IrreflexiveProperty .


###  https://brickschema.org/schema/Brick#isFedBy
brick:isFedBy rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf brick:Relationship ;
              rdf:type owl:AsymmetricProperty ,
                       owl:IrreflexiveProperty .


###  https://brickschema.org/schema/Brick#isLocationOf
brick:isLocationOf rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf brick:Relationship ;
                   rdf:type owl:AsymmetricProperty ,
                            owl:IrreflexiveProperty .


###  https://brickschema.org/schema/Brick#isMeteredBy
brick:isMeteredBy rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf brick:Relationship ;
                  owl:inverseOf brick:meters ;
                  rdf:type owl:AsymmetricProperty ,
                           owl:IrreflexiveProperty .


###  https://brickschema.org/schema/Brick#isPartOf
brick:isPartOf rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf brick:Relationship ;
               rdf:type owl:AsymmetricProperty ,
                        owl:IrreflexiveProperty .


###  https://brickschema.org/schema/Brick#isPointOf
brick:isPointOf rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf brick:Relationship ;
                rdf:type owl:AsymmetricProperty ,
                         owl:IrreflexiveProperty .


###  https://brickschema.org/schema/Brick#isReplacedBy
brick:isReplacedBy rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf brick:Relationship ;
                   rdf:type owl:AsymmetricProperty ,
                            owl:IrreflexiveProperty .


###  https://brickschema.org/schema/Brick#isSubMeterOf
brick:isSubMeterOf rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf brick:Relationship ;
                   rdf:type owl:AsymmetricProperty ,
                            owl:IrreflexiveProperty .


###  https://brickschema.org/schema/Brick#isTagOf
brick:isTagOf rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf brick:Relationship ;
              rdf:type owl:AsymmetricProperty ,
                       owl:IrreflexiveProperty .


###  https://brickschema.org/schema/Brick#latitude
brick:latitude rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf bacnet:latitude ,
                                  brick:Relationship .


###  https://brickschema.org/schema/Brick#longitude
brick:longitude rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf bacnet:longitude ,
                                   brick:Relationship .


###  https://brickschema.org/schema/Brick#meters
brick:meters rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf brick:Relationship ;
             rdf:type owl:AsymmetricProperty ,
                      owl:IrreflexiveProperty .


###  https://brickschema.org/schema/Brick#timestamp
brick:timestamp rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf brick:Relationship .


###  https://brickschema.org/schema/Brick#value
brick:value rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf brick:Relationship .


###  https://brickschema.org/schema/Brick/ref#hasExternalReference
ref:hasExternalReference rdf:type owl:ObjectProperty .


###  https://brickschema.org/schema/Brick/ref#hasIfcProjectReference
ref:hasIfcProjectReference rdf:type owl:ObjectProperty .


###  https://brickschema.org/schema/Brick/ref#hasTimeseriesReference
ref:hasTimeseriesReference rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf ref:hasExternalReference .


###  https://brickschema.org/schema/Brick/ref#objectOf
ref:objectOf rdf:type owl:ObjectProperty ;
             rdfs:range ref:BACnetDevice .


