###  file:///C:/Users/suhas/Documents/GitHub/OntoBot/bldg2/trial/dataset/na99033713e994d3fac6c613af3f33cc0b3700
<file:///C:/Users/suhas/Documents/GitHub/OntoBot/bldg2/trial/dataset/na99033713e994d3fac6c613af3f33cc0b3700> rdf:type owl:NamedIndividual ,
                                                                                                                      sh:SPARQLRule ;
                                                                                                             sh:prefixes <https://brickschema.org/schema/1.3/Brick> ;
                                                                                                             sh:construct """
        CONSTRUCT {
            $this rdf:type ?metertype .
        } WHERE {
            $this rdf:type/rdfs:subClassOf* brick:Meter .
            $this brick:hasSubstance ?substance .
            ?metertype brick:hasSubstance ?substance .
            FILTER NOT EXISTS {
                $this rdf:type/rdf:subClassOf* brick:Building_Meter
            }
            MINUS {
                ?metertype rdfs:subClassOf* brick:Building_Meter .
            }
        }
        """ .


###  file:///C:/Users/suhas/Documents/GitHub/OntoBot/bldg2/trial/dataset/na99033713e994d3fac6c613af3f33cc0b3701
<file:///C:/Users/suhas/Documents/GitHub/OntoBot/bldg2/trial/dataset/na99033713e994d3fac6c613af3f33cc0b3701> rdf:type owl:NamedIndividual ,
                                                                                                                      sh:SPARQLRule ;
                                                                                                             sh:prefixes <https://brickschema.org/schema/1.3/Brick> ;
                                                                                                             sh:construct """
        CONSTRUCT {
            $this brick:hasSubstance ?substance .
        } WHERE {
            $this rdf:type ?meter .
            ?meter rdfs:subClassOf* brick:Meter .
            ?meter brick:hasSubstance ?substance .
        }
        """ .


