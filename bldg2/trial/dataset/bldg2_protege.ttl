#################################################################
#    Classes
#################################################################

###  http://data.ashrae.org/bacnet/2020#Consortium
bacnet:Consortium rdf:type owl:Class .


###  http://data.ashrae.org/bacnet/2020#Person
bacnet:Person rdf:type owl:Class .


###  http://www.w3.org/2002/07/owl#ObjectProperty
owl:ObjectProperty rdf:type owl:Class .


###  http://www.w3.org/2006/vcard/ns#Address
vcard:Address rdf:type owl:Class .


###  http://www.w3.org/ns/sosa/FeatureOfInterest
sosa:FeatureOfInterest rdf:type owl:Class .


###  http://www.w3.org/ns/sosa/ObservableProperty
sosa:ObservableProperty rdf:type owl:Class .


###  https://brickschema.org/schema/Brick#AED
brick:AED rdf:type owl:Class ;
          owl:equivalentClass brick:Automated_External_Defibrillator ;
          rdfs:label "AED" ;
          brick:aliasOf brick:Automated_External_Defibrillator .


###  https://brickschema.org/schema/Brick#AHU
brick:AHU rdf:type owl:Class ;
          owl:equivalentClass brick:Air_Handling_Unit ;
          rdfs:label "AHU" ;
          skos:definition "Assembly consisting of sections containing a fan or fans and other necessary equipment to perform one or more of the following functions: circulating, filtration, heating, cooling, heat recovery, humidifying, dehumidifying, and mixing of air. Is usually connected to an air-distribution system."@en ;
          brick:aliasOf brick:Air_Handling_Unit .


###  https://brickschema.org/schema/Brick#Ablutions_Room
brick:Ablutions_Room rdf:type owl:Class ;
                     rdfs:subClassOf brick:Room .


###  https://brickschema.org/schema/Brick#Absolute_Humidity_Sensor
brick:Absolute_Humidity_Sensor rdf:type owl:Class ;
                               rdfs:subClassOf brick:Humidity_Sensor .


###  https://brickschema.org/schema/Brick#Absorption_Chiller
brick:Absorption_Chiller rdf:type owl:Class ;
                         rdfs:subClassOf brick:Chiller .


###  https://brickschema.org/schema/Brick#Acceleration_Time_Setpoint
brick:Acceleration_Time_Setpoint rdf:type owl:Class ;
                                 rdfs:subClassOf brick:Time_Setpoint .


###  https://brickschema.org/schema/Brick#Access_Control_Equipment
brick:Access_Control_Equipment rdf:type owl:Class ;
                               rdfs:subClassOf brick:Security_Equipment .


###  https://brickschema.org/schema/Brick#Access_Reader
brick:Access_Reader rdf:type owl:Class ;
                    rdfs:subClassOf brick:Access_Control_Equipment .


###  https://brickschema.org/schema/Brick#Active_Chilled_Beam
brick:Active_Chilled_Beam rdf:type owl:Class ;
                          rdfs:subClassOf brick:Chilled_Beam .


###  https://brickschema.org/schema/Brick#Active_Power_Sensor
brick:Active_Power_Sensor rdf:type owl:Class ;
                          rdfs:subClassOf brick:Electric_Power_Sensor .


