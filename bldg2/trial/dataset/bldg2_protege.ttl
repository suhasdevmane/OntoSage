###  file:///C:/Users/suhas/Documents/GitHub/OntoBot/bldg2/trial/dataset/na99033713e994d3fac6c613af3f33cc0b3846
<file:///C:/Users/suhas/Documents/GitHub/OntoBot/bldg2/trial/dataset/na99033713e994d3fac6c613af3f33cc0b3846> rdf:type owl:NamedIndividual ,
                                                                                                                      sh:SPARQLRule ;
                                                                                                             sh:prefixes <https://brickschema.org/schema/1.3/Brick> ;
                                                                                                             sh:construct """
CONSTRUCT {
    ?val a ?shape .
} WHERE {
    $this rdfs:range ?shape .
    ?shape a sh:NodeShape .
    ?ent $this ?val .
}""" .


###  file:///C:/Users/suhas/Documents/GitHub/OntoBot/bldg2/trial/dataset/na99033713e994d3fac6c613af3f33cc0b3847
<file:///C:/Users/suhas/Documents/GitHub/OntoBot/bldg2/trial/dataset/na99033713e994d3fac6c613af3f33cc0b3847> rdf:type owl:NamedIndividual ,
                                                                                                                      sh:SPARQLRule ;
                                                                                                             sh:prefixes <https://brickschema.org/schema/1.3/Brick> ;
                                                                                                             sh:construct """
CONSTRUCT {
    ?s ?super ?o .
} WHERE {
    $this rdfs:subPropertyOf+ ?super .
    ?super a brick:EntityProperty .
    $this a brick:EntityProperty .
    ?s $this ?o .
}""" .


