###  file:///C:/Users/suhas/Documents/GitHub/OntoBot/bldg2/trial/dataset/na99033713e994d3fac6c613af3f33cc0b3164
<file:///C:/Users/suhas/Documents/GitHub/OntoBot/bldg2/trial/dataset/na99033713e994d3fac6c613af3f33cc0b3164> rdf:type owl:NamedIndividual ,
                                                                                                                      sh:PropertyShape ;
                                                                                                             sh:or bsh:NumericValue ;
                                                                                                             sh:path brick:value ;
                                                                                                             sh:maxCount 1 ;
