bsh:InferInverseProperties a sh:NodeShape ;
    sh:rule [ a sh:SPARQLRule ;
            sh:construct """
            CONSTRUCT {
$this ?invP ?o .
}
WHERE {
?o ?p $this .
?invP owl:inverseOf ?p .
}
			""" ;
            sh:prefixes <https://brickschema.org/schema/1.4/Brick> ],
        "na99033713e994d3fac6c613af3f33cc0b3604" ;
    sh:targetClass ns1:Concept,
        brick:Entity .

