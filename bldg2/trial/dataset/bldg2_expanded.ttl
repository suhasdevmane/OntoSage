        brick:Torque ;
    rdfs:subClassOf brick:Class,
        brick:Entity,
        brick:Point,
        brick:Sensor ;
    skos:definition "Measures torque, the tendency of a force to rotate an object about some axis"@en ;
    sh:property [ a sh:PropertyShape ;
            sh:class ns3:TorqueObservation ;
            sh:maxCount true,
                1 ;
            sh:name "last known value" ;
            sh:nodeKind sh:IRI ;
            sh:path brick:lastKnownValue ] ;
    sh:rule [ a sh:TripleRule ;
            sh:object tag:Point ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Sensor ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Torque ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        "na99033713e994d3fac6c613af3f33cc0b4737",
        "na99033713e994d3fac6c613af3f33cc0b4738",
        "na99033713e994d3fac6c613af3f33cc0b4739" ;
    brick:Relationship qudtqk:Torque,
        brick:Torque,
        tag:Point,
        tag:Sensor,
        tag:Torque ;
    brick:hasAssociatedTag tag:Point,
        tag:Sensor,
        tag:Torque ;
    brick:hasQuantity qudtqk:Torque,
        brick:Torque .

