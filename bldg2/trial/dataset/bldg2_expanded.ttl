brick:Active_Power a qudt:QuantityKind,
        skos:Concept,
        sosa:ObservableProperty,
        brick:Class,
        brick:Entity,
        brick:Measurable,
        brick:Quantity ;
    rdfs:label "Active Power"^^xsd:string ;
    qudt:applicableUnit unit:GigaW,
        unit:KiloW,
        unit:MegaW,
        unit:MicroW,
        unit:MilliW,
        unit:NanoW,
        unit:PicoW,
        unit:TeraW,
        unit:W ;
    owl:sameAs brick:Real_Power ;
    skos:broader brick:Electric_Power ;
    skos:definition "(Active Power) is, under periodic conditions, the mean value, taken over one period (T), of the instantaneous power (p). In complex notation, (P = Re \\; S), where (S) is (complex power)\"."@en ;
    brick:Relationship qudtqk:ActivePower ;
    brick:hasQUDTReference qudtqk:ActivePower .

brick:Adjust_Sensor a owl:Class,
        sh:NodeShape ;
    rdfs:label "Adjust Sensor"^^xsd:string,
        "Adjust Sensor"@en ;
    qudt:hasQuantityKind qudtqk:DimensionlessRatio ;
    rdfs:subClassOf brick:Class,
        brick:Entity,
        brick:Point,
        brick:Sensor ;
    skos:definition "Measures user-provided adjustment of some value"@en ;
    sh:property [ a sh:PropertyShape ;
            sh:class ns3:DoubleValueObservation ;
            sh:maxCount true,
                1 ;
            sh:name "last known value" ;
            sh:nodeKind sh:IRI ;
