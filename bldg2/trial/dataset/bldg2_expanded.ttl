        tag:Command,
        tag:Correlated,
        tag:Lighting,
        tag:Point,
        tag:Temperature ;
    brick:hasAssociatedTag tag:Color,
        tag:Command,
        tag:Correlated,
        tag:Lighting,
        tag:Point,
        tag:Temperature .

