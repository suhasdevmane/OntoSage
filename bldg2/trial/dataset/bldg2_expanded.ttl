brick:Cooling_Tower a owl:Class,
        sh:NodeShape ;
    rdfs:label "Cooling Tower"^^xsd:string,
        "Cooling Tower"@en ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Cooling_tower> ;
