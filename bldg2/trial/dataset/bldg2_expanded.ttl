<file:///c:/Users/suhas/Documents/GitHub/OntoBot/bldg2/na99033713e994d3fac6c613af3f33cc0b3165> a sh:SPARQLRule ;
    sh:construct """\r\r\r
        CONSTRUCT {\r\r\r
            $this rdf:type ?newtype .\r\r\r
        }\r\r\r
        WHERE {\r\r\r
            $this brick:meters ?bldg .\r\r\r
            ?bldg rdf:type/rdfs:subClassOf* brick:Building .\r\r\r
            $this rdf:type ?type .\r\r\r
            BIND(IRI(CONCAT("https://brickschema.org/schema/Brick#Building_", strafter(str(?type), "https://brickschema.org/schema/Brick#"))) as ?newtype) .\r\r\r
            FILTER (strEnds(str(?type), "_Meter"))\r\r\r
        }\r\r\r
        """^^xsd:string ;
    sh:prefixes <https://brickschema.org/schema/1.3/Brick> .

