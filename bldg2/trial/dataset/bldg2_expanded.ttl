<file:///c:/Users/suhas/Documents/GitHub/OntoBot/bldg2/na99033713e994d3fac6c613af3f33cc0b3214> a sh:SPARQLRule ;
    sh:construct """CONSTRUCT {\r\r\r
$this a ?newClass .\r\r\r
}\r\r\r
WHERE {\r\r\r
$this a ?class .\r\r\r
?class owl:deprecated true .\r\r\r
?class brick:isReplacedBy ?newClass .\r\r\r
FILTER NOT EXISTS {$this a ?newClass}\r\r\r
}"""^^xsd:string ;
    sh:message "Deprecated class is temporarily augmented by the new class"^^xsd:string,
        "Deprecated class is temporarily augmented by the new class" ;
    sh:prefixes <https://brickschema.org/schema/1.3/Brick> .

