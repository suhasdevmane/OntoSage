@prefix bacnet: <http://data.ashrae.org/bacnet/2020#> .
@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix bsh: <https://brickschema.org/schema/BrickShape#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <http://data.ashrae.org/standard223#> .
@prefix ns2: <http://schema.org/> .
@prefix ns3: <https://w3id.org/rec#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix qudtqk: <http://qudt.org/vocab/quantitykind/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ref: <https://brickschema.org/schema/Brick/ref#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix tag: <https://brickschema.org/schema/BrickTag#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ns3:AbsoluteHumidityObservation a <dtmi:dtdl:class:Component>,
        rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Absolute humidity observation"^^xsd:string ;
    qudt:hasQuantityKind qudtqk:AbsoluteHumidity ;
    rdfs:subClassOf rdfs:Resource,
        ns3:AbsoluteHumidityObservation,
        ns3:Event,
        ns3:ObservationEvent,
        ns3:PointEvent ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:double ;
            sh:maxCount true,
                1 ;
            sh:minCount true,
                1 ;
            sh:name "value"^^xsd:string,
                "value",
                "value"@en ;
            sh:path ns3:value ] .

ns3:AccelerationObservation a <dtmi:dtdl:class:Component>,
        rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Acceleration observation"^^xsd:string ;
    qudt:hasQuantityKind qudtqk:Acceleration ;
    rdfs:subClassOf rdfs:Resource,
        ns3:AccelerationObservation,
        ns3:Event,
        ns3:ObservationEvent,
        ns3:PointEvent ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:double ;
            sh:maxCount true,
                1 ;
            sh:minCount true,
                1 ;
            sh:name "value"^^xsd:string,
                "value",
                "value"@en ;
            sh:path ns3:value ] .

ns3:AccessControlZone a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Access control zone"^^xsd:string ;
    rdfs:subClassOf rdfs:Resource,
        ns3:AccessControlZone,
        ns3:Architecture,
        ns3:Space,
        ns3:Zone .

ns3:AccessPanel a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Access panel"^^xsd:string ;
    rdfs:subClassOf rdfs:Resource,
        ns3:AccessPanel,
        ns3:ArchitecturalAsset,
        ns3:Asset,
        ns3:BarrierAsset .

ns3:ActuationEvent a <dtmi:dtdl:class:Component>,
        rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Actuation event"^^xsd:string ;
    rdfs:subClassOf rdfs:Resource,
        ns3:ActuationEvent,
        ns3:Event,
        ns3:PointEvent ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:description "The command message/payload of this actuation event."^^xsd:string ;
            sh:maxCount true,
                1 ;
            sh:minCount true,
                1 ;
            sh:name "value"^^xsd:string,
                "value",
                "value"@en ;
            sh:path ns3:value ],
        [ a sh:PropertyShape ;
            sh:class brick:Point ;
            sh:description "The brick:Point(s) (e.g., brick:Commands, brick:Setpoints, or brick:Parameters) that the actuation will target/execute."^^xsd:string ;
            sh:minCount true,
                1 ;
            sh:name "target point"^^xsd:string ;
            sh:nodeKind sh:IRI ;
            sh:path ns3:targetPoint ] .

ns3:AdmittingRoom a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Admitting room"^^xsd:string ;
    rdfs:subClassOf rdfs:Resource,
        ns3:AdmittingRoom,
        ns3:Architecture,
        ns3:HealthcareRoom,
        ns3:Room,
        ns3:Space .

ns3:Agent a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Agent"^^xsd:string ;
    rdfs:comment "The human, group, or machine that consumes or acts upon an object or data. This higher-level grouping allows properties that are shared among its subclasses (Person, Organization, ....) to be anchored in one joint place, on the Agent class."^^xsd:string ;
    rdfs:subClassOf rdfs:Resource,
        ns3:Agent ;
    sh:property [ a sh:PropertyShape ;
            sh:class ns3:Organization ;
            sh:description "Indicates membership in an organization. Note that componency (e.g., departments of a corporation) are expressed using the more generic Organization.isPartOf property."^^xsd:string ;
            sh:name "is member of"^^xsd:string ;
            sh:nodeKind sh:IRI ;
            sh:path ns3:isMemberOf ],
        [ a sh:PropertyShape ;
            sh:description "Indicates ownership of some thing, e.g., a building, an asset, an organization, etc."^^xsd:string ;
            sh:name "owns"^^xsd:string,
                "owns"@en ;
            sh:nodeKind sh:IRI ;
            sh:path ns3:owns ] .

ns3:AlarmObject a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Alarm object"^^xsd:string ;
    rdfs:subClassOf rdfs:Resource,
        ns3:AlarmObject,
        ns3:Information,
        ns3:ServiceObject .

ns3:AngleObservation a <dtmi:dtdl:class:Component>,
        rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Angle observation"^^xsd:string ;
    qudt:hasQuantityKind qudtqk:Angle ;
    rdfs:subClassOf rdfs:Resource,
        ns3:AngleObservation,
        ns3:Event,
        ns3:ObservationEvent,
        ns3:PointEvent ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:double ;
            sh:maxCount true,
                1 ;
            sh:minCount true,
                1 ;
            sh:name "value"^^xsd:string,
                "value",
                "value"@en ;
            sh:path ns3:value ] .

ns3:AngularAccelerationObservation a <dtmi:dtdl:class:Component>,
        rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Angular acceleration observation"^^xsd:string ;
    qudt:hasQuantityKind qudtqk:AngularAcceleration ;
    rdfs:subClassOf rdfs:Resource,
        ns3:AngularAccelerationObservation,
        ns3:Event,
        ns3:ObservationEvent,
        ns3:PointEvent ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:double ;
            sh:maxCount true,
                1 ;
            sh:minCount true,
                1 ;
            sh:name "value"^^xsd:string,
                "value",
                "value"@en ;
            sh:path ns3:value ] .

ns3:AngularVelocityObservation a <dtmi:dtdl:class:Component>,
        rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Angular velocity observation"^^xsd:string ;
    qudt:hasQuantityKind qudtqk:AngularVelocity ;
    rdfs:subClassOf rdfs:Resource,
        ns3:AngularVelocityObservation,
        ns3:Event,
        ns3:ObservationEvent,
        ns3:PointEvent ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:double ;
            sh:maxCount true,
                1 ;
            sh:minCount true,
                1 ;
            sh:name "value"^^xsd:string,
                "value",
                "value"@en ;
            sh:path ns3:value ] .

ns3:Apartment a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Apartment"^^xsd:string ;
    rdfs:subClassOf rdfs:Resource,
        ns3:Apartment,
        ns3:Collection ;
    sh:property [ a sh:PropertyShape ;
            sh:class ns3:Room ;
            sh:minCount true,
                1 ;
            sh:name "includes"^^xsd:string,
                "includes",
                "includes"@en ;
            sh:nodeKind sh:IRI ;
            sh:path ns3:includes ] .

ns3:ArchitecturalAsset a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Architectural asset"^^xsd:string ;
    rdfs:subClassOf rdfs:Resource,
        ns3:ArchitecturalAsset,
        ns3:Asset .

ns3:Architecture a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Architecture"^^xsd:string ;
    rdfs:comment "A designed/landscaped (or potentially designed/landscaped) part of the physical world that has a 3D spatial extent. E.g., a building site, a building, levels within the building, rooms, etc."^^xsd:string ;
    rdfs:subClassOf rdfs:Resource,
        ns3:Architecture,
        ns3:Space ;
    sh:property [ a sh:PropertyShape ;
            sh:class ns3:BuildingElement ;
            sh:description "Links an Architecture to BuildingElement that is contained in the Space."^^xsd:string ;
            sh:name "contains element"^^xsd:string ;
            sh:nodeKind sh:IRI ;
            sh:path ns3:containsElement ],
        [ a sh:PropertyShape ;
            sh:class ns3:Agent ;
            sh:name "operated by"^^xsd:string ;
            sh:nodeKind sh:IRI ;
            sh:path ns3:operatedBy ],
        [ a sh:PropertyShape ;
            sh:class ns3:BuildingElement ;
            sh:name "adjacent element"^^xsd:string ;
            sh:nodeKind sh:IRI ;
            sh:path ns3:adjacentElement ],
        [ a sh:PropertyShape ;
            sh:class ns3:ArchitectureCapacity ;
            sh:maxCount true,
                1 ;
            sh:name "capacity"^^xsd:string,
                "capacity"@en ;
            sh:nodeKind sh:IRI ;
            sh:path ns3:capacity ],
        [ a sh:PropertyShape ;
            sh:class ns3:Agent ;
            sh:name "owned by"^^xsd:string ;
            sh:nodeKind sh:IRI ;
            sh:path ns3:ownedBy ],
        [ a sh:PropertyShape ;
            sh:class brick:Point ;
            sh:name "has point"^^xsd:string ;
            sh:nodeKind sh:IRI ;
            sh:path ns3:hasPoint ],
        [ a sh:PropertyShape ;
            sh:class ns3:BuildingElement ;
            sh:name "intersecting element"^^xsd:string ;
            sh:nodeKind sh:IRI ;
            sh:path ns3:intersectingElement ],
        [ a sh:PropertyShape ;
            sh:name "is fed by"^^xsd:string,
                "is fed by" ;
            sh:nodeKind sh:IRI ;
            sh:path ns3:isFedBy ],
        [ a sh:PropertyShape ;
            sh:class ns3:Agent ;
            sh:nodeKind sh:IRI ;
            sh:path ns3:constructedBy ],
        [ a sh:PropertyShape ;
            sh:class ns3:PostalAddress ;
            sh:description "Physical address of the architecture (site, building, sub-building, entrance room, etc.) in question."^^xsd:string ;
            sh:name "address"^^xsd:string,
                "address"@en ;
            sh:nodeKind sh:IRI ;
            sh:path ns3:address ],
        [ a sh:PropertyShape ;
            sh:class ns3:Document ;
            sh:name "documentation"^^xsd:string,
                "documentation"@en ;
            sh:nodeKind sh:IRI ;
            sh:path ns3:documentation ],
        [ a sh:PropertyShape ;
            sh:class ns3:Agent ;
            sh:name "architected by"^^xsd:string ;
            sh:nodeKind sh:IRI ;
            sh:path ns3:architectedBy ],
        [ a sh:PropertyShape ;
            sh:class ns3:ArchitectureArea ;
            sh:maxCount true,
                1 ;
            sh:name "area"^^xsd:string,
                "area"@en ;
            sh:nodeKind sh:IRI ;
            sh:path ns3:area ] .

ns3:ArchitectureArea a <dtmi:dtdl:class:Component>,
        rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Architecture area"^^xsd:string ;
    rdfs:comment "Describes business-relevant area measurements typically associated with architected spaces. As the exact requirements on these measurements will vary from case to case or jurisdiction to jurisdiction, subclassing and specializing this definition is encouraged."^^xsd:string ;
    rdfs:subClassOf rdfs:Resource,
        ns3:ArchitectureArea,
        ns3:Information ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:float ;
            sh:maxCount true,
                1 ;
            sh:name "gross area"^^xsd:string ;
            sh:path ns3:grossArea ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:float ;
            sh:maxCount true,
                1 ;
            sh:name "net area"^^xsd:string ;
            sh:path ns3:netArea ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:float ;
            sh:maxCount true,
                1 ;
            sh:name "rentable area"^^xsd:string ;
            sh:path ns3:rentableArea ] .

ns3:ArchitectureCapacity a <dtmi:dtdl:class:Component>,
        rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Architecture capacity"^^xsd:string ;
    rdfs:comment "Describes business-relevant capacity measurements typically associated with architected spaces. As the exact requirements on these measurements will vary from case to case or jurisdiction to jurisdiction, subclassing and specializing this definition is encouraged."^^xsd:string ;
    rdfs:subClassOf rdfs:Resource,
        ns3:ArchitectureCapacity,
        ns3:Information ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:description "E.g., per Building Code"^^xsd:string ;
            sh:maxCount true,
                1 ;
            sh:name "maximum occupancy"^^xsd:string ;
            sh:path ns3:maxOccupancy ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount true,
                1 ;
            sh:name "seating capacity"^^xsd:string ;
            sh:path ns3:seatingCapacity ] .

ns3:AreaObservation a <dtmi:dtdl:class:Component>,
        rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Area observation"^^xsd:string ;
    qudt:hasQuantityKind qudtqk:Area ;
    rdfs:subClassOf rdfs:Resource,
        ns3:AreaObservation,
        ns3:Event,
        ns3:ObservationEvent,
        ns3:PointEvent ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:double ;
            sh:maxCount true,
                1 ;
            sh:minCount true,
                1 ;
            sh:name "value"^^xsd:string,
                "value",
                "value"@en ;
            sh:path ns3:value ] .

ns3:Asset a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Asset"^^xsd:string ;
    rdfs:comment "Something which is placed inside of a building, but is not an integral part of that building's structure; e.g., furniture, equipment, systems, etc."^^xsd:string ;
    rdfs:subClassOf rdfs:Resource,
        ns3:Asset ;
    sh:property [ a sh:PropertyShape ;
            sh:class ns3:Agent ;
            sh:name "installed by"^^xsd:string ;
            sh:nodeKind sh:IRI ;
            sh:path ns3:installedBy ],
        [ a sh:PropertyShape ;
            sh:class ns3:Space ;
            sh:name "located in"^^xsd:string ;
            sh:nodeKind sh:IRI ;
            sh:path ns3:locatedIn ],
        [ a sh:PropertyShape ;
            sh:class brick:Point ;
            sh:name "has point"^^xsd:string ;
            sh:nodeKind sh:IRI ;
            sh:path ns3:hasPoint ],
        [ a sh:PropertyShape ;
            sh:class ns3:Asset ;
            sh:name "is part of"^^xsd:string ;
            sh:nodeKind sh:IRI ;
            sh:path ns3:isPartOf ],
        [ a sh:PropertyShape ;
            sh:class ns3:Agent ;
            sh:name "commissioned by"^^xsd:string ;
            sh:nodeKind sh:IRI ;
            sh:path ns3:commissionedBy ],
        [ a sh:PropertyShape ;
            sh:class ns3:Agent ;
            sh:name "manufactured by"^^xsd:string ;
            sh:nodeKind sh:IRI ;
            sh:path ns3:manufacturedBy ],
        [ a sh:PropertyShape ;
            sh:class ns3:Agent ;
            sh:name "serviced by"^^xsd:string ;
            sh:nodeKind sh:IRI ;
            sh:path ns3:servicedBy ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:date ;
            sh:maxCount true,
                1 ;
            sh:name "turnover date"^^xsd:string ;
            sh:path ns3:turnoverDate ],
        [ a sh:PropertyShape ;
            sh:class ns3:Document ;
            sh:name "documentation"^^xsd:string,
                "documentation"@en ;
            sh:nodeKind sh:IRI ;
            sh:path ns3:documentation ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:name "asset tag"^^xsd:string ;
            sh:path ns3:assetTag ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:name "model number"^^xsd:string ;
            sh:path ns3:modelNumber ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:date ;
            sh:maxCount true,
                1 ;
            sh:name "commissioning date"^^xsd:string ;
            sh:path ns3:commissioningDate ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:name "serial number"^^xsd:string ;
            sh:path ns3:serialNumber ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:name "IP address"^^xsd:string ;
            sh:path ns3:IPAddress ],
        [ a sh:PropertyShape ;
            sh:class ns3:BuildingElement ;
            sh:description "An asset may be mounted on some part of the building construction (e.g., a blind on a facade, a camera on a wall, etc)."^^xsd:string ;
            sh:maxCount true,
                1 ;
            sh:name "mounted on"^^xsd:string ;
            sh:nodeKind sh:IRI ;
            sh:path ns3:mountedOn ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:decimal ;
            sh:maxCount true,
                1 ;
            sh:name "weight"^^xsd:string,
                "weight"@en ;
            sh:path ns3:weight ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:name "MAC address"^^xsd:string ;
            sh:path ns3:MACAddress ],
        [ a sh:PropertyShape ;
            sh:class ns3:Asset ;
            sh:name "has part"^^xsd:string ;
            sh:nodeKind sh:IRI ;
            sh:path ns3:hasPart ],
        [ a sh:PropertyShape ;
            sh:class ns3:Geometry ;
            sh:description "A GeoJSON Geometry representing the position or extent of the asset."^^xsd:string ;
            sh:maxCount true,
                1 ;
            sh:name "geometry"^^xsd:string ;
            sh:path ns3:geometry ],
        [ a sh:PropertyShape ;
            sh:maxCount true,
                1 ;
            sh:name "initial cost"^^xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:path ns3:initialCost ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:date ;
            sh:maxCount true,
                1 ;
            sh:name "installation date"^^xsd:string ;
            sh:path ns3:installationDate ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:duration ;
            sh:name "maintenance interval"^^xsd:string ;
            sh:path ns3:maintenanceInterval ] .

ns3:Atrium a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Atrium"^^xsd:string,
        "Atrium"@en ;
    rdfs:subClassOf rdfs:Resource,
        ns3:Architecture,
        ns3:Atrium,
        ns3:Room,
        ns3:Space .

ns3:AudioVisualEquipment a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Audio Visual Equipment"^^xsd:string,
        "Audio Visual Equipment"@en ;
    rdfs:comment "Audio visual equipment."^^xsd:string ;
    rdfs:subClassOf rdfs:Resource,
        brick:Class,
        brick:Entity,
        brick:Equipment,
        ns3:Asset,
        ns3:AudioVisualEquipment,
        ns3:ICTEquipment ;
    owl:deprecated true,
        1 ;
    brick:Relationship brick:Audio_Visual_Equipment ;
    brick:deprecatedInVersion "1.4.0" ;
    brick:deprecationMitigationMessage "REC ICT classes are being phased out in favor of Brick classes. For a replacement, consider brick:Audio_Visual_Equipment" ;
    brick:isReplacedBy brick:Audio_Visual_Equipment .

