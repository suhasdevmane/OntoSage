<file:///c:/Users/suhas/Documents/GitHub/OntoBot/bldg2/na99033713e994d3fac6c613af3f33cc0b4057> a sh:SPARQLConstraint ;
    sh:message "Only Brick Points can have external timeseries references"^^xsd:string,
        "Only Brick Points can have external timeseries references" ;
    sh:prefixes <https://brickschema.org/schema/1.3/Brick> ;
    sh:select """\r\r\r
            SELECT $this\r\r\r
