        "na99033713e994d3fac6c613af3f33cc0b627" ;
    brick:Relationship tag:Disconnect,
        tag:Equipment,
        tag:Switch ;
    brick:aliasOf brick:Isolation_Switch ;
    brick:hasAssociatedTag tag:Disconnect,
        tag:Equipment,
        tag:Switch .

