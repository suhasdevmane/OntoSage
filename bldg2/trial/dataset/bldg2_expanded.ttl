            sh:minInclusive 0 ;
            sh:or bsh:NumericValue ;
            sh:path brick:value ],
        [ a sh:PropertyShape ;
            sh:in ( unit:MilliRAD unit:MIN_Angle unit:GRAD unit:REV unit:MilliARCSEC unit:ARCSEC unit:ARCMIN unit:GON unit:DEG unit:RAD unit:MIL unit:2PiRAD unit:MicroRAD ) ;
            sh:maxCount true,
                1 ;
            sh:minCount true,
                1 ;
            sh:path brick:hasUnit ],
