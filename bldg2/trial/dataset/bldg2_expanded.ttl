<file:///c:/Users/suhas/Documents/GitHub/OntoBot/bldg2/na99033713e994d3fac6c613af3f33cc0b3699> a sh:SPARQLRule ;
    sh:construct """\r\r\r
        CONSTRUCT {\r\r\r
            $this rdf:type ?metertype .\r\r\r
        } WHERE {\r\r\r
            $this rdf:type/rdfs:subClassOf* brick:Building_Meter .\r\r\r
            $this brick:hasSubstance ?substance .\r\r\r
            ?metertype brick:hasSubstance ?substance .\r\r\r
            ?metertype rdfs:subClassOf+ brick:Building_Meter .\r\r\r
        }\r\r\r
        """^^xsd:string ;
    sh:prefixes <https://brickschema.org/schema/1.3/Brick> .

