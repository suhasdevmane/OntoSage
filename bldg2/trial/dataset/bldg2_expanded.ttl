ns3:BooleanValueObservation a <dtmi:dtdl:class:Component>,
        rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Boolean value observation"^^xsd:string ;
    rdfs:comment "Generic xsd:boolean value observation that is not specific to any particular QUDT quantitykind or unit."^^xsd:string ;
    rdfs:subClassOf rdfs:Resource,
        ns3:BooleanValueObservation,
        ns3:Event,
        ns3:ObservationEvent,
        ns3:PointEvent ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:boolean ;
            sh:maxCount true,
                1 ;
            sh:minCount true,
                1 ;
            sh:name "value"^^xsd:string,
                "value",
                "value"@en ;
            sh:path ns3:value ] .

ns3:Building a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Building"^^xsd:string,
        "Building"@en ;
    rdfs:comment "A confined building structure."^^xsd:string ;
    rdfs:subClassOf rdfs:Resource,
        ns3:Architecture,
        ns3:Building,
        ns3:Space .

ns3:BuildingElement a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Building element"^^xsd:string ;
    rdfs:comment "A part that constitutes a piece of a building's structural makeup. E.g., Facade, Wall, Slab, Roof, etc."^^xsd:string ;
    rdfs:subClassOf rdfs:Resource,
        ns3:BuildingElement ;
    sh:property [ a sh:PropertyShape ;
            sh:class ns3:BuildingElement ;
            sh:name "has part"^^xsd:string ;
            sh:nodeKind sh:IRI ;
            sh:path ns3:hasPart ],
        [ a sh:PropertyShape ;
            sh:class ns3:BuildingElement ;
            sh:maxCount true,
                1 ;
            sh:name "is part of"^^xsd:string ;
            sh:nodeKind sh:IRI ;
            sh:path ns3:isPartOf ],
        [ a sh:PropertyShape ;
            sh:class ns3:Architecture ;
            sh:description "Indicates the architected space (site, building, level, room...) in which this building element is placed."^^xsd:string ;
            sh:maxCount true,
                1 ;
            sh:name "located in"^^xsd:string ;
            sh:nodeKind sh:IRI ;
            sh:path ns3:locatedIn ],
        [ a sh:PropertyShape ;
            sh:class ns3:Document ;
            sh:name "documentation"^^xsd:string,
                "documentation"@en ;
            sh:nodeKind sh:IRI ;
            sh:path ns3:documentation ] .

