        "na99033713e994d3fac6c613af3f33cc0b454",
        "na99033713e994d3fac6c613af3f33cc0b455" ;
    brick:Relationship tag:Cool,
        tag:Equipment,
        tag:Tower ;
    brick:hasAssociatedTag tag:Cool,
        tag:Equipment,
        tag:Tower .

