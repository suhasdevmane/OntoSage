brick:Air_Differential_Pressure_Setpoint a owl:Class,
        sh:NodeShape ;
    rdfs:label "Air Differential Pressure Setpoint"^^xsd:string,
        "Air Differential Pressure Setpoint"@en ;
    qudt:hasQuantityKind brick:Differential_Pressure ;
    rdfs:subClassOf brick:Class,
        brick:Differential_Pressure_Setpoint,
        brick:Differential_Setpoint,
        brick:Entity,
        brick:Point,
        brick:Setpoint ;
    skos:definition "Sets the target air differential pressure between an upstream and downstream point in a air duct or conduit"@en ;
