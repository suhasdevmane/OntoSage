brick:Direction_Status a owl:Class,
        sh:NodeShape ;
    rdfs:label "Direction Status"^^xsd:string,
        "Direction Status"@en ;
    qudt:hasQuantityKind brick:Direction ;
    rdfs:subClassOf brick:Class,
        brick:Entity,
        brick:Point,
        brick:Status ;
    skos:definition "Indicates which direction a device is operating in"@en ;
    sh:rule [ a sh:TripleRule ;
            sh:object tag:Direction ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Point ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Status ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        "na99033713e994d3fac6c613af3f33cc0b4268",
        "na99033713e994d3fac6c613af3f33cc0b4269",
        "na99033713e994d3fac6c613af3f33cc0b4270" ;
    brick:Relationship brick:Direction,
        tag:Direction,
        tag:Point,
        tag:Status ;
    brick:hasAssociatedTag tag:Direction,
        tag:Point,
        tag:Status ;
    brick:hasQuantity brick:Direction .

