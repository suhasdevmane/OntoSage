            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Differential ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Point ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Pressure ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Setpoint ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        "na99033713e994d3fac6c613af3f33cc0b5911",
        "na99033713e994d3fac6c613af3f33cc0b5912",
        "na99033713e994d3fac6c613af3f33cc0b5913",
        "na99033713e994d3fac6c613af3f33cc0b5914",
        "na99033713e994d3fac6c613af3f33cc0b5915" ;
    brick:Relationship brick:Air,
        brick:Differential_Pressure,
        tag:Air,
        tag:Differential,
        tag:Point,
        tag:Pressure,
        tag:Setpoint ;
    brick:hasAssociatedTag tag:Air,
        tag:Differential,
        tag:Point,
        tag:Pressure,
        tag:Setpoint ;
    brick:hasQuantity brick:Differential_Pressure ;
    brick:hasSubstance brick:Air .

