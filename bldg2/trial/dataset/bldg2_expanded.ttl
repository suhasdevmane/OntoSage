<file:///c:/Users/suhas/Documents/GitHub/OntoBot/bldg2/na99033713e994d3fac6c613af3f33cc0b4127> a sh:SPARQLConstraint ;
    sh:message "Only meters can have the isVirtualMeter property be true"^^xsd:string,
        "Only meters can have the isVirtualMeter property be true" ;
    sh:prefixes <https://brickschema.org/schema/1.3/Brick> ;
    sh:select """\r\r\r
            SELECT $this WHERE {\r\r\r
                $this brick:isVirtualMeter/brick:value true .\r\r\r
                FILTER NOT EXISTS { $this rdf:type/rdfs:subClassOf* brick:Meter } .\r\r\r
            }\r\r\r
        """^^xsd:string .

