        """^^xsd:string ;
    sh:prefixes <https://brickschema.org/schema/1.3/Brick> .

<file:///c:/Users/suhas/Documents/GitHub/OntoBot/bldg2/na99033713e994d3fac6c613af3f33cc0b3222> a sh:SPARQLConstraint ;
    sh:message "{$this} has type {?class} which was deprecated in version {?depver}. For now, it has been updated to also be of type {?newClass}."^^xsd:string,
        "{$this} has type {?class} which was deprecated in version {?depver}. For now, it has been updated to also be of type {?newClass}." ;
    sh:prefixes <https://brickschema.org/schema/1.3/Brick> ;
    sh:select """SELECT $this ?class ?newClass ?depver WHERE {\r\r\r
$this a ?class .\r\r\r
?class owl:deprecated true .\r\r\r
?class brick:deprecatedInVersion ?depver .\r\r\r
?class brick:isReplacedBy ?newClass .\r\r\r
}"""^^xsd:string .

