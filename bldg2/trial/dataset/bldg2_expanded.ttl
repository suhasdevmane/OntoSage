brick:Pump a owl:Class,
        sh:NodeShape ;
    rdfs:label "Pump"^^xsd:string,
        "Pump"@en ;
    rdfs:subClassOf rdfs:Resource,
        brick:Class,
        brick:Entity,
        brick:Equipment,
        brick:HVAC_Equipment,
        ns3:Asset ;
    skos:definition "Machine for imparting energy to a fluid, causing it to do work, drawing a fluid into itself through an entrance port, and forcing the fluid out through an exhaust port."@en ;
    sh:rule [ a sh:TripleRule ;
            sh:object tag:Equipment ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Pump ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        "na99033713e994d3fac6c613af3f33cc0b4650",
        "na99033713e994d3fac6c613af3f33cc0b4651" ;
    brick:Relationship tag:Equipment,
        tag:Pump ;
    brick:hasAssociatedTag tag:Equipment,
        tag:Pump .

brick:Usage_Sensor a owl:Class,
        sh:NodeShape ;
    rdfs:label "Usage Sensor"^^xsd:string,
        "Usage Sensor"@en ;
    qudt:hasQuantityKind qudtqk:Dimensionless ;
    rdfs:subClassOf brick:Class,
        brick:Entity,
        brick:Point,
        brick:Sensor ;
    skos:definition "Measures the amount of some substance that is consumed or used, over some period of time"@en ;
    sh:property [ a sh:PropertyShape ;
            sh:class ns3:DoubleValueObservation ;
            sh:maxCount true,
                1 ;
            sh:name "last known value" ;
            sh:nodeKind sh:IRI ;
            sh:path brick:lastKnownValue ] ;
    sh:rule [ a sh:TripleRule ;
            sh:object tag:Point ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Sensor ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Usage ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        "na99033713e994d3fac6c613af3f33cc0b6410",
        "na99033713e994d3fac6c613af3f33cc0b6411",
        "na99033713e994d3fac6c613af3f33cc0b6412" ;
    brick:Relationship qudtqk:Dimensionless,
        tag:Point,
        tag:Sensor,
        tag:Usage ;
    brick:hasAssociatedTag tag:Point,
        tag:Sensor,
        tag:Usage ;
    brick:hasQuantity qudtqk:Dimensionless .

