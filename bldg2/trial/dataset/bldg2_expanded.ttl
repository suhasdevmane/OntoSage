brick:Ablutions_Room a owl:Class,
        sh:NodeShape ;
    rdfs:label "Ablutions Room"^^xsd:string,
        "Ablutions Room"@en ;
    rdfs:subClassOf rdfs:Resource,
        brick:Class,
        brick:Entity,
        brick:Location,
        brick:Room,
        brick:Space,
        ns3:Space ;
    owl:deprecated true,
        1 ;
    skos:definition "A room for performing cleansing rituals before prayer"@en ;
    sh:rule [ a sh:TripleRule ;
            sh:object tag:Ablutions ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Location ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Room ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Space ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        "na99033713e994d3fac6c613af3f33cc0b1",
        "na99033713e994d3fac6c613af3f33cc0b2",
        "na99033713e994d3fac6c613af3f33cc0b3",
        "na99033713e994d3fac6c613af3f33cc0b4" ;
    brick:Relationship tag:Ablutions,
        tag:Location,
        tag:Room,
        tag:Space,
        ns3:Room ;
    brick:deprecatedInVersion "1.4.0" ;
    brick:deprecationMitigationMessage "Brick location classes are being phased out in favor of RealEstateCore classes. There is not yet a replacement in REC for Ablutions_Room" ;
    brick:hasAssociatedTag tag:Ablutions,
        tag:Location,
        tag:Room,
        tag:Space ;
    brick:isReplacedBy ns3:Room .

brick:Absorption_Chiller a owl:Class,
        sh:NodeShape ;
    rdfs:label "Absorption Chiller"^^xsd:string,
        "Absorption Chiller"@en ;
    rdfs:subClassOf rdfs:Resource,
        brick:Chiller,
        brick:Class,
        brick:Entity,
        brick:Equipment,
        brick:HVAC_Equipment,
        ns3:Asset ;
    skos:definition "A chiller that utilizes a thermal or/and chemical process to produce the refrigeration effect necessary to provide chilled water. There is no mechanical compression of the refrigerant taking place within the machine, as occurs within more traditional vapor compression type chillers."@en ;
    sh:rule [ a sh:TripleRule ;
            sh:object tag:Absorption ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Chiller ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Equipment ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        "na99033713e994d3fac6c613af3f33cc0b10",
        "na99033713e994d3fac6c613af3f33cc0b11",
        "na99033713e994d3fac6c613af3f33cc0b12" ;
    brick:Relationship tag:Absorption,
        tag:Chiller,
        tag:Equipment ;
    brick:hasAssociatedTag tag:Absorption,
        tag:Chiller,
        tag:Equipment .

