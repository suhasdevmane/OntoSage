            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Zone ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:Relationship qudtqk:Temperature,
        tag:Air,
        tag:Occupied,
        tag:Point,
        tag:Setpoint,
        tag:Target,
        tag:Temperature,
        tag:Zone ;
