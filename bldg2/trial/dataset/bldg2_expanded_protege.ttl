                             sh:rule [ rdf:type sh:TripleRule ;
                                       sh:object tag:Code ;
                                       sh:predicate brick:hasTag ;
                                       sh:subject sh:this
                                     ] ,
                                     [ rdf:type sh:TripleRule ;
                                       sh:object tag:Fault ;
                                       sh:predicate brick:hasTag ;
                                       sh:subject sh:this
                                     ] ,
                                     [ rdf:type sh:TripleRule ;
                                       sh:object tag:Last ;
                                       sh:predicate brick:hasTag ;
                                       sh:subject sh:this
                                     ] ,
                                     [ rdf:type sh:TripleRule ;
                                       sh:object tag:Point ;
                                       sh:predicate brick:hasTag ;
                                       sh:subject sh:this
                                     ] ,
                                     [ rdf:type sh:TripleRule ;
                                       sh:object tag:Status ;
                                       sh:predicate brick:hasTag ;
                                       sh:subject sh:this
                                     ] ;
                             brick:Relationship tag:Code ,
                                                tag:Fault ,
                                                tag:Last ,
                                                tag:Point ,
                                                tag:Status ;
                             brick:hasAssociatedTag tag:Code ,
                                                    tag:Fault ,
                                                    tag:Last ,
                                                    tag:Point ,
                                                    tag:Status .


