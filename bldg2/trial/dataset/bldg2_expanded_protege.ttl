                      sh:rule [ rdf:type sh:TripleRule ;
                                sh:object tag:Box ;
                                sh:predicate brick:hasTag ;
                                sh:subject sh:this
                              ] ,
                              [ rdf:type sh:TripleRule ;
                                sh:object tag:Hospitality ;
                                sh:predicate brick:hasTag ;
                                sh:subject sh:this
                              ] ,
                              [ rdf:type sh:TripleRule ;
                                sh:object tag:Location ;
                                sh:predicate brick:hasTag ;
                                sh:subject sh:this
                              ] ,
                              [ rdf:type sh:TripleRule ;
                                sh:object tag:Room ;
                                sh:predicate brick:hasTag ;
                                sh:subject sh:this
                              ] ,
                              [ rdf:type sh:TripleRule ;
                                sh:object tag:Space ;
                                sh:predicate brick:hasTag ;
                                sh:subject sh:this
                              ] ;
                      brick:Relationship tag:Box ,
                                         tag:Hospitality ,
                                         tag:Location ,
                                         tag:Room ,
                                         tag:Space ,
                                         ns3:Room ;
                      brick:hasAssociatedTag tag:Box ,
                                             tag:Hospitality ,
                                             tag:Location ,
                                             tag:Room ,
                                             tag:Space ;
                      brick:isReplacedBy ns3:Room ;
                      brick:deprecatedInVersion "1.4.1" ;
                      brick:deprecationMitigationMessage "Brick location classes are being phased out in favor of RealEstateCore classes. There is not yet a replacement in REC for Hospitality_Box" .


