                                         unit:KiloCAL_Mean ,
                                         unit:KiloCAL_TH ,
                                         unit:KiloJ ,
                                         unit:MegaJ ,
                                         unit:N-M ,
                                         unit:THM_EEC ,
                                         unit:THM_US ,
                                         unit:TON_FG-HR ;
                     skos:broader brick:Energy ;
