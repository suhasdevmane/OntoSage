###  https://brickschema.org/schema/BrickShape#DeprecationInferenceForInstancesRule
bsh:DeprecationInferenceForInstancesRule rdf:type sh:NodeShape ;
                                         sh:rule _:genid6520 ;
                                         sh:targetClass brick:Entity ;
                                         sh:rule "na99033713e994d3fac6c613af3f33cc0b3214" .

_:genid6520 rdf:type sh:SPARQLRule ;
             sh:prefixes <https://brickschema.org/schema/1.4/Brick> ;
             sh:construct """CONSTRUCT {
$this a ?newClass .
}
WHERE {
$this a ?class .
?class owl:deprecated true .
?class brick:isReplacedBy ?newClass .
FILTER NOT EXISTS {$this a ?newClass}
}""" ;
             sh:message "Deprecated class is temporarily augmented by the new class" .


