###  file:///c:/Users/suhas/Documents/GitHub/OntoBot/bldg2/na99033713e994d3fac6c613af3f33cc0b3214
<file:///c:/Users/suhas/Documents/GitHub/OntoBot/bldg2/na99033713e994d3fac6c613af3f33cc0b3214> rdf:type owl:NamedIndividual ,
                                                                                                        sh:SPARQLRule ;
                                                                                               sh:prefixes <https://brickschema.org/schema/1.3/Brick> ;
                                                                                               sh:construct """CONSTRUCT {
$this a ?newClass .
}
WHERE {
$this a ?class .
?class owl:deprecated true .
?class brick:isReplacedBy ?newClass .
FILTER NOT EXISTS {$this a ?newClass}
}""" ;
                                                                                               sh:message "Deprecated class is temporarily augmented by the new class" .


