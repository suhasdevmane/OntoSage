###  file:///c:/Users/suhas/Documents/GitHub/OntoBot/bldg2/na99033713e994d3fac6c613af3f33cc0b3714
<file:///c:/Users/suhas/Documents/GitHub/OntoBot/bldg2/na99033713e994d3fac6c613af3f33cc0b3714> rdf:type owl:NamedIndividual ,
                                                                                                        sh:SPARQLRule ;
                                                                                               sh:prefixes <https://brickschema.org/schema/1.3/Brick> ;
                                                                                               sh:construct """
CONSTRUCT {
    ?s a ?t2 .
} WHERE {
    ?s a $this .
    { ?t2 owl:equivalentClass $this }
    UNION
    { $this owl:equivalentClass ?t2 }
}""" .


