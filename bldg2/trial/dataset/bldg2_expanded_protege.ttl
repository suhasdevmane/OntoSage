###  https://brickschema.org/schema/BrickShape#CollectionIncludesEquipment
bsh:CollectionIncludesEquipment rdf:type owl:NamedIndividual ,
                                         sh:NodeShape ;
                                sh:rule _:genid6503 ;
                                sh:targetClass brick:Collection ,
                                               brick:Equipment ,
                                               brick:System .

_:genid6503 rdf:type sh:SPARQLRule ;
             sh:prefixes <https://brickschema.org/schema/1.4/Brick> ;
             sh:construct """
        CONSTRUCT {
            $this rec:includes ?eq .
        }
        WHERE {
            $this brick:hasPart ?eq .
            {
                ?eq rdf:type/rdfs:subClassOf* brick:Equipment .
            }
            UNION
            {
                ?eq rdf:type/rdfs:subClassOf* brick:Collection .
            }
            UNION
            {
                ?eq rdf:type/rdfs:subClassOf* brick:System .
            }
        }
        """ .


