###  https://brickschema.org/schema/BrickShape#RDFSRangeRule
bsh:RDFSRangeRule rdf:type sh:NodeShape ;
                  sh:rule _:genid6648 ;
                  sh:targetSubjectsOf rdfs:range ;
                  sh:rule "na99033713e994d3fac6c613af3f33cc0b3846" .

_:genid6648 rdf:type sh:SPARQLRule ;
             sh:prefixes <https://brickschema.org/schema/1.4/Brick> ;
             sh:construct """
CONSTRUCT {
    ?val a ?shape .
} WHERE {
    $this rdfs:range ?shape .
    ?shape a sh:NodeShape .
    ?ent $this ?val .
    FILTER NOT EXISTS { ?val a ?shape }
}""" .


###  https://brickschema.org/schema/BrickShape#RDFSSubPropertyOfRuleForEntityProperties
bsh:RDFSSubPropertyOfRuleForEntityProperties rdf:type sh:NodeShape ;
                                             sh:rule _:genid6649 ;
                                             sh:targetSubjectsOf rdfs:subPropertyOf ;
                                             sh:rule "na99033713e994d3fac6c613af3f33cc0b3847" .

_:genid6649 rdf:type sh:SPARQLRule ;
             sh:prefixes <https://brickschema.org/schema/1.4/Brick> ;
             sh:construct """
            CONSTRUCT {
                ?s ?super ?skolemized .
                ?skolemized ?ep ?eo .
            } WHERE {
                $this rdfs:subPropertyOf+ ?super .
                ?super a brick:EntityProperty .
                $this a brick:EntityProperty .
                ?s $this ?o .
                BIND(IF(isBlank(?o), IRI(CONCAT(\"urn:skolem:\", STRUUID())), ?o) AS ?skolemized)
                ?o ?ep ?eo .
            }
        """ .


