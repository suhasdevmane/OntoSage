###  https://brickschema.org/schema/BrickShape#InferSymmetricProperties
bsh:InferSymmetricProperties rdf:type sh:NodeShape ;
                             sh:rule _:genid6576 ;
                             sh:targetClass brick:Entity ;
                             sh:rule "na99033713e994d3fac6c613af3f33cc0b3605" .

_:genid6576 rdf:type sh:SPARQLRule ;
             sh:prefixes <https://brickschema.org/schema/1.4/Brick> ;
             sh:construct """
CONSTRUCT {
?o ?prop $this .
$this ?prop ?o .
}
WHERE {
  { $this ?prop ?o } UNION { ?o ?prop $this } .
  ?prop a owl:SymmetricProperty .
}
			""" .


###  https://brickschema.org/schema/BrickShape#InheritEVSEChargerDirection
bsh:InheritEVSEChargerDirection rdf:type owl:NamedIndividual ,
                                         sh:NodeShape ;
                                sh:rule _:genid6577 ;
                                sh:targetClass brick:Electric_Vehicle_Charging_Port .

_:genid6577 rdf:type sh:SPARQLRule ;
             sh:prefixes <https://brickschema.org/schema/1.4/Brick> ;
             sh:construct """
        CONSTRUCT {
            $this brick:electricVehicleChargerDirectionality ?direction
        } WHERE {
            $this rdf:type brick:Electric_Vehicle_Charging_Port .
            $this brick:isPartOf ?charger .
            ?charger a brick:Electric_Vehicle_Charging_Station .
            ?charger brick:electricVehicleChargerDirectionality ?direction .
            FILTER NOT EXISTS {
                $this brick:electricVehicleChargerDirectionality ?other_direction .
            }
        }
        """ .


