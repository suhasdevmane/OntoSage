###  file:///c:/Users/suhas/Documents/GitHub/OntoBot/bldg2/na99033713e994d3fac6c613af3f33cc0b3221
<file:///c:/Users/suhas/Documents/GitHub/OntoBot/bldg2/na99033713e994d3fac6c613af3f33cc0b3221> rdf:type owl:NamedIndividual ,
                                                                                                        sh:SPARQLRule ;
                                                                                               sh:prefixes <https://brickschema.org/schema/1.3/Brick> ;
                                                                                               sh:construct """
        CONSTRUCT { $this owl:deprecated true }
        WHERE { $this brick:deprecation ?dep }
        """ .


###  file:///c:/Users/suhas/Documents/GitHub/OntoBot/bldg2/na99033713e994d3fac6c613af3f33cc0b3222
<file:///c:/Users/suhas/Documents/GitHub/OntoBot/bldg2/na99033713e994d3fac6c613af3f33cc0b3222> rdf:type owl:NamedIndividual ,
                                                                                                        sh:SPARQLConstraint ;
                                                                                               sh:prefixes <https://brickschema.org/schema/1.3/Brick> ;
                                                                                               sh:select """SELECT $this ?class ?newClass ?depver WHERE {
$this a ?class .
?class owl:deprecated true .
?class brick:deprecatedInVersion ?depver .
?class brick:isReplacedBy ?newClass .
}""" ;
                                                                                               sh:message "{$this} has type {?class} which was deprecated in version {?depver}. For now, it has been updated to also be of type {?newClass}." .


