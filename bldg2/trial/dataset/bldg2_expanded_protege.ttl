###  https://brickschema.org/schema/BrickShape#MeterInferSubclassBuildingMeter
bsh:MeterInferSubclassBuildingMeter rdf:type sh:NodeShape ;
                                    sh:rule _:genid6594 ;
                                    sh:targetClass brick:Building_Meter ;
                                    sh:rule "na99033713e994d3fac6c613af3f33cc0b3699" .

_:genid6594 rdf:type sh:SPARQLRule ;
             sh:prefixes <https://brickschema.org/schema/1.4/Brick> ;
             sh:construct """
        CONSTRUCT {
            $this rdf:type ?metertype .
        } WHERE {
            $this rdf:type/rdfs:subClassOf* brick:Building_Meter .
            $this brick:hasSubstance ?substance .
            ?metertype brick:hasSubstance ?substance .
            ?metertype rdfs:subClassOf+ brick:Building_Meter .
        }
        """ .


###  https://brickschema.org/schema/BrickShape#MeterInferSubclassNonBuildingMeter
bsh:MeterInferSubclassNonBuildingMeter rdf:type sh:NodeShape ;
                                       sh:rule _:genid6595 ;
                                       sh:targetClass brick:Meter ;
                                       sh:rule "na99033713e994d3fac6c613af3f33cc0b3700" .

_:genid6595 rdf:type sh:SPARQLRule ;
             sh:prefixes <https://brickschema.org/schema/1.4/Brick> ;
             sh:construct """
        CONSTRUCT {
            $this rdf:type ?metertype .
        } WHERE {
            $this rdf:type/rdfs:subClassOf* brick:Meter .
            $this brick:hasSubstance ?substance .
            ?metertype brick:hasSubstance ?substance .
            FILTER NOT EXISTS {
                $this rdf:type/rdf:subClassOf* brick:Building_Meter
            }
            MINUS {
                ?metertype rdfs:subClassOf* brick:Building_Meter .
            }
        }
        """ .


