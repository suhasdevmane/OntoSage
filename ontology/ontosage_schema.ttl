####################################################################################################

####################################################################################################
#  CHANGELOG
#  ------------------------------------------------------------------------------------------------
#  2.0.0 (2026-07-17)  Consolidated release. Single-file "conversational layer" over Brick.
#      + Folded the HBCO conversation ontology (Module B) into this file (hbco: terms unchanged;
#        ontology/hbco_core.ttl is now a stub pointing here — non-breaking).
#      + Module C  Stakeholder roles (framing personas, explicitly NOT RBAC).
#      + Module D  Question-intent grammar (locate / quantify / trend / compare / anomaly /
#        forecast / comfort / discover / procedure / report).
#      + Module E  Report intake (fault / complaint / safety / feedback / suggestion).
#      + Module F  Answer provenance / grounding (source types + groundedIn + isSimulated) —
#        the vocabulary behind OntoSage's honest, auditable answers.
#      + Module G  Competency questions + example SPARQL per class (RAG + evaluation).
#      + Module H  Explicit Brick / REC / BOT / SOSA alignment (SKOS mapping only, non-entailing).
#      + Module I  Added SHACL shapes for Capability and Report (Concept shape moved from hbco_core).
#      = Module A  Capabilities: unchanged from 1.0.0 (fully backward-compatible; all v1 instances
#        keep resolving).
#  2.1.0 (2026-08-15)  + Module J  V5 OCBV-2: IntervalRecord hierarchy (Booking / WorkOrder /
#        AccessEvent / AlarmEvent / ComplianceCheck / AnomalyEvent) + lifecycle props;
#        ForecastSkill (measured predictive skill, SPARQL-answerable confidence);
#        AccessPolicy (PROTECT pillar: k-floors, resolution tiers, rate limits,
#        inference classes); amenity kinds Locker + PrinterPoint (bank demand).
#  1.0.0 (2026-07-15)  Initial OCBV — capabilities (amenities + knowledge topics) over Brick.
####################################################################################################


####################################################################################################
# Module J — V5 OCBV-2: Interval Records, Forecast Skill, Access Policies  (v2.1.0, 2026-08-15)
#
# Design: tasks/V5_OCBV2_DELTA_SPEC.md. Brick 1.4 has NO vocabulary for bookings, work
# orders, access events, dated compliance checks, persisted anomaly episodes, forecast
# skill, or access policies (audited) — this module adds exactly that, nothing Brick
# already names. Instances of IntervalRecord subclasses live in each building's events
# store (ref:storedAt -> events_data), NOT as per-event triples: the graph holds the
# vocabulary and each building's record-source declarations; the rows are data.
####################################################################################################

# ── J.1 Interval records (S2) ──────────────────────────────────────────────────────────────────

ontosage:IntervalRecord a owl:Class ;
    rdfs:label "Interval record"@en ;
    rdfs:comment "Abstract supertype for anything that happens over a time interval with a lifecycle: bookings, work orders, access events, alarms, compliance checks, anomaly episodes. Never instantiated directly."@en .

ontosage:Booking rdfs:subClassOf ontosage:IntervalRecord ; a owl:Class ;
    rdfs:label "Room booking"@en ;
    rdfs:comment "A reservation of a space for a time interval."@en ;
    skos:example "\"is the boardroom free at 3pm?\" -> overlap query on Booking records." .

ontosage:WorkOrder rdfs:subClassOf ontosage:IntervalRecord ; a owl:Class ;
    rdfs:label "Work order"@en ;
    rdfs:comment "A maintenance task with an open->assigned->done lifecycle."@en ;
    skos:example "\"how many overdue tickets?\" -> count WorkOrder where status=open and start older than SLA." .

ontosage:AccessEvent rdfs:subClassOf ontosage:IntervalRecord ; a owl:Class ;
    rdfs:label "Access event"@en ;
    rdfs:comment "An aggregate-queryable entry event at an entrance. Per-person queries are denied by inference-class policy."@en .

ontosage:AlarmEvent rdfs:subClassOf ontosage:IntervalRecord ; a owl:Class ;
    rdfs:label "Alarm activation"@en ;
    rdfs:comment "A persisted alarm activation episode (fire panel, freezer, leak...)."@en .

ontosage:ComplianceCheck rdfs:subClassOf ontosage:IntervalRecord ; a owl:Class ;
    rdfs:label "Compliance check"@en ;
    rdfs:comment "A dated statutory or policy check (fire alarm test, legionella flush, LOLER, PAT...). Due/overdue is computed from dueDate vs completedDate."@en ;
    skos:example "\"which risk assessments are past review?\" -> ComplianceCheck where dueDate < NOW and completedDate absent." .

ontosage:AnomalyEvent rdfs:subClassOf ontosage:IntervalRecord ; a owl:Class ;
    rdfs:label "Anomaly episode"@en ;
    rdfs:comment "A persisted detector finding with a stable id: one episode per contiguous deviation (extended while it persists, closed when readings normalise)."@en ;
    skos:example "\"summarise this week's anomalies\" -> AnomalyEvent episodes overlapping the week." .

ontosage:aboutSpace a owl:ObjectProperty ;
    rdfs:domain ontosage:IntervalRecord ; rdfs:range brick:Location ;
    rdfs:label "about space"@en ; rdfs:comment "The room/zone the record concerns."@en .

ontosage:aboutEquipment a owl:ObjectProperty ;
    rdfs:domain ontosage:IntervalRecord ; rdfs:range brick:Equipment ;
    rdfs:label "about equipment"@en .

ontosage:aboutPoint a owl:ObjectProperty ;
    rdfs:domain ontosage:IntervalRecord ; rdfs:range brick:Point ;
    rdfs:label "about point"@en ; rdfs:comment "AnomalyEvent: the sensor concerned."@en .

ontosage:recordStatus a owl:DatatypeProperty ;
    rdfs:domain ontosage:IntervalRecord ; rdfs:range xsd:string ;
    rdfs:label "record status"@en ;
    rdfs:comment "Lifecycle state: open | assigned | done | cancelled | detected | resolved."@en .

ontosage:dueDate a owl:DatatypeProperty ;
    rdfs:domain ontosage:ComplianceCheck ; rdfs:range xsd:dateTime ;
    rdfs:label "due date"@en .

ontosage:completedDate a owl:DatatypeProperty ;
    rdfs:domain ontosage:IntervalRecord ; rdfs:range xsd:dateTime ;
    rdfs:label "completed date"@en .

ontosage:responsibleRole a owl:DatatypeProperty ;
    rdfs:domain ontosage:IntervalRecord ; rdfs:range xsd:string ;
    rdfs:label "responsible role"@en ;
    rdfs:comment "A ROLE name, never a person identifier (privacy by design)."@en .

ontosage:detectedBy a owl:DatatypeProperty ;
    rdfs:domain ontosage:AnomalyEvent ; rdfs:range xsd:string ;
    rdfs:label "detected by"@en ; rdfs:comment "Detector id, e.g. seasonal_residual, stuck_sensor."@en .

ontosage:baselineValue a owl:DatatypeProperty ;
    rdfs:domain ontosage:AnomalyEvent ; rdfs:range xsd:double ;
    rdfs:label "baseline value"@en ; rdfs:comment "The expected-band context the deviation is measured against."@en .

# ── J.2 Forecast skill (P3 PREDICT) ────────────────────────────────────────────────────────────

ontosage:ForecastSkill a owl:Class ;
    rdfs:label "Forecast skill record"@en ;
    rdfs:comment "Measured predictive skill for one (modality x horizon) on THIS building, from walk-forward backtesting. Cited in every forecast answer; makes 'how good are your forecasts?' SPARQL-answerable."@en ;
    skos:example "\"how confident are you?\" -> the ForecastSkill for co2 @ 24h: MAE, MAPE, CI coverage." .

ontosage:skillOf a owl:DatatypeProperty ;
    rdfs:domain ontosage:ForecastSkill ; rdfs:range xsd:string ;
    rdfs:label "skill of modality"@en .

ontosage:horizonHours a owl:DatatypeProperty ;
    rdfs:domain ontosage:ForecastSkill ; rdfs:range xsd:double ;
    rdfs:label "horizon (hours)"@en .

ontosage:backtestMAE a owl:DatatypeProperty ;
    rdfs:domain ontosage:ForecastSkill ; rdfs:range xsd:double ;
    rdfs:label "backtest MAE"@en .

ontosage:backtestMAPE a owl:DatatypeProperty ;
    rdfs:domain ontosage:ForecastSkill ; rdfs:range xsd:double ;
    rdfs:label "backtest MAPE (%)"@en .

ontosage:ciCoverage80 a owl:DatatypeProperty ;
    rdfs:domain ontosage:ForecastSkill ; rdfs:range xsd:double ;
    rdfs:label "80% CI coverage (measured)"@en ;
    rdfs:comment "Fraction of holdout actuals inside the 80% interval — calibration, not hope."@en .

ontosage:skillMeasuredAt a owl:DatatypeProperty ;
    rdfs:domain ontosage:ForecastSkill ; rdfs:range xsd:dateTime ;
    rdfs:label "skill measured at"@en .

# ── J.3 Access policies (Pillar C PROTECT) ─────────────────────────────────────────────────────

ontosage:AccessPolicy a owl:Class ;
    rdfs:label "Access policy"@en ;
    rdfs:comment "A query-parameter access policy: who may see what, at which aggregation floor, resolution tier and rate. Consumed ONLY by the deterministic Policy Decision Point; cited in the evidence dossier of every answer it shapes."@en ;
    skos:example "\"what am I allowed to ask?\" -> the AccessPolicy set for the session role." .

ontosage:appliesToRole a owl:DatatypeProperty ;
    rdfs:domain ontosage:AccessPolicy ; rdfs:range xsd:string ;
    rdfs:label "applies to role"@en ;
    rdfs:comment "Canonical RBAC role name. Personas NEVER map to policies."@en .

ontosage:scopeSpaces a owl:DatatypeProperty ;
    rdfs:domain ontosage:AccessPolicy ; rdfs:range xsd:string ;
    rdfs:label "space scope"@en ; rdfs:comment "own | public | any."@en .

ontosage:minAggregationSensors a owl:DatatypeProperty ;
    rdfs:domain ontosage:AccessPolicy ; rdfs:range xsd:integer ;
    rdfs:label "k-anonymity sensor floor"@en .

ontosage:minAggregationSpaces a owl:DatatypeProperty ;
    rdfs:domain ontosage:AccessPolicy ; rdfs:range xsd:integer ;
    rdfs:label "k-anonymity space floor"@en .

ontosage:resolutionTier a owl:DatatypeProperty ;
    rdfs:domain ontosage:AccessPolicy ; rdfs:range xsd:string ;
    rdfs:label "resolution tier"@en ;
    rdfs:comment "Serialized 'recencyMinutes:maxResolutionSeconds' pairs; finer data for recent windows, coarser for history."@en .

ontosage:rateLimit a owl:DatatypeProperty ;
    rdfs:domain ontosage:AccessPolicy ; rdfs:range xsd:string ;
    rdfs:label "rate limit"@en ; rdfs:comment "Serialized 'maxQueries:perMinutes'; 0 = unlimited."@en .

ontosage:inferenceClass a owl:DatatypeProperty ;
    rdfs:domain ontosage:AccessPolicy ; rdfs:range xsd:string ;
    rdfs:label "inference class rule"@en ;
    rdfs:comment "Question-shape rules, e.g. individual_presence:deny — the system explains the building, never tracks individuals."@en .

# ── J.4 Amenity kinds added from measured bank demand (V5-T03) ─────────────────────────────────

ontosage:Locker rdfs:subClassOf ontosage:Amenity ; a owl:Class ;
    rdfs:label "Locker bank"@en ; rdfs:comment "Storage lockers for occupants/students."@en ;
    skos:example "\"which lockers are still available?\"" .

ontosage:PrinterPoint rdfs:subClassOf ontosage:Amenity ; a owl:Class ;
    rdfs:label "Printer / copy point"@en ; rdfs:comment "A shared printing location."@en .

# ── Module K — Sensor classes Brick does not define  (V5-T10, 2026-08-18) ─────────────────────
#
# WHY THIS MODULE EXISTS.  The SATURATE provisioner used to mint every configured
# sensor class into the Brick namespace unconditionally.  Where Brick has no such
# class, that invented a term inside someone else's namespace: an audited building
# graph carried dozens of instances typed `brick:Sound_Level_Sensor`, a class Brick
# does not define, and a Brick validator would reject them (BUG-179).
#
# The honest form is to declare the class HERE, in OntoSage's own namespace, as a
# subclass of the nearest real Brick class.  A modality config may then name it
# explicitly (`ontosage:Sound_Level_Sensor`); a bare name still means Brick.
# These are TBox terms about sensing in general — no building facts, nothing
# building-specific — so they belong in the shared ontology, not in input/.
#
# Acoustic sensing has no Brick class in the version this project pins; sound
# level is nonetheless one of the most-asked-about quantities in the survey
# corpus ("which room is quietest?"), so the building must be able to say it.

ontosage:Sound_Level_Sensor a owl:Class ;
    rdfs:subClassOf brick:Sensor ;
    rdfs:label "Sound level sensor"@en ;
    rdfs:comment "Measures ambient sound pressure level, normally reported in dB(A). Declared by OntoSage because the pinned Brick version defines no acoustic sensor class; the WHO indoor guideline band 30-70 dB(A) anchors its comfort scoring."@en ;
    skos:example "\"which room is quietest right now?\"" .

# Outdoor/green-roof sensing. Brick 1.4 defines no soil-moisture or precipitation
# sensor class, and a building with a green roof is asked about both ("does the roof
# need watering?", "how much rain did we capture?"). Declared here for the same reason
# as the acoustic classes above: the alternative is inventing a term inside Brick's
# namespace, which BUG-179 established this project does not do.

ontosage:Soil_Moisture_Sensor a owl:Class ;
    rdfs:subClassOf brick:Sensor ;
    rdfs:label "Soil moisture sensor"@en ;
    rdfs:comment "Measures volumetric water content of a growing medium, reported as a percentage. Declared by OntoSage because the pinned Brick version defines no soil or substrate moisture class; distinct from Relative_Humidity_Sensor, which measures air."@en ;
    skos:example "\"does the green roof need watering?\"" .

ontosage:Rainfall_Sensor a owl:Class ;
    rdfs:subClassOf brick:Sensor ;
    rdfs:label "Rainfall sensor"@en ;
    rdfs:comment "Measures precipitation depth over an interval, normally in millimetres. Declared by OntoSage because the pinned Brick version defines no precipitation class; relevant to green-roof retention and rainwater harvesting questions."@en ;
    skos:example "\"how much rain fell on the roof this week?\"" .

ontosage:Noise_Level_Sensor a owl:Class ;
    rdfs:subClassOf ontosage:Sound_Level_Sensor ;
    rdfs:label "Noise level sensor"@en ;
    rdfs:comment "Alias kept for graphs that label the same measurement 'noise' rather than 'sound level'."@en .

# A time-series store a sensor's readings actually live in — the object of
# `ref:storedAt`. Brick models the BUILDING, not the systems that persist its
# telemetry, and the ref ontology names the reference (`ref:TimeseriesReference`)
# without naming the store it points at. Instances were therefore typed
# `brick:Database`, a term Brick does not define (TODO-181). Declared here for
# the same reason as the acoustic classes above: the concept is load-bearing —
# `ref:storedAt` is half of what makes a question answerable at all — so it
# needs a class that genuinely exists.
# ── Equipment and grouping concepts Brick 1.4 does not model ──────────────────
# Surfaced by the undeclared-type audit when a real academic building was
# booted: its model names plant and control concepts that Brick has no class
# for, so the TTL had minted them into brick: — asserting Brick defines terms it
# does not. Each is declared here against the closest Brick parent, for the same
# reason as the acoustic classes above: the concepts are real and load-bearing
# for the questions this building gets asked, so they need a class that exists.
#
# Where Brick DOES define a near-match the instance is retyped to Brick instead
# and nothing is declared here — brick:Electric_Power_Sensor (not "Electrical")
# and brick:Vibration_Sensor_Equipment are both real Brick classes.

ontosage:Emergency_Generator a owl:Class ;
    rdfs:subClassOf brick:Equipment ;
    rdfs:label "Emergency generator"@en ;
    rdfs:comment "Standby generation plant serving life-safety and critical loads during a supply failure. Brick 1.4 defines Emergency_Generator_Alarm and _Status points but no equipment class to hang them on."@en .

ontosage:Heat_Pump a owl:Class ;
    rdfs:subClassOf brick:Equipment ;
    rdfs:label "Heat pump"@en ;
    rdfs:comment "Reversible heat-transfer plant. Brick 1.4 defines only the compound condensing-unit variants (Heat_Pump_Condensing_Unit and its air/ground-source subclasses), none of which fit a whole-unit instance."@en .

ontosage:Renewable_Energy_System a owl:Class ;
    rdfs:subClassOf brick:System ;
    rdfs:label "Renewable energy system"@en ;
    rdfs:comment "On-site generation such as photovoltaic or solar-thermal, modelled as a system rather than a single equipment item because it spans arrays, inverters and metering."@en .

ontosage:Alarm_Group a owl:Class ;
    rdfs:subClassOf brick:Collection ;
    rdfs:label "Alarm group"@en ;
    rdfs:comment "A named set of alarms handled together. Deliberately a brick:Collection and NOT a brick:Alarm: a group of alarms is not itself an alarm, and typing it as one would let it match queries asking for active alarms."@en .

ontosage:Lighting_Command a owl:Class ;
    rdfs:subClassOf brick:Command ;
    rdfs:label "Lighting command"@en ;
    rdfs:comment "A writable point controlling luminaire state or level."@en .

ontosage:Database a owl:Class ;
    rdfs:label "Database"@en ;
    rdfs:comment "A registered time-series backend holding sensor readings; the object of ref:storedAt, resolved to a connection through database_registry.yaml."@en ;
    skos:example "\"bldg:database2\" — the MySQL instance behind this building's narrow tables" .


####################################################################################################
#  Module M — Sensor metadata and evidence quality  (V6-T06, Master Report Table 14)
#  ------------------------------------------------------------------------------------------------
#  The Master Technical Report lists the MINIMUM metadata a data source must carry before the
#  building may reason about how much its own evidence is worth: identity and purpose, spatial
#  context, operational cadence, semantic relationships, quality state, calibration and
#  maintenance, historical validity, and access classification.
#
#  WHY THESE ARE TRIPLES AND NOT A SIDECAR YAML
#  A sensor's calibration date is a fact ABOUT THE BUILDING, so design contract #2 puts it in the
#  graph. Two practical consequences follow, and both matter more than the principle: the gates
#  that consult it are SPARQL queries, so they need it graph-resident; and the admin Ontology tab
#  can already upload and edit TTL, so authoring needs no new interface. A second file describing
#  the same sensors would drift from the first, and nothing would notice.
#
#  ABSENCE IS "UNKNOWN", NEVER "FINE"
#  A building that authors none of this is not thereby well-calibrated. Every consuming gate must
#  read a missing value as `unknown` and act accordingly — which for a standards verdict means
#  refusing it (Master 14.1 acceptance scenario 7). Defaults that assume good state would let an
#  uninstrumented building claim conformance it cannot support.

ontosage:calibratedOn a owl:DatatypeProperty ;
    rdfs:label "calibration date"@en ;
    rdfs:comment "Date this point was last calibrated. Absence means UNKNOWN — not uncalibrated, and not fine: a standards or compliance verdict may not rest on a point whose calibration state is unknown."@en ;
    rdfs:range xsd:date ;
    skos:example "\"2026-03-14\"^^xsd:date" .

ontosage:calibrationMethod a owl:DatatypeProperty ;
    rdfs:label "calibration method"@en ;
    rdfs:comment "How the calibration was performed, and against what reference. Master 10.1 asks for comparison against trusted reference instruments; recording the method is what makes one calibration comparable to another."@en ;
    rdfs:range xsd:string ;
    skos:example "\"NDIR two-point against a certified 400/1000 ppm reference\"" .

ontosage:calibrationDueOn a owl:DatatypeProperty ;
    rdfs:label "calibration due date"@en ;
    rdfs:comment "When calibration next falls due. Lets a gate distinguish EXPIRED from never-calibrated — a different remedy, and a different level of trust in the interim readings."@en ;
    rdfs:range xsd:date .

ontosage:qualityFlag a owl:DatatypeProperty ;
    rdfs:label "data quality flag"@en ;
    rdfs:comment "Operator-asserted quality state of this point: good | suspect | faulty | unknown. Distinct from computed health (which comes from the readings themselves) because an operator may know a sensor is faulty before the data shows it, and may know a plausible-looking series is wrong."@en ;
    rdfs:range xsd:string ;
    skos:example "\"suspect\"" .

ontosage:faultState a owl:DatatypeProperty ;
    rdfs:label "fault state"@en ;
    rdfs:comment "Current fault condition, where the device or BMS reports one."@en ;
    rdfs:range xsd:string .

ontosage:mountingHeightM a owl:DatatypeProperty ;
    rdfs:label "mounting height (m)"@en ;
    rdfs:comment "Height above finished floor. HSE guidance places CO2 monitors at head height and away from openings; a sensor at ceiling level measures something different from one at desk level, and an answer that ignores this compares unlike with unlike."@en ;
    rdfs:range xsd:decimal ;
    skos:example "\"1.2\"^^xsd:decimal" .

ontosage:environmentalBoundary a owl:ObjectProperty ;
    rdfs:label "environmental boundary"@en ;
    rdfs:comment "The space whose conditions this point actually measures. Usually the space that contains it — but NOT always, which is the entire reason the property exists: a sensor in a duct, a plenum, or mounted on a corridor wall serving an adjacent room has a containing space that is not the space it describes. The non-substitution rule (Master 8) is enforced against THIS, never against containment."@en ;
    rdfs:range brick:Location .

ontosage:samplingIntervalS a owl:DatatypeProperty ;
    rdfs:label "sampling interval (s)"@en ;
    rdfs:comment "How often the device physically measures. First of the Master Report's three clocks (Table 12); distinct from how often it transmits and from what is archived."@en ;
    rdfs:range xsd:integer .

ontosage:transmissionIntervalS a owl:DatatypeProperty ;
    rdfs:label "transmission interval (s)"@en ;
    rdfs:comment "How often the device reports. Second of the three clocks. This is what a freshness gate must judge against: a point transmitting every 15 minutes is not stale at 10."@en ;
    rdfs:range xsd:integer .

ontosage:archivalIntervalS a owl:DatatypeProperty ;
    rdfs:label "archival interval (s)"@en ;
    rdfs:comment "The permanent canonical resolution. Third of the three clocks, and the one a completeness gate needs: expected sample count over a window is derived from THIS, never assumed."@en ;
    rdfs:range xsd:integer ;
    skos:example "\"60\"^^xsd:integer" .

ontosage:accessClassification a owl:DatatypeProperty ;
    rdfs:label "access tier"@en ;
    rdfs:comment "Which of the Master Report's six access tiers (Table 15) may see this point: public | occupant | operational | safety_security | research | strategic. The conversational layer must enforce the same permissions as the underlying systems and must never become a route around them."@en ;
    rdfs:range xsd:string ;
    skos:example "\"operational\"" .

#  ── Effective-dated validity (V6-T07 builds on this) ───────────────────────────────────────────
#  A sensor that moves, or is recalibrated, produces a step change that reads exactly like a real
#  change in the building. Master 14.1 acceptance scenario 3 requires historical observations to
#  stay linked to the location and configuration in force WHEN THEY WERE COLLECTED, so validity is
#  modelled as an interval rather than by overwriting the current value.

ontosage:ConfigurationPeriod a owl:Class ;
    rdfs:label "Configuration period"@en ;
    rdfs:comment "An interval during which a point's location, calibration and configuration were stable. Readings are interpreted against the period covering their timestamp, so a window spanning a boundary can be flagged rather than silently averaged across a discontinuity."@en .

ontosage:hasConfigurationPeriod a owl:ObjectProperty ;
    rdfs:label "has configuration period"@en ;
    rdfs:domain brick:Point ; rdfs:range ontosage:ConfigurationPeriod .

ontosage:effectiveFrom a owl:DatatypeProperty ;
    rdfs:label "effective from"@en ;
    rdfs:comment "Start of the period. Inclusive."@en ;
    rdfs:domain ontosage:ConfigurationPeriod ; rdfs:range xsd:dateTime .

ontosage:effectiveTo a owl:DatatypeProperty ;
    rdfs:label "effective until"@en ;
    rdfs:comment "End of the period. ABSENT means still in force — the open interval is the normal case, and writing a far-future date instead would silently expire."@en ;
    rdfs:domain ontosage:ConfigurationPeriod ; rdfs:range xsd:dateTime .

ontosage:configurationChange a owl:DatatypeProperty ;
    rdfs:label "configuration change"@en ;
    rdfs:comment "What changed at the start of this period: relocation | recalibration | replacement | firmware | commissioning. Reported alongside any trend that spans the boundary, so a measurement artefact is never presented as building behaviour."@en ;
    rdfs:domain ontosage:ConfigurationPeriod ; rdfs:range xsd:string ;
    skos:example "\"recalibration\"" .

ontosage:periodLocation a owl:ObjectProperty ;
    rdfs:label "location during period"@en ;
    rdfs:comment "Where the point was during this period. This is what an as-of query resolves, so a reading from March stays attributed to the room the sensor was in during March."@en ;
    rdfs:domain ontosage:ConfigurationPeriod ; rdfs:range brick:Location .


####################################################################################################
#  Module N — Served zones  (V6-T12, Master Report 8 — the non-substitution rule)
#  ------------------------------------------------------------------------------------------------
#  The Master Report's primary placement rule is that a sensor must sit within the environmental
#  boundary it answers about. It permits exactly ONE alternative: a *validated served zone*. This
#  module is that alternative, and nothing else.
#
#  WHY THIS IS ASSERTED AND VALIDATED, NEVER INFERRED
#  Two tempting shortcuts are both wrong, and both have already cost this project:
#
#    * "same floor" — this IS the corridor substitution the report forbids. A floor is not a
#      thermal, acoustic or ventilation boundary, and a corridor sensor is on the same floor as
#      every room it cannot speak for.
#    * "geometrically nearest" — nearness implying attribution is exactly how BUG-189 attributed
#      one room's reading to a corridor the building did not have. Distance is not evidence of
#      what a sensor measures; ductwork is.
#
#  So membership must be ASSERTED by someone who knows the mechanical design, and must carry a
#  validation record. An unvalidated assertion does NOT count: `ontosage:zoneValidated false`
#  (or an absent flag) leaves the relation visible for review while keeping it out of every
#  answer. That asymmetry is deliberate — an unvalidated zone silently trusted is a substitution
#  wearing a label.
#
#  A building that authors none of this is not thereby broken. It falls back to
#  in-room-or-proxy, which is the SAFE direction: fewer answers, none of them substituted.

ontosage:ServedZone a owl:Class ;
    rdfs:subClassOf brick:Location ;
    rdfs:label "Served zone"@en ;
    rdfs:comment "A set of spaces whose conditions are genuinely represented by a shared point — typically because one air-handling unit, one thermal zone or one distributed sensor array serves them all. Membership is a claim about the MECHANICAL design, not about geometry, and it must be validated before any answer may rest on it."@en .

ontosage:servesSpace a owl:ObjectProperty ;
    rdfs:label "serves space"@en ;
    rdfs:comment "A space this zone genuinely represents. Asserted from the mechanical design or a commissioning survey — never derived from adjacency, floor membership or distance."@en ;
    rdfs:domain ontosage:ServedZone ; rdfs:range brick:Location .

ontosage:servedByPoint a owl:ObjectProperty ;
    rdfs:label "served by point"@en ;
    rdfs:comment "The point whose readings represent this zone. Usually located in one of the served spaces, but it may sit in a duct or plenum — which is why ontosage:environmentalBoundary exists alongside containment."@en ;
    rdfs:domain ontosage:ServedZone ; rdfs:range brick:Point .

ontosage:zoneValidated a owl:DatatypeProperty ;
    rdfs:label "zone validated"@en ;
    rdfs:comment "True only when the serving relation has been checked against the mechanical design or a commissioning survey. ABSENT OR FALSE MEANS THE ZONE DOES NOT COUNT: the spatial-adequacy gate treats an unvalidated zone as proxy evidence, so it can be reported as context but can never carry a room-level claim. Fail-closed on purpose — an unvalidated zone that were trusted is a silent substitution."@en ;
    rdfs:domain ontosage:ServedZone ; rdfs:range xsd:boolean .

ontosage:zoneValidationMethod a owl:DatatypeProperty ;
    rdfs:label "zone validation method"@en ;
    rdfs:comment "How the serving relation was established: mechanical_schedule | commissioning_survey | tracer_test | as_built_drawing. Recorded because 'validated' means little without saying against what — and because a tracer test and a drawing are not equally strong evidence."@en ;
    rdfs:domain ontosage:ServedZone ; rdfs:range xsd:string ;
    skos:example "\"commissioning_survey\"" .

ontosage:zoneValidatedOn a owl:DatatypeProperty ;
    rdfs:label "zone validated on"@en ;
    rdfs:comment "When the serving relation was last verified. A zone validated against a mechanical schedule from before a refurbishment describes a building that no longer exists."@en ;
    rdfs:domain ontosage:ServedZone ; rdfs:range xsd:date .


####################################################################################################
#  Module O — Service state, accessibility and institutional context  (V6-T58 / T60 vocabulary)
#  ------------------------------------------------------------------------------------------------
#  The supervisors' 480 catalogue questions were counted by the source family each one needs. The
#  largest families after occupancy are: opening hours & closures (271 questions), room bookings
#  (249), lift status (162), network/IT service (158), AV and teaching equipment (94), and the
#  accessibility inventory (59). `ontosage:openingHours`, `ontosage:Booking`, `ontosage:Lift` and
#  the Amenity hierarchy already exist; this module adds the rest.
#
#  ONE RULE GOVERNS THE WHOLE MODULE: STATE COMES FROM AN AUTHORITATIVE SOURCE, NEVER FROM A SENSOR
#  The PhD catalogue states the failure modes as a list, and each is a plausible inference the
#  system must refuse to make: an empty room is not available; an open door is not access; a quiet
#  room is not private; a green service heartbeat is not proof a device will work. So every status
#  here is an ASSERTED record with an issuing source and an observation time — not something
#  derived from telemetry. A lift that no-one has reported as working is `unverified`, which is a
#  different answer from `working`, and the difference is the point.

ontosage:AssetStatus rdfs:subClassOf ontosage:IntervalRecord ; a owl:Class ;
    rdfs:label "Asset status record"@en ;
    rdfs:comment "The reported operational state of a lift, door, AV system, network service or amenity over an interval. An IntervalRecord because status is a thing that STARTED at a time and may still hold: 'the lift failed at 09:14 and is still out' is one record, not a flag that was overwritten."@en ;
    skos:example "\"is the lift working?\" -> newest AssetStatus for that lift, with its issuing source and observation time." .

ontosage:statusValue a owl:DatatypeProperty ;
    rdfs:label "status value"@en ;
    rdfs:comment "operational | degraded | out_of_service | unverified. UNVERIFIED is the default for anything no authoritative source has reported, and is deliberately NOT the same as operational: 'nobody has told me it is broken' is not evidence that it works, and answering as though it were is how a step-free route gets recommended through a failed lift."@en ;
    rdfs:domain ontosage:AssetStatus ; rdfs:range xsd:string ;
    skos:example "\"out_of_service\"" .

ontosage:statusSource a owl:DatatypeProperty ;
    rdfs:label "issuing source"@en ;
    rdfs:comment "The authoritative system or role that reported this state. Recorded because the Master Report requires source authority on every consequential answer, and because a status with no traceable issuer cannot be relied on for a safety-adjacent decision."@en ;
    rdfs:domain ontosage:AssetStatus ; rdfs:range xsd:string ;
    skos:example "\"lift_controller\" | \"estates_helpdesk\" | \"av_support\"" .

ontosage:statusObservedAt a owl:DatatypeProperty ;
    rdfs:label "status observed at"@en ;
    rdfs:comment "When the issuing source last confirmed this state. A three-week-old 'operational' is not current status, and the freshness gate judges it exactly as it judges a sensor reading."@en ;
    rdfs:domain ontosage:AssetStatus ; rdfs:range xsd:dateTime .

ontosage:statusOf a owl:ObjectProperty ;
    rdfs:label "status of"@en ;
    rdfs:comment "The asset, amenity or service this record describes."@en ;
    rdfs:domain ontosage:AssetStatus .

ontosage:assistanceContact a owl:DatatypeProperty ;
    rdfs:label "assistance contact"@en ;
    rdfs:comment "Who to contact when this asset is unavailable. Present so a decline can be USEFUL: 'the lift is out of service, and step-free access to level 5 is via the estates helpdesk on x1234' is an answer; 'the lift is out of service' strands someone."@en ;
    rdfs:range xsd:string .

#  ── Service catalogue: the assets whose state gets reported ─────────────────────────────────────

ontosage:AVEquipment a owl:Class ;
    rdfs:subClassOf brick:Equipment ;
    rdfs:label "AV / teaching equipment"@en ;
    rdfs:comment "Projector, display, lecture-capture, microphone or hybrid-conferencing rig serving a space. 94 of the supervisors' questions depend on knowing whether the teaching kit in a room works BEFORE the class starts."@en .

ontosage:NetworkService a owl:Class ;
    rdfs:subClassOf brick:System ;
    rdfs:label "Network / IT service"@en ;
    rdfs:comment "An aggregate connectivity or IT service serving spaces — wired, wireless, or a named platform. Deliberately an aggregate: the catalogues ask about SERVICE health, and per-device or per-user network monitoring would be surveillance the privacy rules forbid."@en .

ontosage:Parking_Occupancy_Sensor a owl:Class ;
    rdfs:subClassOf brick:Occupancy_Count_Sensor ;
    rdfs:label "Parking bay occupancy / availability sensor"@en ;
    rdfs:comment "A count of parking bays that are free or occupied. Brick has no class for this: brick:Occupancy_Count_Sensor is the nearest, and it also covers entrance footfall counters and room people-counters. On the building this was developed against that one class held 257 sensors of which exactly ONE was parking, so a parking question resolved to a class it shared with 256 other things and no answer could be given — the system knew the bay count and could not reach it. Declaring the specific class is the TTL-first fix: the CLASS becomes the discriminator, so nothing downstream needs a label filter, and subclassing the Brick parent means every existing query that asks for Occupancy_Count_Sensor still finds it."@en ;
    skos:example "\"how many parking spaces are free?\"" .

ontosage:serviceStatus a owl:ObjectProperty ;
    rdfs:label "current service status"@en ;
    rdfs:comment "Convenience link from an asset to its newest AssetStatus record. The records remain the source of truth — this is a shortcut for the common 'is it working now' query, not a replacement for the history."@en ;
    rdfs:range ontosage:AssetStatus .

#  ── Accessibility register ──────────────────────────────────────────────────────────────────────
#  Accessibility is a HARD filter, not a preference (rule R-11). An unverified feature must never
#  be labelled accessible: the real-world cost of that error is stranding somebody, which is the
#  highest-consequence failure anywhere in the question bank.

ontosage:AccessibilityFeature a owl:Class ;
    rdfs:subClassOf ontosage:Amenity ;
    rdfs:label "Accessibility feature"@en ;
    rdfs:comment "A feature provided for accessibility: hearing loop, tactile paving, Changing Places facility, accessible WC, power-assisted door, accessible parking bay. An Amenity subclass so the existing capability resolver locates it with no new code."@en .

ontosage:accessibilityKind a owl:DatatypeProperty ;
    rdfs:label "accessibility feature kind"@en ;
    rdfs:comment "hearing_loop | tactile_paving | changing_places | accessible_wc | power_assisted_door | accessible_parking | step_free_entrance | adjustable_desk."@en ;
    rdfs:domain ontosage:AccessibilityFeature ; rdfs:range xsd:string .

ontosage:accessibilityVerified a owl:DatatypeProperty ;
    rdfs:label "accessibility verified"@en ;
    rdfs:comment "True only when the feature has been inspected and confirmed working. ABSENT OR FALSE MEANS UNVERIFIED, and an unverified feature may NOT be presented as accessible — the hard filter fails closed for the same reason a served zone does, but the consequence of getting it wrong is a person stranded rather than a wrong number."@en ;
    rdfs:domain ontosage:AccessibilityFeature ; rdfs:range xsd:boolean .

ontosage:accessibilityVerifiedOn a owl:DatatypeProperty ;
    rdfs:label "accessibility verified on"@en ;
    rdfs:comment "When the feature was last inspected. A hearing loop verified three years ago is a claim about a building that may no longer be true."@en ;
    rdfs:domain ontosage:AccessibilityFeature ; rdfs:range xsd:date .

#  ── Scheduled operations ────────────────────────────────────────────────────────────────────────

ontosage:ServiceSchedule a owl:Class ;
    rdfs:subClassOf ontosage:IntervalRecord ; a owl:Class ;
    rdfs:label "Service schedule entry"@en ;
    rdfs:comment "A planned recurring operation on a space: cleaning, waste collection, planned maintenance, planned shutdown. Distinct from a WorkOrder, which is reactive: 'when is this room next cleaned' and 'who is fixing the broken tap' are different questions with different sources."@en .

ontosage:scheduleKind a owl:DatatypeProperty ;
    rdfs:label "schedule kind"@en ;
    rdfs:comment "cleaning | waste_collection | planned_maintenance | planned_shutdown | inspection."@en ;
    rdfs:domain ontosage:ServiceSchedule ; rdfs:range xsd:string .

ontosage:TimetabledSession rdfs:subClassOf ontosage:IntervalRecord ; a owl:Class ;
    rdfs:label "Timetabled session"@en ;
    rdfs:comment "A scheduled teaching or institutional session in a space. Separate from Booking because the two answer different questions and have different authority: a timetable says what the institution has PLANNED, a booking says what somebody has RESERVED, and where they disagree the answer must say so rather than silently prefer one."@en .

ontosage:sessionKind a owl:DatatypeProperty ;
    rdfs:label "session kind"@en ;
    rdfs:comment "lecture | seminar | lab | exam | event | meeting."@en ;
    rdfs:domain ontosage:TimetabledSession ; rdfs:range xsd:string .

ontosage:expectedAttendance a owl:DatatypeProperty ;
    rdfs:label "expected attendance"@en ;
    rdfs:comment "Planned headcount. An institutional expectation, never an occupancy measurement — the catalogues are explicit that a planned figure must not be reported as an observed one."@en ;
    rdfs:range xsd:integer .

ontosage:ClosurePeriod rdfs:subClassOf ontosage:IntervalRecord ; a owl:Class ;
    rdfs:label "Closure period"@en ;
    rdfs:comment "An interval during which a space, floor or the whole building is closed or restricted. Opening hours say what is NORMAL; a closure says what overrides it, and 271 of the supervisors' questions depend on the override being visible."@en .

ontosage:closureReason a owl:DatatypeProperty ;
    rdfs:label "closure reason"@en ;
    rdfs:comment "Why the space is closed, in terms a person can act on."@en ;
    rdfs:domain ontosage:ClosurePeriod ; rdfs:range xsd:string .


####################################################################################################
#  Module P — Amenity service status and potability  (V6-T45)
#  ------------------------------------------------------------------------------------------------
#  Two gaps found by the category gap sweep, both of which cause a WRONG answer rather than a
#  missing one — which is why they are worth a vocabulary addition rather than a backlog note.
#
#  1. AMENITIES HAVE NO SERVICE STATE. ontosage:Amenity carries locatedIn, onFloor, locationText,
#     answerText and openingHours — and nothing about whether the thing currently works. So an
#     out-of-service drinking fountain is still recommended as a drinking fountain. Module O gave
#     ASSETS a status record; this extends the same treatment to amenities, which are what a
#     stakeholder actually asks about ("is that water fountain working?").
#
#  2. POTABILITY IS A HEALTH CLAIM AND MUST NEVER BE INFERRED. The lay-term mapping already sends
#     "drinking water" and "potable water" at brick:Water_Quality_Sensor, and a flow reading sits
#     one short step away. The Master Report is explicit that a sensor reading does not support a
#     health statement, so potability is modelled as a PUBLISHED STATEMENT with a responsible
#     owner — never as something derived from a measurement. This is the non-substitution rule
#     applied to its most dangerous case: being wrong about drinkability harms someone.

ontosage:amenityStatus a owl:ObjectProperty ;
    rdfs:label "amenity service status"@en ;
    rdfs:comment "Links an amenity to its current ontosage:AssetStatus record. An amenity whose status is out_of_service must be EXCLUDED from recommendations rather than listed with a caveat: somebody who walks to a broken fountain has been given a wrong answer, however well hedged."@en ;
    rdfs:domain ontosage:Amenity ; rdfs:range ontosage:AssetStatus .

ontosage:PotabilityStatement a owl:Class ;
    rdfs:subClassOf ontosage:KnowledgeTopic ;
    rdfs:label "Potability statement"@en ;
    rdfs:comment "A published statement about whether water from a given outlet or area is fit to drink, with the responsible owner and the date it was issued. A KnowledgeTopic subclass so the existing capability resolver answers it with no new code."@en .

ontosage:potabilityValue a owl:DatatypeProperty ;
    rdfs:label "potability"@en ;
    rdfs:comment "potable | not_potable | unknown. UNKNOWN is the default and is a legitimate answer: 'nobody has published a statement about this outlet' is honest, whereas assuming either value is a health claim nobody made."@en ;
    rdfs:domain ontosage:PotabilityStatement ; rdfs:range xsd:string .

ontosage:potabilityAuthority a owl:DatatypeProperty ;
    rdfs:label "issuing authority"@en ;
    rdfs:comment "Who published the statement and stands behind it. Required, because a drinkability claim with no owner is exactly the kind of confident unattributable assertion the evidence discipline exists to prevent."@en ;
    rdfs:domain ontosage:PotabilityStatement ; rdfs:range xsd:string .

ontosage:potabilityIssuedOn a owl:DatatypeProperty ;
    rdfs:label "issued on"@en ;
    rdfs:comment "When the statement was published. A potability statement from four years ago describes a plumbing system that may since have been altered."@en ;
    rdfs:domain ontosage:PotabilityStatement ; rdfs:range xsd:date .

ontosage:appliesToOutlet a owl:ObjectProperty ;
    rdfs:label "applies to outlet"@en ;
    rdfs:comment "The amenity, space or floor this statement covers. Scoped rather than building-wide because potability commonly differs between a mains-fed drinking point and a tank-fed tap in the same building."@en ;
    rdfs:domain ontosage:PotabilityStatement .


####################################################################################################
#  Module Q — Waste, recycling and institutional targets  (V6-T43)
#  ------------------------------------------------------------------------------------------------
#  The largest wholly-missing domain found by the category gap sweep, and one this project had
#  already noticed: scripts/ttl_gap_audit.py records the same gap as backlog item P4.
#
#  TWO THINGS ARE MODELLED HERE, AND THE SECOND IS THE LESS OBVIOUS ONE.
#
#  1. Waste points as locatable amenities, so "where are the recycling bins" is answered by the
#     existing capability resolver with no new code, and so a suggestion about level 5 can be
#     answered with what level 5 actually has.
#
#  2. A dated, published TARGET. Questions like "are we on track for our diversion target" are
#     unanswerable without one — and the tempting failure is not refusing them, it is inventing
#     a plausible target and reporting progress against it. A target is an institutional
#     commitment with an owner and a date, so it is authored, cited, and never inferred from
#     the data it is meant to judge.
#
#  CONTAMINATION IS A RATIO, NOT AN ESTIMATE. It is computable only where two streams are
#  separately measured. Where a building weighs general waste alone, the honest answer is that
#  contamination is not measurable here — not a figure derived from one number.

ontosage:WastePoint a owl:Class ;
    rdfs:subClassOf ontosage:Amenity ;
    rdfs:label "Waste or recycling point"@en ;
    rdfs:comment "A bin, cluster of bins or collection point where waste is deposited. An Amenity subclass so the existing capability chain locates it -- 'where are the recycling bins' needs authoring, not engineering."@en .

ontosage:wasteStream a owl:DatatypeProperty ;
    rdfs:label "waste stream"@en ;
    rdfs:comment "general | mixed_recycling | paper | glass | food | WEEE | confidential | batteries. A point may declare several. The stream is what makes a contamination ratio meaningful: without knowing which stream a measurement belongs to, two numbers cannot be compared."@en ;
    rdfs:domain ontosage:WastePoint ; rdfs:range xsd:string ;
    skos:example "\"mixed_recycling\"" .

ontosage:streamCapacityLitres a owl:DatatypeProperty ;
    rdfs:label "stream capacity (L)"@en ;
    rdfs:comment "Nominal capacity of this point for this stream. Needed to turn a fill-level percentage into anything actionable: 80% of a 25 L office bin and 80% of a 1100 L euro-bin are different problems."@en ;
    rdfs:domain ontosage:WastePoint ; rdfs:range xsd:decimal .

#  ── Institutional targets ───────────────────────────────────────────────────────────────────────

ontosage:SustainabilityTarget a owl:Class ;
    rdfs:label "Sustainability target"@en ;
    rdfs:comment "A published institutional commitment against which progress is reported: a diversion rate, a carbon reduction, a consumption ceiling. Authored and cited, NEVER inferred - a target derived from the data it is meant to judge would make every trend look like success or failure by construction."@en ;
    skos:example "\"are we on track for our recycling target?\" -> compare measured diversion against THIS, and say who set it." .

ontosage:targetMetric a owl:DatatypeProperty ;
    rdfs:label "target metric"@en ;
    rdfs:comment "What is being targeted, in the same terms the measurement uses: diversion_rate | carbon_intensity | energy_intensity | water_per_capita | waste_per_capita."@en ;
    rdfs:domain ontosage:SustainabilityTarget ; rdfs:range xsd:string .

ontosage:targetValue a owl:DatatypeProperty ;
    rdfs:label "target value"@en ;
    rdfs:domain ontosage:SustainabilityTarget ; rdfs:range xsd:decimal .

ontosage:targetUnit a owl:DatatypeProperty ;
    rdfs:label "target unit"@en ;
    rdfs:comment "Unit of the target value. Required: a diversion target of 65 means nothing without knowing whether that is a percentage or a tonnage."@en ;
    rdfs:domain ontosage:SustainabilityTarget ; rdfs:range xsd:string .

ontosage:targetDate a owl:DatatypeProperty ;
    rdfs:label "target date"@en ;
    rdfs:comment "When the target is to be met. Progress against an undated target cannot be judged, because 'on track' is a statement about a rate, not a level."@en ;
    rdfs:domain ontosage:SustainabilityTarget ; rdfs:range xsd:date .

ontosage:targetBaselinePeriod a owl:DatatypeProperty ;
    rdfs:label "baseline period"@en ;
    rdfs:comment "The period the target is measured against. A 20% reduction is meaningless without it, and choosing a baseline after the fact is the oldest way to make a number say what you want."@en ;
    rdfs:domain ontosage:SustainabilityTarget ; rdfs:range xsd:string .

ontosage:targetAuthority a owl:DatatypeProperty ;
    rdfs:label "target authority"@en ;
    rdfs:comment "Who set the target and stands behind it. Required for the same reason a potability statement needs an owner: an unattributed commitment cannot be relied on, and cannot be challenged."@en ;
    rdfs:domain ontosage:SustainabilityTarget ; rdfs:range xsd:string .

#  Minted here because the pinned Brick version defines no level or weight sensor class.
#  Following the precedent set by ontosage:Sound_Level_Sensor after BUG-179: a class the
#  vocabulary does not define must be declared in OUR namespace, never invented inside Brick's.
ontosage:Waste_Fill_Sensor a owl:Class ;
    rdfs:subClassOf brick:Sensor ;
    rdfs:label "Waste fill-level sensor"@en ;
    rdfs:comment "Reports how full a waste or recycling receptacle is, as a percentage of its capacity."@en .

ontosage:Waste_Weight_Sensor a owl:Class ;
    rdfs:subClassOf brick:Sensor ;
    rdfs:label "Waste weight sensor"@en ;
    rdfs:comment "Reports the mass of waste in a receptacle or collected from a stream."@en .

####################################################################################################
#  Module R — Systems of record  (V7, the 37 stakeholder catalogues)
#  ------------------------------------------------------------------------------------------------
#  The 37 catalogues name the systems whose records are authoritative for each question — a permit
#  log, a contract, a handover file, a condition survey, a tariff. Brick models the physical fabric
#  and has no vocabulary for any of them, and the questions that need them are a third of the
#  corpus: contracts alone cap 413 questions, handover 257, permits 160, tariffs 119.
#
#  These classes are what a Record Document lifts INTO (docs/RECORD_DOCUMENT_STANDARD.md). The
#  building supplies the instances — as authored TTL, or as a document the indexer lifts — and no
#  code changes for a second building.
#
#  EVERY one of them is an ontosage:IntervalRecord, because every one of them is a claim that is
#  true over a period and not for ever. The catalogues are unanimous on this: preserve effective
#  time, observed or approved time and retrieval time separately — 660 + 3,048 + 2,882 mentions.
#  A permit that expired yesterday and a permit issued this morning are not interchangeable, and a
#  class without a validity period cannot express the difference.
####################################################################################################

ontosage:Permit rdfs:subClassOf ontosage:IntervalRecord ; a owl:Class ;
    rdfs:label "Permit to work"@en ;
    rdfs:comment "An authorisation to carry out controlled work (hot works, roof access, confined space, electrical isolation) for a bounded period in a bounded place. Open or closed is READ from recordStatus, never inferred from the dates: a permit past its end date that was never closed is an exception worth reporting, not a closed permit."@en ;
    skos:example "which permits are open in the basement? -> Permit where recordStatus = open and the location matches." .

ontosage:AccessibleRoute rdfs:subClassOf ontosage:Record ; a owl:Class ;
    rdfs:label "Accessible route"@en ;
    rdfs:comment "A SURVEYED journey between an arrival point and a destination, carrying the facts a disabled visitor actually asks for: entrance, step-free or not, seated rests, how the doors operate, which lift and whether it is in service, how much time to allow, how busy it is, and a non-telephone assistance contact. surveyedOn and surveyedBy are required because every question this answers uses the word 'verified' — a route inferred from geometry is a guess about somebody's journey, and a wrong guess costs them the journey. A route that is NOT step-free is published too, so it is never offered as an accessible option by omission."@en ;
    skos:example "which verified route from the drop-off has seated rests, and how long should I allow? -> AccessibleRoute where routeFrom matches; read seatedRests and allowMinutes." .

ontosage:AccessPermission rdfs:subClassOf ontosage:IntervalRecord ; a owl:Class ;
    rdfs:label "Access permission group"@en ;
    rdfs:comment "A named grant over one controlled opening to a ROLE TEMPLATE, under a time profile, with its inheritance and overrides recorded as data. NO INDIVIDUAL IS MODELLED, deliberately: V7-T35 holds identity at role level and the catalogues forbid exposing who holds what, so 'which entitlements does this role justify' is answerable and 'who can open this door' is not. Added because access_control read DATA on seven instances that were all physical readers, while 277 questions asked about the management layer the ontology did not hold."@en ;
    skos:example "which permission group controls this opening, and through which inherited paths? -> AccessPermission where controlsOpening matches, then follow inheritsFrom." .

ontosage:PublicEvent rdfs:subClassOf ontosage:IntervalRecord ; a owl:Class ;
    rdfs:label "Public event"@en ;
    rdfs:comment "A published, visitor-facing arrangement over a space: admission times, entrance, registration policy and change history. DISTINCT FROM ontosage:Booking, which is a room held for a period — a booking can move without the published event changing, and that disagreement is precisely what a visitor asking 'has the venue changed since my invitation' needs reported. Added after the stakeholder capture measured visitors and event attendees at 16% computed with 59 questions unanswered."@en ;
    skos:example "which entrance should visitors use tomorrow evening? -> PublicEvent on that date, read visitorEntrance and doorsOpenAt." .

ontosage:CleaningTask rdfs:subClassOf ontosage:Record ; a owl:Class ;
    rdfs:label "Cleaning task"@en ;
    rdfs:comment "One unit of cleaning work: a zone, an area within it, the standard that applies, how often it recurs, the shift that owns it and the time the area must be ready. Added after the 2,480-question stakeholder capture measured the cleaning and caretaking team at 19% computed with 63 questions unanswered — the building described cleaning only as prose, so nothing could be counted, filtered or handed over. Status is READ from the register, never inferred from dates: a caretaker sent to a suspended area wastes a shift, and a suspended area silently omitted is worse."@en ;
    skos:example "what is my zone and task list for this shift? -> CleaningTask where shiftName matches and recordStatus is not suspended." .

ontosage:Contract rdfs:subClassOf ontosage:IntervalRecord ; a owl:Class ;
    rdfs:label "Contract"@en ;
    rdfs:comment "A service, maintenance or supply agreement with a provider, over a term, covering a named scope. Distinct from Warranty: a contract is bought, a warranty accompanies an asset — they have different owners and routinely disagree, which the catalogues want REPORTED rather than resolved."@en ;
    skos:example "who maintains the lifts and until when? -> Contract whose coveredScope names the lift asset." .

ontosage:Warranty rdfs:subClassOf ontosage:IntervalRecord ; a owl:Class ;
    rdfs:label "Warranty"@en ;
    rdfs:comment "A manufacturer or installer guarantee attached to a specific asset for a period. Changes the correct answer to a maintenance question — whether the work is chargeable — which no routing fix can recover if the warranty is not modelled."@en ;
    skos:example "is the AHU still under warranty? -> Warranty where coversAsset is the AHU and now falls within the interval." .

ontosage:HandoverRecord rdfs:subClassOf ontosage:IntervalRecord ; a owl:Class ;
    rdfs:label "Handover record"@en ;
    rdfs:comment "A project handover, as-built revision, commissioning certificate or O and M manual, linked to the assets it describes. This is what a claim of commissioned must REST on: the five-part verification gate reads it, so a commissioning state with no handover record behind it is unverified by construction."@en ;
    skos:example "which plant has no O and M manual? -> brick:Equipment with no HandoverRecord describing it." .

ontosage:ConditionSurvey rdfs:subClassOf ontosage:IntervalRecord ; a owl:Class ;
    rdfs:label "Condition survey"@en ;
    rdfs:comment "A dated inspection recording an asset condition grade and remaining life. Brick models what an asset IS and where it sits; it has no vocabulary for how worn it is, which is the clearest case in the whole corpus for extending OCBV rather than forcing Brick to carry it."@en ;
    skos:example "which assets are beyond expected life? -> ConditionSurvey where remainingLifeYears is at most zero." .

ontosage:CompetencyRecord rdfs:subClassOf ontosage:IntervalRecord ; a owl:Class ;
    rdfs:label "Competency requirement"@en ;
    rdfs:comment "A training, induction or authorisation requirement attached to a ROLE and an area or task — deliberately never to a person. The catalogues ask what a restricted area requires and forbid exposing who holds what, so the answerable form is: this area requires these competencies. No building TTL carries personal training records."@en ;
    skos:example "what competency does the plant room require? -> CompetencyRecord whose appliesToArea is the plant room." .

ontosage:RiskAssessment rdfs:subClassOf ontosage:IntervalRecord ; a owl:Class ;
    rdfs:label "Risk assessment"@en ;
    rdfs:comment "A dated assessment of a hazard in a place or activity, with its review date. Overdue is computed from dueDate, exactly as ComplianceCheck does."@en ;
    skos:example "which risk assessments are past review? -> RiskAssessment where dueDate is before now." .

ontosage:Tariff rdfs:subClassOf ontosage:IntervalRecord ; a owl:Class ;
    rdfs:label "Energy tariff"@en ;
    rdfs:comment "A registered unit rate and standing charge for a utility, valid over a period, from a named authority. Cost is computed ONLY when one of these exists. An invented unit rate produces a confident wrong number, which is the failure mode this project guards against hardest — so with no Tariff the honest answer is a decline that names the missing source."@en ;
    skos:example "what did floor 5 cost to heat last month? -> submeter kWh times Tariff unitRate, or decline naming the absent tariff." .

####################################################################################################
#  Module R.2 — Record provenance: owner, version, and the three times
#  ------------------------------------------------------------------------------------------------
#  Owner is the single most frequent demand in the whole corpus — 13,964 occurrences, ahead of
#  permission (6,176) and conflict (5,437). The catalogues never ask the building to DECIDE; they
#  ask it to say whose record it is and to defer to that owner. An answer that cannot name the
#  owner cannot be acted on, because the reader does not know who to go to.
####################################################################################################

ontosage:recordOwner a owl:DatatypeProperty ;
    rdfs:domain ontosage:IntervalRecord ; rdfs:range xsd:string ;
    rdfs:label "record owner"@en ;
    rdfs:comment "The accountable owner of this record — a role or team, not a person. Named in every answer that rests on it, so the reader knows who to defer to."@en .

ontosage:owningAuthority a owl:DatatypeProperty ;
    rdfs:domain ontosage:IntervalRecord ; rdfs:range xsd:string ;
    rdfs:label "owning authority"@en ;
    rdfs:comment "The organisation whose system of record this is (Estates, HR, the maintainer). Distinct from recordOwner, which is the accountable role inside it."@en .

ontosage:recordVersion a owl:DatatypeProperty ;
    rdfs:domain ontosage:IntervalRecord ; rdfs:range xsd:string ;
    rdfs:label "record version"@en ;
    rdfs:comment "The version or revision this fact was read from. Without it a superseded record and its replacement are indistinguishable in the evidence record, and an answer cannot be reproduced against what it actually used."@en .

ontosage:retrievedAt a owl:DatatypeProperty ;
    rdfs:domain ontosage:IntervalRecord ; rdfs:range xsd:dateTime ;
    rdfs:label "retrieved at"@en ;
    rdfs:comment "When the service obtained the record. The THIRD time, kept separate from effectiveFrom (when it applies) and statusObservedAt (when it was observed). Retrieval time never substitutes for either — a record fetched now may have taken effect last year or take effect next Monday."@en .

ontosage:supersedes a owl:ObjectProperty ;
    rdfs:domain ontosage:IntervalRecord ; rdfs:range ontosage:IntervalRecord ;
    rdfs:label "supersedes"@en ;
    rdfs:comment "This record replaces an earlier one. Both are retained: the catalogues require conflicting originals to be preserved for the accountable owner rather than silently resolved."@en .

ontosage:currencyThresholdDays a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "currency threshold (days)"@en ;
    rdfs:comment "How long a record of this class stays current, set by its owner. Staleness is decision-specific: a CO2 reading is stale in minutes, an asbestos survey in years. One global freshness rule must either call a valid survey stale or let an hours-old reading pass as current."@en .

ontosage:derivedFromDocument a owl:DatatypeProperty ;
    rdfs:domain ontosage:IntervalRecord ; rdfs:range xsd:string ;
    rdfs:label "derived from document"@en ;
    rdfs:comment "Set on every fact LIFTED from a record document. A document is a statement ABOUT a system of record, not the record itself, so these rank below authored TTL in precedence — without the marker a stale Markdown table silently outranks a live register, which is exactly what BUG-194 was."@en .

ontosage:liftedByMapping a owl:DatatypeProperty ;
    rdfs:domain ontosage:IntervalRecord ; rdfs:range xsd:string ;
    rdfs:label "lifted by mapping"@en ;
    rdfs:comment "The record-document mapping that produced this fact, so a wrong value can be traced to the rule that made it rather than only to the document."@en .

####################################################################################################
#  Module R.3 — Record fields the catalogues ask about by name
####################################################################################################

ontosage:routeFrom a owl:DatatypeProperty ;
    rdfs:domain ontosage:AccessibleRoute ; rdfs:range xsd:string ;
    rdfs:label "route from"@en .

ontosage:routeTo a owl:DatatypeProperty ;
    rdfs:domain ontosage:AccessibleRoute ; rdfs:range xsd:string ;
    rdfs:label "route to"@en .

ontosage:isStepFree a owl:DatatypeProperty ;
    rdfs:domain ontosage:AccessibleRoute ; rdfs:range xsd:boolean ;
    rdfs:label "is step free"@en ;
    rdfs:comment "False is recorded, not omitted: a route missing from the register is unknown, while a route marked false is known to be unsuitable, and an answer must be able to tell those apart."@en .

ontosage:seatedRests a owl:DatatypeProperty ;
    rdfs:domain ontosage:AccessibleRoute ; rdfs:range xsd:integer ;
    rdfs:label "seated rests"@en ;
    rdfs:comment "How many places to sit along the route. Asked directly by visitors who need regular rests."@en .

ontosage:doorOperation a owl:DatatypeProperty ;
    rdfs:domain ontosage:AccessibleRoute ; rdfs:range xsd:string ;
    rdfs:label "door operation"@en ;
    rdfs:comment "Automatic, assisted or manual, PER ROUTE — a step-free route can still carry a heavy manual door, which is the difference between usable and not."@en .

ontosage:servedByLift a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "served by lift"@en .

ontosage:liftStatus a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "lift status"@en .

ontosage:routeDistanceMetres a owl:DatatypeProperty ;
    rdfs:domain ontosage:AccessibleRoute ; rdfs:range xsd:integer ;
    rdfs:label "route distance in metres"@en .

ontosage:allowMinutes a owl:DatatypeProperty ;
    rdfs:domain ontosage:AccessibleRoute ; rdfs:range xsd:integer ;
    rdfs:label "allow minutes"@en ;
    rdfs:comment "Time to ALLOW, including doors, lifts, waiting and check-in — not walking time, because 'how long should I allow' is the question actually asked."@en .

ontosage:sensoryLevel a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "sensory level"@en ;
    rdfs:comment "How busy and stimulating the route is, so a lower-stimulation arrival can be offered."@en .

ontosage:assistanceContact a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "assistance contact"@en ;
    rdfs:comment "A non-telephone arrival contact. The catalogues ask for text-based options explicitly."@en .

ontosage:surveyedOn a owl:DatatypeProperty ; rdfs:range xsd:date ;
    rdfs:label "surveyed on"@en .

ontosage:surveyedBy a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "surveyed by"@en .

ontosage:controlsOpening a owl:DatatypeProperty ;
    rdfs:domain ontosage:AccessPermission ; rdfs:range xsd:string ;
    rdfs:label "controls opening"@en ;
    rdfs:comment "The controlled door, gate or turnstile this grant applies to."@en .

ontosage:grantedToRole a owl:DatatypeProperty ;
    rdfs:domain ontosage:AccessPermission ; rdfs:range xsd:string ;
    rdfs:label "granted to role"@en ;
    rdfs:comment "The role template a grant is made to. Never a person."@en .

ontosage:inheritsFrom a owl:DatatypeProperty ;
    rdfs:domain ontosage:AccessPermission ; rdfs:range xsd:string ;
    rdfs:label "inherits from"@en ;
    rdfs:comment "The parent group whose grant this one extends. Empty means the group stands alone; the chain is data so an inherited path can be reported rather than described."@en .

ontosage:timeProfile a owl:DatatypeProperty ;
    rdfs:domain ontosage:AccessPermission ; rdfs:range xsd:string ;
    rdfs:label "time profile"@en .

ontosage:overriddenBy a owl:DatatypeProperty ;
    rdfs:domain ontosage:AccessPermission ; rdfs:range xsd:string ;
    rdfs:label "overridden by"@en ;
    rdfs:comment "Global modes or controller rules that supersede the time profile. Recorded on the row they override, because that is where someone checking the group will look."@en .

ontosage:approvalRoute a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "approval route"@en ;
    rdfs:comment "Who must approve a grant, so 'does this need a formal exception' is answerable from the register rather than from memory."@en .

ontosage:startsAt a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "starts at"@en .

ontosage:endsAt a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "ends at"@en .

ontosage:doorsOpenAt a owl:DatatypeProperty ;
    rdfs:domain ontosage:PublicEvent ; rdfs:range xsd:string ;
    rdfs:label "doors open at"@en ;
    rdfs:comment "When a visitor may enter, which is earlier than the start and is the time they actually need."@en .

ontosage:checkInFrom a owl:DatatypeProperty ;
    rdfs:domain ontosage:PublicEvent ; rdfs:range xsd:string ;
    rdfs:label "check-in from"@en .

ontosage:visitorEntrance a owl:DatatypeProperty ;
    rdfs:domain ontosage:PublicEvent ; rdfs:range xsd:string ;
    rdfs:label "visitor entrance"@en ;
    rdfs:comment "The entrance a visitor should use, which is not always the one nearest the venue."@en .

ontosage:registrationPolicy a owl:DatatypeProperty ;
    rdfs:domain ontosage:PublicEvent ; rdfs:range xsd:string ;
    rdfs:label "registration policy"@en .

ontosage:companionPolicy a owl:DatatypeProperty ;
    rdfs:domain ontosage:PublicEvent ; rdfs:range xsd:string ;
    rdfs:label "companion policy"@en ;
    rdfs:comment "Whether a companion or support person may attend, and whether they register separately. Asked directly by the accessibility catalogues."@en .

ontosage:accessibilityNote a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "accessibility note"@en .

ontosage:previousLocationText a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "previous location"@en ;
    rdfs:comment "Where a record used to be. ABSENT means the register records no move — not that nothing changed, and an answer must say which."@en .

ontosage:cleaningZone a owl:DatatypeProperty ;
    rdfs:domain ontosage:CleaningTask ; rdfs:range xsd:string ;
    rdfs:label "cleaning zone"@en ;
    rdfs:comment "The named division of the building a shift is responsible for."@en .

ontosage:cleaningStandard a owl:DatatypeProperty ;
    rdfs:domain ontosage:CleaningTask ; rdfs:range xsd:string ;
    rdfs:label "cleaning standard"@en ;
    rdfs:comment "The specification applied on a visit — enhanced, standard, presentation or light. Distinct from frequency: a room may be cleaned daily to a light standard."@en .

ontosage:serviceFrequency a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "service frequency"@en ;
    rdfs:comment "How often a recurring task falls due, in the register's own words."@en .

ontosage:shiftName a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "shift"@en ;
    rdfs:comment "The working period that owns a task."@en .

ontosage:readyBy a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "ready by"@en ;
    rdfs:comment "The time an area must be released for use. A service commitment, so a task still open past it is an exception to report rather than a task running late."@en .

ontosage:expectedMinutes a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "expected minutes"@en ;
    rdfs:comment "Planned duration, so a shift's workload can be summed against the hours available."@en .

ontosage:lastCompleted a owl:DatatypeProperty ;
    rdfs:range xsd:date ;
    rdfs:label "last completed"@en .

ontosage:nextDue a owl:DatatypeProperty ;
    rdfs:range xsd:date ;
    rdfs:label "next due"@en .

ontosage:permitKind a owl:DatatypeProperty ;
    rdfs:domain ontosage:Permit ; rdfs:range xsd:string ;
    rdfs:label "permit kind"@en ;
    rdfs:comment "Hot works, roof access, confined space, electrical isolation, work at height."@en .

ontosage:coveredScope a owl:DatatypeProperty ;
    rdfs:domain ontosage:IntervalRecord ; rdfs:range xsd:string ;
    rdfs:label "covered scope"@en ;
    rdfs:comment "What a contract or warranty covers, in the words of its owner."@en .

ontosage:providerName a owl:DatatypeProperty ;
    rdfs:domain ontosage:IntervalRecord ; rdfs:range xsd:string ;
    rdfs:label "provider"@en ;
    rdfs:comment "The supplier, maintainer or issuing body."@en .

ontosage:coversAsset a owl:ObjectProperty ;
    rdfs:domain ontosage:IntervalRecord ; rdfs:range brick:Equipment ;
    rdfs:label "covers asset"@en ;
    rdfs:comment "The equipment a warranty, contract, handover record or condition survey concerns."@en .

ontosage:conditionGrade a owl:DatatypeProperty ;
    rdfs:domain ontosage:ConditionSurvey ; rdfs:range xsd:string ;
    rdfs:label "condition grade"@en ;
    rdfs:comment "The grade recorded by the surveyor (A good, B satisfactory, C poor, D end of life), kept verbatim and never re-derived."@en .

ontosage:remainingLifeYears a owl:DatatypeProperty ;
    rdfs:domain ontosage:ConditionSurvey ; rdfs:range xsd:decimal ;
    rdfs:label "remaining life (years)"@en ;
    rdfs:comment "Expected remaining life at the survey date, in years. An ESTIMATE by the surveyor, so an answer using it is calculated, never observed. ZERO OR LESS means the asset is at or beyond its expected life: a question about assets beyond expected life must use <= 0, not = 0, or an asset already past its life is left out of its own answer."@en .

ontosage:appliesToArea a owl:ObjectProperty ;
    rdfs:domain ontosage:CompetencyRecord ; rdfs:range brick:Location ;
    rdfs:label "applies to area"@en ;
    rdfs:comment "The restricted area or space a competency is required for."@en .

ontosage:unitRate a owl:DatatypeProperty ;
    rdfs:domain ontosage:Tariff ; rdfs:range xsd:decimal ;
    rdfs:label "unit rate"@en ;
    rdfs:comment "Cost per unit (per kWh, per cubic metre). Only ever read from a registered Tariff — never defaulted, never assumed."@en .

ontosage:standingCharge a owl:DatatypeProperty ;
    rdfs:domain ontosage:Tariff ; rdfs:range xsd:decimal ;
    rdfs:label "standing charge"@en ;
    rdfs:comment "Fixed daily charge, independent of consumption."@en .

ontosage:currencyCode a owl:DatatypeProperty ;
    rdfs:domain ontosage:Tariff ; rdfs:range xsd:string ;
    rdfs:label "currency"@en ;
    rdfs:comment "ISO currency code. Stated in every cost answer — a bare number is ambiguous across buildings."@en .

ontosage:utilityKind a owl:DatatypeProperty ;
    rdfs:domain ontosage:Tariff ; rdfs:range xsd:string ;
    rdfs:label "utility"@en ;
    rdfs:comment "Electricity, gas, water, heat."@en .

ontosage:bookedByRole a owl:DatatypeProperty ;
    rdfs:domain ontosage:Booking ; rdfs:range xsd:string ;
    rdfs:label "booked by role"@en ;
    rdfs:comment "The organising ROLE or team. Never a named individual: the catalogues limit person-level detail to an authorised case, and an availability question does not need one."@en .

ontosage:expectedAttendees a owl:DatatypeProperty ;
    rdfs:domain ontosage:Booking ; rdfs:range xsd:integer ;
    rdfs:label "expected attendees"@en ;
    rdfs:comment "The group size the booking was made for, used for capacity and turnaround checks."@en .

ontosage:recordId a owl:DatatypeProperty ;
    rdfs:domain ontosage:IntervalRecord ; rdfs:range xsd:string ;
    rdfs:label "record id"@en ;
    rdfs:comment "The identifier this record carries in its own system of record (PTW-2026-0412, a contract number, a survey reference). Quoted back in answers so a reader can find the original, and used as the stable IRI slot so re-ingesting a document updates a record rather than duplicating it."@en .

####################################################################################################
#  Module R.4 — Lay terms for the record classes
#  ------------------------------------------------------------------------------------------------
#  A class name is not the word a person uses. "Which assets are beyond their expected life?" is a
#  condition-survey question and contains neither "condition" nor "survey"; measured live, it
#  reached a generic equipment inventory instead. Deriving the vocabulary from the class name alone
#  is not enough, and a synonym list in Python would be a building literal by another route.
#
#  So the ontology declares them, exactly as ontosage:Amenity and ontosage:KnowledgeTopic already
#  do. A building that uses different words adds them here; the router reads whatever is declared
#  and no code changes.
####################################################################################################

ontosage:AccessibleRoute ontosage:layTerms "accessible route", "step free", "step-free",
    "wheelchair", "wheelchair access", "accessible entrance", "level access", "ramp",
    "seated rest", "somewhere to sit", "how long should i allow", "assistance",
    "assistance dog", "carer", "personal assistant", "low vision", "quiet route",
    "lower stimulation", "heavy door", "which lift", "mobility", "accessibility" .

ontosage:AccessPermission ontosage:layTerms "access", "access control", "permission",
    "permissions", "permission group", "entitlement", "entitlements", "card access",
    "door access", "who can get in", "access rights", "swipe", "badge", "credential",
    "time profile", "lockdown", "escorted access", "access request" .

ontosage:PublicEvent ontosage:layTerms "event", "events", "seminar", "lecture", "open day",
    "showcase", "visitor", "visitors", "attending", "check in", "check-in", "doors open",
    "which entrance", "companion", "support person", "registration", "ticket",
    "has the venue changed", "what time should i arrive" .

ontosage:CleaningTask ontosage:layTerms "cleaning", "clean", "cleaner", "caretaker",
    "caretaking", "janitorial", "housekeeping", "my zone", "my round", "task list",
    "cleaning schedule", "cleaning standard", "which rooms must be ready", "my shift" .

ontosage:Permit ontosage:layTerms "permit", "permits", "permit to work", "ptw", "hot works permit",
    "roof access permit", "work authorisation", "isolation permit" .

ontosage:Contract ontosage:layTerms "contract", "contracts", "agreement", "agreements",
    "service agreement", "maintenance contract", "supplier", "framework" .

ontosage:Warranty ontosage:layTerms "warranty", "warranties", "guarantee", "guarantees",
    "under warranty", "in warranty", "defects liability" .

ontosage:HandoverRecord ontosage:layTerms "handover", "handovers", "o&m manual", "o and m manual",
    "operating manual", "as-built", "as built", "commissioning certificate", "project record" .

ontosage:ConditionSurvey ontosage:layTerms "condition survey", "condition", "asset condition",
    "expected life", "remaining life", "beyond life", "life expired", "end of life",
    "replacement programme", "backlog", "dilapidation" .

ontosage:CompetencyRecord ontosage:layTerms "competency", "competencies", "competence",
    "training requirement", "induction", "authorisation", "authorised person", "qualification" .

ontosage:RiskAssessment ontosage:layTerms "risk assessment", "risk assessments", "risk register",
    "hazard assessment", "ra review", "assessment review" .

# Found by tests/test_record_registers_are_well_formed.py: this class holds 5 instances
# (V7-T38) and had no lay terms, so no question could route to it. A register that is
# populated and unreachable is indistinguishable from one that was never built.
ontosage:SustainabilityTarget ontosage:layTerms "sustainability target",
    "sustainability targets", "carbon target", "carbon", "net zero", "emissions",
    "emissions target", "energy reduction", "reduction target", "scope 1", "scope 2",
    "environmental target", "are we on track", "sustainability commitment" .

ontosage:Tariff ontosage:layTerms "tariff", "tariffs", "unit rate", "standing charge",
    "energy price", "energy cost", "cost per kwh", "utility rate" .

ontosage:Booking ontosage:layTerms "booking", "bookings", "reservation", "reservations",
    "room booking", "booked", "who has booked" .

# Lay terms for the three record classes that had none.
#
# Nothing is derived from part of a class name any more, so a class without declared lay
# terms is reachable only by its full label. These were the three, and ComplianceCheck
# holds 82 instances — the largest register in the building.
ontosage:ComplianceCheck ontosage:layTerms "compliance check", "compliance checks",
    "compliance", "statutory check", "statutory checks", "inspection", "inspections",
    "test due", "overdue check", "certificate" .

ontosage:WorkOrder ontosage:layTerms "work order", "work orders", "job", "jobs",
    "maintenance job", "reactive job", "ticket", "tickets" .

ontosage:TimetabledSession ontosage:layTerms "timetabled session", "timetabled sessions",
    "timetable", "scheduled class", "scheduled classes", "teaching session",
    "teaching sessions", "lecture", "lectures" .
