@prefix rec: <https://w3id.org/rec#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix bldg: <http://abacwsbuilding.cardiff.ac.uk/abacws#> .
@prefix ref: <https://brickschema.org/schema/Brick/ref#> .
@prefix ashrae: <http://data.ashrae.org/standard223#> .
@base <http://abacwsbuilding.cardiff.ac.uk/abacws#> .

# ============================================================
# Abacws Building Ontology - Enhancements
# Adds: zone types, building hierarchy, room-zone mapping,
#        equipment instances, zone adjacency
# ============================================================


# ============================================================
# TODO 1 + TODO 2: brick:Building type for Abacws
#                  rdf:type brick:HVAC_Zone for all Zone_5.XX
# ============================================================

bldg:Abacws a brick:Building ;
    rdfs:label "Abacws Building"@en ;
    rdfs:comment "Abacws Building, Cardiff University - School of Computer Science and Informatics" .

bldg:Zone_5.01 a owl:NamedIndividual , brick:HVAC_Zone ;
    rdfs:label "Sensor Node Zone 5.01"@en .

