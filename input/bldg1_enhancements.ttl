# Directional zones are also parts of Floor5
bldg:east-Zone a brick:HVAC_Zone ;
    rdfs:label "East Wing Zone (Floor 5)"@en ;
    brick:isPartOf bldg:Floor5 .

bldg:north-east-Zone a brick:HVAC_Zone ;
    rdfs:label "North-East Wing Zone (Floor 5)"@en ;
    brick:isPartOf bldg:Floor5 .

bldg:north-west-Zone a brick:HVAC_Zone ;
    rdfs:label "North-West Wing Zone (Floor 5)"@en ;
    brick:isPartOf bldg:Floor5 .

bldg:south-Zone a brick:HVAC_Zone ;
    rdfs:label "South Wing Zone (Floor 5)"@en ;
    brick:isPartOf bldg:Floor5 .

bldg:south-east-Zone a brick:HVAC_Zone ;
    rdfs:label "South-East Wing Zone (Floor 5)"@en ;
    brick:isPartOf bldg:Floor5 .

bldg:west-Zone a brick:HVAC_Zone ;
    rdfs:label "West Wing Zone (Floor 5)"@en ;
    brick:isPartOf bldg:Floor5 .


