                bldg:Zone_5.21 ,
                bldg:Zone_5.23 ,
                bldg:Zone_5.30 .

bldg:Air_Temperature_Sensor_5.18 brick:isPointOf bldg:VAV_Floor5_NorthEast .
bldg:Air_Temperature_Sensor_5.20 brick:isPointOf bldg:VAV_Floor5_NorthEast .
bldg:Air_Temperature_Sensor_5.21 brick:isPointOf bldg:VAV_Floor5_NorthEast .
