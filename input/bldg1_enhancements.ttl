# ============================================================
# TODO 5: Equipment instances
# Air Handling Units per floor + VAV boxes + meters
# ============================================================

# --- Building-level electricity meter ---
bldg:Electric_Meter_Abacws a owl:NamedIndividual ,
        brick:Building_Electrical_Meter ;
    rdfs:label "Abacws Building Electricity Meter"@en ;
    brick:isPointOf bldg:Abacws ;
    brick:hasLocation bldg:Abacws .

# --- Floor-level electricity sub-meters ---
bldg:Electric_Meter_Floor0 a owl:NamedIndividual , brick:Electrical_Meter ;
    rdfs:label "Floor 0 Electricity Sub-Meter"@en ;
    brick:isPointOf bldg:Floor0 ;
    brick:hasLocation bldg:Floor0 .

bldg:Electric_Meter_Floor1 a owl:NamedIndividual , brick:Electrical_Meter ;
    rdfs:label "Floor 1 Electricity Sub-Meter"@en ;
    brick:isPointOf bldg:Floor1 ;
    brick:hasLocation bldg:Floor1 .

bldg:Electric_Meter_Floor2 a owl:NamedIndividual , brick:Electrical_Meter ;
    rdfs:label "Floor 2 Electricity Sub-Meter"@en ;
    brick:isPointOf bldg:Floor2 ;
    brick:hasLocation bldg:Floor2 .

bldg:Electric_Meter_Floor3 a owl:NamedIndividual , brick:Electrical_Meter ;
    rdfs:label "Floor 3 Electricity Sub-Meter"@en ;
    brick:isPointOf bldg:Floor3 ;
    brick:hasLocation bldg:Floor3 .

bldg:Electric_Meter_Floor4 a owl:NamedIndividual , brick:Electrical_Meter ;
    rdfs:label "Floor 4 Electricity Sub-Meter"@en ;
    brick:isPointOf bldg:Floor4 ;
    brick:hasLocation bldg:Floor4 .

bldg:Electric_Meter_Floor5 a owl:NamedIndividual , brick:Electrical_Meter ;
    rdfs:label "Floor 5 Electricity Sub-Meter"@en ;
    brick:isPointOf bldg:Floor5 ;
    brick:hasLocation bldg:Floor5 .

# --- Air Handling Units (one per floor) ---
bldg:AHU_Floor0 a owl:NamedIndividual , brick:Air_Handler_Unit ;
    rdfs:label "Air Handling Unit Floor 0"@en ;
    brick:hasLocation bldg:Floor0 ;
    brick:feeds bldg:Floor0 .

bldg:AHU_Floor1 a owl:NamedIndividual , brick:Air_Handler_Unit ;
    rdfs:label "Air Handling Unit Floor 1"@en ;
    brick:hasLocation bldg:Floor1 ;
    brick:feeds bldg:Floor1 .

bldg:AHU_Floor2 a owl:NamedIndividual , brick:Air_Handler_Unit ;
    rdfs:label "Air Handling Unit Floor 2"@en ;
    brick:hasLocation bldg:Floor2 ;
    brick:feeds bldg:Floor2 .

bldg:AHU_Floor3 a owl:NamedIndividual , brick:Air_Handler_Unit ;
    rdfs:label "Air Handling Unit Floor 3"@en ;
    brick:hasLocation bldg:Floor3 ;
    brick:feeds bldg:Floor3 .

bldg:AHU_Floor4 a owl:NamedIndividual , brick:Air_Handler_Unit ;
    rdfs:label "Air Handling Unit Floor 4"@en ;
    brick:hasLocation bldg:Floor4 ;
    brick:feeds bldg:Floor4 .

bldg:AHU_Floor5 a owl:NamedIndividual , brick:Air_Handler_Unit ;
    rdfs:label "Air Handling Unit Floor 5"@en ;
    brick:hasLocation bldg:Floor5 ;
    brick:feeds bldg:VAV_Floor5_East ,
                bldg:VAV_Floor5_NorthEast ,
                bldg:VAV_Floor5_NorthWest ,
                bldg:VAV_Floor5_South ,
                bldg:VAV_Floor5_SouthEast ,
                bldg:VAV_Floor5_West .

# --- VAV boxes per directional zone on Floor 5 ---
# East wing: zones 5.04, 5.05, 5.25, 5.28
bldg:VAV_Floor5_East a owl:NamedIndividual , brick:VAV ;
    rdfs:label "VAV Box Floor 5 East Wing"@en ;
    brick:hasLocation bldg:east-Zone ;
    brick:isFedBy bldg:AHU_Floor5 ;
    brick:feeds bldg:Zone_5.04 ,
                bldg:Zone_5.05 ,
                bldg:Zone_5.25 ,
                bldg:Zone_5.28 .

bldg:Air_Temperature_Sensor_5.04 brick:isPointOf bldg:VAV_Floor5_East .
bldg:Air_Temperature_Sensor_5.05 brick:isPointOf bldg:VAV_Floor5_East .
bldg:Air_Temperature_Sensor_5.25 brick:isPointOf bldg:VAV_Floor5_East .
bldg:Air_Temperature_Sensor_5.28 brick:isPointOf bldg:VAV_Floor5_East .

# North-East wing: zones 5.18, 5.20, 5.21, 5.23, 5.30
bldg:VAV_Floor5_NorthEast a owl:NamedIndividual , brick:VAV ;
