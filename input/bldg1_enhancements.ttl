# ============================================================
# TODO 3: Building → Floor → Zone hierarchy
# ============================================================

# --- Building type already set above ---
# Add floors as parts of the building
bldg:Abacws brick:hasPart bldg:Floor0 ,
                           bldg:Floor1 ,
                           bldg:Floor2 ,
                           bldg:Floor3 ,
                           bldg:Floor4 ,
                           bldg:Floor5 .

# --- Floor types and isPartOf ---
bldg:Floor0 a brick:Floor ;
    rdfs:label "Floor 0 (Ground Floor)"@en ;
    brick:isPartOf bldg:Abacws .

bldg:Floor1 a brick:Floor ;
    rdfs:label "Floor 1"@en ;
    brick:isPartOf bldg:Abacws .

bldg:Floor2 a brick:Floor ;
    rdfs:label "Floor 2"@en ;
    brick:isPartOf bldg:Abacws .

bldg:Floor3 a brick:Floor ;
    rdfs:label "Floor 3"@en ;
    brick:isPartOf bldg:Abacws .

bldg:Floor4 a brick:Floor ;
    rdfs:label "Floor 4"@en ;
    brick:isPartOf bldg:Abacws .

bldg:Floor5 a brick:Floor ;
    rdfs:label "Floor 5 (Top Floor)"@en ;
    brick:isPartOf bldg:Abacws ;
    brick:hasPart bldg:Zone_5.01 ,
                  bldg:Zone_5.02 ,
                  bldg:Zone_5.03 ,
                  bldg:Zone_5.04 ,
                  bldg:Zone_5.05 ,
                  bldg:Zone_5.06 ,
                  bldg:Zone_5.07 ,
                  bldg:Zone_5.08 ,
                  bldg:Zone_5.09 ,
                  bldg:Zone_5.10 ,
                  bldg:Zone_5.11 ,
                  bldg:Zone_5.12 ,
                  bldg:Zone_5.13 ,
                  bldg:Zone_5.14 ,
                  bldg:Zone_5.15 ,
                  bldg:Zone_5.16 ,
                  bldg:Zone_5.17 ,
                  bldg:Zone_5.18 ,
                  bldg:Zone_5.19 ,
                  bldg:Zone_5.20 ,
                  bldg:Zone_5.21 ,
                  bldg:Zone_5.22 ,
                  bldg:Zone_5.23 ,
                  bldg:Zone_5.24 ,
                  bldg:Zone_5.25 ,
                  bldg:Zone_5.26 ,
                  bldg:Zone_5.27 ,
                  bldg:Zone_5.28 ,
                  bldg:Zone_5.29 ,
                  bldg:Zone_5.30 ,
                  bldg:Zone_5.31 ,
                  bldg:Zone_5.32 ,
                  bldg:Zone_5.33 ,
                  bldg:Zone_5.34 .

# Zones are parts of Floor5
bldg:Zone_5.01 brick:isPartOf bldg:Floor5 .
bldg:Zone_5.02 brick:isPartOf bldg:Floor5 .
bldg:Zone_5.03 brick:isPartOf bldg:Floor5 .
bldg:Zone_5.04 brick:isPartOf bldg:Floor5 .
