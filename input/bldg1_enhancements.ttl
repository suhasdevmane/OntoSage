# =============================================================================
# Abacws Building — P1-P4 Gap-Filling Triples  (Brick v1.4 A-Box)
#
# Covers all priority gaps from scripts/outputs/ttl_gap_analysis.md.
# Load alongside bldg1_expanded_protege_clean.ttl and bldg1_abacws_metadata.ttl
# in the same GraphDB repository (ontosage).
#
# NOTE ON TIMESERIES UUIDs
#   UUIDs of the form "00000000-XXXX-..." are PLACEHOLDERS.
#   Replace with real MySQL UUIDs once the corresponding sensor data is
#   loaded into the database.  Existing Floor-5 sensors in
#   bldg1_expanded_protege_clean.ttl use the real UUID series starting at
#   26f2c139-...  New sensors here use the 00000000- prefix to distinguish
#   them at a glance.
# =============================================================================

@prefix brick:   <https://brickschema.org/schema/Brick#> .
@prefix bldg:    <http://abacwsbuilding.cardiff.ac.uk/abacws#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix ref:     <https://brickschema.org/schema/Brick/ref#> .
@prefix ashrae:  <http://data.ashrae.org/standard223#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <http://abacwsbuilding.cardiff.ac.uk/abacws#> .

# ---------------------------------------------------------------------------
# Ontology header
# ---------------------------------------------------------------------------

bldg:AbacwsEnhancementsOntology
    rdf:type owl:Ontology ;
    rdfs:label "Abacws Building Enhancements — P1-P4 Gap Filling" ;
    rdfs:comment "Adds access control, occupancy, sub-metering, water, EV, fire safety, PV, carbon, waste, lighting-CCT, and green-roof triples to answer all survey/pipeline questions classified as GENERIC or DECLINED." ;
    owl:imports <https://brickschema.org/schema/1.4/Brick> ;
    dcterms:created "2026-04-25"^^xsd:date ;
    owl:versionInfo "1.0" .

# ---------------------------------------------------------------------------
# Custom annotation properties (used where Brick has no property)
# ---------------------------------------------------------------------------

bldg:maxOccupancy
    rdf:type owl:DatatypeProperty ;
    rdfs:label "Maximum occupancy (persons)" ;
    rdfs:domain brick:Space ;
    rdfs:range xsd:integer .

bldg:epcRating
    rdf:type owl:DatatypeProperty ;
    rdfs:label "Energy Performance Certificate rating (A-G)" ;
    rdfs:range xsd:string .

bldg:carbonIntensityGCO2perKWh
    rdf:type owl:DatatypeProperty ;
    rdfs:label "Grid carbon intensity (gCO2/kWh)" ;
    rdfs:range xsd:decimal .

bldg:moldRiskThresholdRH
    rdf:type owl:DatatypeProperty ;
    rdfs:label "Humidity % above which mold risk is flagged" ;
    rdfs:range xsd:decimal .

bldg:wasteType
    rdf:type owl:DatatypeProperty ;
    rdfs:label "Type of waste collected (general, recycling, composting)" ;
    rdfs:range xsd:string .

bldg:distanceToEntrance
    rdf:type owl:DatatypeProperty ;
    rdfs:label "Approximate walking distance to main entrance (metres)" ;
    rdfs:range xsd:decimal .

bldg:Waste_Bin
    rdf:type owl:Class ;
    rdfs:subClassOf brick:Equipment ;
    rdfs:label "Waste Bin" ;
    rdfs:comment "A container for waste collection, potentially equipped with fill-level sensing." .


# ===========================================================================
# P1 - ACCESS CONTROL DOORS + TIMESERIES UUIDs  (Topic 6)
# ===========================================================================

bldg:Access_Reader_Main_Entrance
    rdf:type owl:NamedIndividual , brick:Access_Reader ;
    rdfs:label "Access Reader - Main Building Entrance" ;
    brick:isPartOf bldg:Room0.01 ;
    ashrae:hasExternalReference [
        rdf:type ref:TimeseriesReference ;
        ref:hasTimeseriesId "00000000-ac01-0000-0000-000000000001" ;
        ref:storedAt bldg:database1
    ] .

