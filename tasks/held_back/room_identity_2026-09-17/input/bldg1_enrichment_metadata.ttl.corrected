@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix brick:  <https://brickschema.org/schema/Brick#> .
@prefix rec:    <https://w3id.org/rec#> .
@prefix hbco:   <http://ontosage.org/hbco#> .
@prefix ontosage: <http://ontosage.org/capabilities#> .
@prefix bldg:   <http://abacwsbuilding.cardiff.ac.uk/abacws#> .

# ─────────────────────────────────────────────────────────────────────────────
# Abacws metadata enrichment — T07
# Source: capability.yaml + Abacws building documentation
# Estimates marked with rdfs:comment "estimated"
# ─────────────────────────────────────────────────────────────────────────────

# ── Floor-level metadata ──────────────────────────────────────────────────────

bldg:Floor0 hbco:spaceFunction  "Ground floor: main entrance, atrium, café, reception"^^xsd:string ;
            hbco:isQuietZone    false ;
            rdfs:comment        "Atrium seating for informal use; café Abacws open 08:00–16:30 weekdays." .

bldg:Floor1 hbco:spaceFunction  "Study floor: open-plan quiet study, showers, vending machine"^^xsd:string ;
            hbco:isQuietZone    true ;
            rdfs:comment        "Quiet study zone; shower facilities accessible from right-hand lift. Vending machine available." .

bldg:Floor2 hbco:spaceFunction  "Study and research floor: quiet study area, kitchen/breakout, server room"^^xsd:string ;
            hbco:isQuietZone    true ;
            rdfs:comment        "Quiet study zone; server room on this floor. Kitchen/breakout area with microwave and filtered water." .

bldg:Floor3 hbco:spaceFunction  "Collaboration floor: pods for group work, kitchen/breakout, vending machine"^^xsd:string ;
            hbco:isQuietZone    false ;
            rdfs:comment        "Collaborative pods for small group work. Not a designated quiet zone." .

bldg:Floor4 hbco:spaceFunction  "Research labs and offices: labs, server room, kitchen/breakout"^^xsd:string ;
            hbco:isQuietZone    false ;
            rdfs:comment        "Server room on this floor. Bookable lab spaces via academic staff." .

bldg:Floor5 hbco:spaceFunction  "Research labs and smart-sensor demonstration floor"^^xsd:string ;
            hbco:isQuietZone    false ;
            rdfs:comment        "Live sensor data connected (floor 5 only at launch). Research labs and PhD study spaces." .

# ── Room capacities ────────────────────────────────────────────────────────────
# CORRECTED 2026-09-17 (BUG-671). These were "estimates based on typical Cardiff University
# academic building room standards", and nine of the nineteen were physically impossible:
# Room1.06 = 30 people in 11.94 m2, Room5.08 = 50 in 24.73 m2, and seven more cellular
# offices given seminar-room numbers -- denser than the 1.0 m2 per person Approved Document B
# allows even as a means-of-escape maximum. The other ten contradicted the drawing too
# (Room5.05 = 20 in a room the plan labels "90P Lecture").
#
# The CAPACITIES were wrong, not the areas. Measured from the committed DXFs
# ("Abacws floor N.dxf"): each room's number sits inside exactly one A-AREA-ROOM outline, alone,
# and the text inside that outline says what the room is ("Office" for 1.06, "Small Research"
# for 5.08). The label-bearing floor-plan spaces with no ontology_iri ("30P Seminar Room",
# "8-12P Meet Rm 1.40") are duplicates of the numbered outlines for 1.04 and 1.40, not of 1.06.
#
# Each capacity now states its basis in ontosage:capacityBasis, in order of preference:
#   1. the person count the drawing itself writes inside the room's outline;
#   2. otherwise floor(area / 10 m2 per workplace), the density
#      scripts/provision_event_and_capacity_data.py applies to offices and laboratories.
# Neither is a certified fire capacity; authoritative figures should come from Estates.
# The hbco:spaceFunction values were re-derived from the same drawing on 2026-09-17, after the
# building owner ruled the drawings authoritative for room identity: they had called 10.9 m2
# offices "Seminar room" and "Teaching lab", and the 120-person lecture theatre 0.01 an
# "Atrium / reception area". Room labels and Brick types moved with them in
# bldg1_abacws_metadata.ttl.

# Floor 5 rooms (main sensor-equipped research floor)
bldg:Room5.01 hbco:roomCapacity  8 ;
              ontosage:capacityBasis "From the floor plan, not certified: the architect's drawing labels this room '8P PHD Research' inside its own 33.0 m2 outline, and this capacity is the figure that label states." ;
              hbco:spaceFunction "PhD research office"^^xsd:string ;
              rdfs:comment       "estimated" .

bldg:Room5.02 hbco:roomCapacity  8 ;
              ontosage:capacityBasis "From the floor plan, not certified: the architect's drawing labels this room '8P PHD Research' inside its own 35.8 m2 outline, and this capacity is the figure that label states." ;
              hbco:spaceFunction "PhD research office"^^xsd:string ;
              rdfs:comment       "estimated" .

bldg:Room5.03 hbco:roomCapacity  1 ;
              ontosage:capacityBasis "Estimated, not certified: 10.9 m2 floor-plan area at 10 m2 per workplace, within the 8-13 m2 per workplace range the British Council for Offices gives for office design occupancy. The floor plan labels this room 'Office' and states no person count." ;
              hbco:spaceFunction "Office"^^xsd:string ;
              rdfs:comment       "estimated" .

bldg:Room5.04 hbco:roomCapacity  1 ;
              ontosage:capacityBasis "Estimated, not certified: 10.4 m2 floor-plan area at 10 m2 per workplace, within the 8-13 m2 per workplace range the British Council for Offices gives for office design occupancy. The floor plan labels this room 'Office' and states no person count." ;
              hbco:spaceFunction "Office"^^xsd:string ;
              rdfs:comment       "estimated" .

bldg:Room5.05 hbco:roomCapacity  90 ;
              ontosage:capacityBasis "From the floor plan, not certified: the architect's drawing labels this room '90P Lecture' inside its own 187.6 m2 outline, and this capacity is the figure that label states." ;
              hbco:spaceFunction "Lecture theatre"^^xsd:string ;
              rdfs:comment       "estimated" .

bldg:Room5.06 hbco:roomCapacity  1 ;
              ontosage:capacityBasis "Estimated, not certified: 10.5 m2 floor-plan area at 10 m2 per workplace, within the 8-13 m2 per workplace range the British Council for Offices gives for office design occupancy. The floor plan labels this room 'Office' and states no person count." ;
              hbco:spaceFunction "Office"^^xsd:string ;
              rdfs:comment       "estimated" .

bldg:Room5.07 hbco:roomCapacity  1 ;
              ontosage:capacityBasis "Estimated, not certified: 10.4 m2 floor-plan area at 10 m2 per workplace, within the 8-13 m2 per workplace range the British Council for Offices gives for office design occupancy. The floor plan labels this room 'Office' and states no person count." ;
              hbco:spaceFunction "Office"^^xsd:string ;
              rdfs:comment       "estimated" .

bldg:Room5.08 hbco:roomCapacity  2 ;
              ontosage:capacityBasis "Estimated, not certified: 24.7 m2 floor-plan area at 10 m2 per workplace, within the 8-13 m2 per workplace range the British Council for Offices gives for office design occupancy. The floor plan labels this room 'Small Research' and states no person count." ;
              hbco:spaceFunction "Research office"^^xsd:string ;
              rdfs:comment       "estimated" .

bldg:Room5.09 hbco:roomCapacity  1 ;
              ontosage:capacityBasis "Estimated, not certified: 11.0 m2 floor-plan area at 10 m2 per workplace, within the 8-13 m2 per workplace range the British Council for Offices gives for office design occupancy. The floor plan labels this room 'Office' and states no person count." ;
              hbco:spaceFunction "Office"^^xsd:string ;
              rdfs:comment       "estimated" .

bldg:Room5.10 hbco:roomCapacity  1 ;
              ontosage:capacityBasis "Estimated, not certified: 10.6 m2 floor-plan area at 10 m2 per workplace, within the 8-13 m2 per workplace range the British Council for Offices gives for office design occupancy. The floor plan labels this room 'Office' and states no person count." ;
              hbco:spaceFunction "Office"^^xsd:string ;
