# SATURATE (V4-T08): simulated nitrogen_dioxide sensors for spaces the coverage
# audit found uninstrumented. Every sensor is labeled ontosage:isSimulated.
# Rows live in the narrow table 'iaq_data' (database_registry.yaml key).
@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix ref:   <https://brickschema.org/schema/Brick/ref#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ontosage: <http://ontosage.org/capabilities#> .
@prefix bldg:  <http://abacwsbuilding.cardiff.ac.uk/abacws#> .

<http://abacwsbuilding.cardiff.ac.uk/abacws#iaq_data>
    a ref:Database ;
    rdfs:label "Iaq Data" .

<http://abacwsbuilding.cardiff.ac.uk/abacws#Floor0_sat_nitrogen_dioxide>
    a brick:NO2_Level_Sensor ;
    rdfs:label "Floor0 nitrogen_dioxide [ppb]"@en ;
    brick:hasLocation <http://abacwsbuilding.cardiff.ac.uk/abacws#Floor0> ;
    ontosage:isSimulated "true"^^xsd:boolean ;
    rdfs:comment "synthetic-saturation-v4" ;
    ref:hasExternalReference [
        a ref:TimeseriesReference ;
        ref:hasTimeseriesId "55c8cc81-7515-5f36-b83b-105551c6e578" ;
        ref:storedAt <http://abacwsbuilding.cardiff.ac.uk/abacws#iaq_data> ;
    ] .

