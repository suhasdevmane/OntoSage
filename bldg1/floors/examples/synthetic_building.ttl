@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

abx:Cardiff_University a bot:Site ;
    rdfs:label "Cardiff University" ;
    bot:hasBuilding abx:Abacws .

