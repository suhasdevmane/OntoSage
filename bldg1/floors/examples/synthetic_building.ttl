abx:appliesTo a owl:ObjectProperty ;
    rdfs:label "applies to" ;
    rdfs:comment "The space a drawn dimension was placed inside." .

abx:attr_ASSET_ID a owl:DatatypeProperty .

abx:attr_CIRCUIT a owl:DatatypeProperty .

abx:bboxDepth a owl:DatatypeProperty ;
    rdfs:label "bounding box depth (m)" ;
    rdfs:range xsd:double .

abx:bboxWidth a owl:DatatypeProperty ;
    rdfs:label "bounding box width (m)" ;
    rdfs:range xsd:double .

abx:blockName a owl:DatatypeProperty ;
    rdfs:label "source block name" ;
    rdfs:comment "Provenance: the CAD block definition this element came from." .

abx:connectedTo a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "connected to" ;
    rdfs:comment "Two spaces are directly passable between one another through a door. Stronger than bot:adjacentZone, which only asserts that two spaces share a boundary." ;
    rdfs:domain bot:Zone ;
    rdfs:range bot:Zone .

abx:dimensionKind a owl:DatatypeProperty ;
    rdfs:label "dimension kind" ;
    rdfs:comment "linear | aligned | angular | radius | diameter | ordinate - the DXF dimension type the drafter used." .

abx:level a owl:DatatypeProperty ;
    rdfs:label "storey level" ;
    rdfs:comment "Signed storey index; 0 is ground, negative is below ground." ;
    rdfs:range xsd:integer .

abx:measurement a owl:ObjectProperty ;
    rdfs:label "measurement" ;
    rdfs:domain abx:Dimension .

abx:perimeter a owl:DatatypeProperty ;
    rdfs:label "perimeter (m)" ;
    rdfs:range xsd:double .

abx:roomCode a owl:DatatypeProperty ;
    rdfs:label "room code" ;
    rdfs:comment "Institutional room identifier as drawn on the floor plan, e.g. '0Z19'. Stable join key to timetabling and BMS systems." ;
    rdfs:range xsd:string .

abx:sourceLayer a owl:DatatypeProperty ;
    rdfs:label "source CAD layer" ;
    rdfs:comment "Provenance: the CAD layer the geometry was recovered from." .

abx:textOverride a owl:DatatypeProperty ;
    rdfs:label "dimension text override" ;
    rdfs:comment "Text the drafter typed in place of the computed measurement. When present it should be trusted over the measurement, because the drafter deliberately replaced it." .

abx:verticallyConnectedTo a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "vertically connected to" ;
    rdfs:comment "Two spaces on different storeys are linked by shared vertical circulation - a stair, lift or riser core occupying the same footprint on both floors." ;
    rdfs:domain bot:Zone ;
    rdfs:range bot:Zone .

abx:Abacws a brick:Building,
        bot:Building ;
    rdfs:label "Abacws Building" ;
    bot:hasStorey abx:Storey_00,
        abx:Storey_01,
        abx:Storey_02 .

