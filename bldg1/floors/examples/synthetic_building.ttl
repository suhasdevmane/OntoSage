abx:Storey_00_Dimension_0001 a abx:Dimension ;
    geo:hasGeometry abx:Geometry_Storey_00_Dimension_0001 ;
    abx:dimensionKind "linear" ;
    abx:measurement [ brick:hasUnit unit:M ;
            brick:value 6e+00 ] ;
    abx:sourceLayer "A-ANNO-DIMS" .

