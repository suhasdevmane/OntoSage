# SATURATE (V4-T08): simulated illuminance sensors for spaces the coverage
# audit found uninstrumented. Every sensor is labeled ontosage:isSimulated.
# Rows live in the narrow table 'light_data' (database_registry.yaml key).
@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix ref:   <https://brickschema.org/schema/Brick/ref#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ontosage: <http://ontosage.org/capabilities#> .
@prefix bldg:  <http://abacwsbuilding.cardiff.ac.uk/abacws#> .

<http://abacwsbuilding.cardiff.ac.uk/abacws#light_data>
    a ref:Database ;
    rdfs:label "Light Data" .

<http://abacwsbuilding.cardiff.ac.uk/abacws#Room0.01_sat_illuminance>
    a brick:Illuminance_Sensor ;
    rdfs:label "Room 0.01 — Main Reception illuminance (simulated) [lux]"@en ;
    brick:hasLocation <http://abacwsbuilding.cardiff.ac.uk/abacws#Room0.01> ;
    ontosage:isSimulated "true"^^xsd:boolean ;
    rdfs:comment "synthetic-saturation-v4" ;
    ref:hasExternalReference [
        a ref:TimeseriesReference ;
        ref:hasTimeseriesId "0281a5ee-58c1-503c-8771-d72d7671a6e4" ;
        ref:storedAt <http://abacwsbuilding.cardiff.ac.uk/abacws#light_data> ;
    ] .

