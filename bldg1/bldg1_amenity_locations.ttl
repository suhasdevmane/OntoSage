# SATURATE (V4-T12): per-instance amenities with STRUCTURED locations
# (ontosage:locatedIn <space>) so proximity constraints are computable.
# Placement is simulated and labeled as such; replace with surveyed
# locations for a real building — the structure is what matters.
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ontosage: <http://ontosage.org/capabilities#> .
@prefix bldg:  <http://abacwsbuilding.cardiff.ac.uk/abacws#> .

<http://abacwsbuilding.cardiff.ac.uk/abacws#Amenity_DrinkingWater_Floor0>
    a ontosage:Amenity , ontosage:DrinkingWater ;
    rdfs:label "Drinking water point — Room 0.01 — Main Reception"@en ;
    ontosage:layTerms "water, drinking water, water fountain, water cooler, bottle filling, fill my bottle" ;
    ontosage:locatedIn <http://abacwsbuilding.cardiff.ac.uk/abacws#Room0.01> ;
    ontosage:onFloor "Floor0" ;
    ontosage:locationText "Drinking water point in Room 0.01 — Main Reception (floor Floor0)" ;
    ontosage:answerText "There is a drinking water point in Room 0.01 — Main Reception on floor Floor0." ;
    ontosage:isSimulated "true"^^xsd:boolean .

