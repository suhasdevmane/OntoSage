# SATURATE (V4-T12): per-instance amenities with STRUCTURED locations
# (ontosage:locatedIn <space>) so proximity constraints are computable.
# Placement is simulated and labeled as such; replace with surveyed
# locations for a real building — the structure is what matters.
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ontosage: <http://ontosage.org/capabilities#> .
@prefix bldg:  <http://abacwsbuilding.cardiff.ac.uk/abacws#> .

<http://abacwsbuilding.cardiff.ac.uk/abacws#Amenity_StudyArea_Floor0>
    a ontosage:Amenity , ontosage:StudyArea ;
    rdfs:label "Study area — Room 0.05 — Mechanical Plant Room"@en ;
    ontosage:layTerms "study area, study space, workspace, quiet study, place to work, place to sit and work" ;
    ontosage:locatedIn <http://abacwsbuilding.cardiff.ac.uk/abacws#Room0.05> ;
    ontosage:onFloor "Floor0" ;
    ontosage:locationText "Study area in Room 0.05 — Mechanical Plant Room (floor Floor0)" ;
    ontosage:answerText "There is a study area in Room 0.05 — Mechanical Plant Room on floor Floor0." ;
    ontosage:isSimulated "true"^^xsd:boolean .

