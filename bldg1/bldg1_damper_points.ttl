# Outside-air dampers and their position points
#
# config/saturation_modalities.yaml declared the damper_position modality and no
# point of it existed, so every question about damper or economiser position was
# answered as 'not measured' by a building whose air handlers obviously have them.
# 
# One OUTSIDE-AIR damper per air handling unit, which is the one an economiser
# modulates and the one a question about fresh air is usually about. A return-air
# damper is deliberately NOT invented alongside it: two dampers per unit implies a
# mixing arrangement this building has not told us it has.
#
# GENERATED by scripts/provision_damper_and_waste_points.py — re-runnable;
# ids are uuid5 of the point IRI, so running it twice changes nothing.

@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix brick:    <https://brickschema.org/schema/Brick#> .
@prefix ref:      <https://brickschema.org/schema/Brick/ref#> .
@prefix ontosage: <http://ontosage.org/capabilities#> .

@prefix bldg:     <http://abacwsbuilding.cardiff.ac.uk/abacws#> .

bldg:AHU_F0_Outside_Air_Damper a brick:Outside_Damper ;
    rdfs:label "Air Handling Unit — Floor 0 — outside air damper"@en ;
    brick:isPartOf bldg:AHU_F0 .

bldg:AHU_F0_Outside_Air_Damper_Position a brick:Damper_Position_Sensor ;
    rdfs:label "Air Handling Unit — Floor 0 — outside air damper position" ;
    brick:isPointOf bldg:AHU_F0_Outside_Air_Damper ;
    ref:hasExternalReference [
        a ref:TimeseriesReference ;
        ref:hasTimeseriesId "5bd06ccc-3c08-5691-8ef8-fa3fcd763dbc" ;
        ref:storedAt bldg:plant_data
    ] .

