# GENERATED by scripts/generate_precedence_ttl.py -- DO NOT HAND-EDIT.
# Source of truth: config/evidence_policy.yaml (source_precedence.by_kind) +
# orchestrator/services/evidence/precedence.py (RANK). Re-run the script after
# changing either; this file is a rendering, not a second declaration.
#
# E5 (QA-trial plan, 2026-10-04): puts rule R-7 ('bookings, access, timetables and
# alarms come from authorised systems, never from environmental inference') into
# the graph, so 'which kind of record wins?' has triples to answer from.

@prefix bldg:     <http://abacwsbuilding.cardiff.ac.uk/abacws#> .
@prefix ontosage: <http://ontosage.org/capabilities#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .

ontosage:PrecedenceTier a owl:Class ;
    rdfs:label "Source precedence tier"@en ;
    rdfs:comment "How authoritative a kind of evidence source is, ranked. Higher ontosage:tierRank wins a disagreement (rule R-7)."@en .

ontosage:SourceKind a owl:Class ;
    rdfs:label "Evidence source kind"@en ;
    rdfs:comment "A kind of evidence source (booking, sensor, register, ...) -- the same vocabulary as EvidenceSource.kind in the orchestrator, linked here to its precedence tier."@en .

ontosage:tierRank a owl:DatatypeProperty ;
    rdfs:domain ontosage:PrecedenceTier ; rdfs:range xsd:integer ;
    rdfs:label "Tier rank"@en ;
    rdfs:comment "Higher wins. Values from precedence.RANK, spaced so an intermediate tier can be declared without renumbering."@en .

ontosage:hasPrecedenceTier a owl:ObjectProperty ;
    rdfs:domain ontosage:SourceKind ; rdfs:range ontosage:PrecedenceTier ;
    rdfs:label "has precedence tier"@en .

ontosage:Tier_Authoritative a ontosage:PrecedenceTier ;
    rdfs:label "authoritative"@en ;
    ontosage:tierRank 30 ;
    rdfs:comment "A system of record for the claim -- booking, access control, timetable, alarm, register, or a policy document standing for itself."@en .

ontosage:Tier_DocumentDerived a ontosage:PrecedenceTier ;
    rdfs:label "document_derived"@en ;
    ontosage:tierRank 25 ;
    rdfs:comment "A fact LIFTED from a document (a transcribed register row), not the document's own statement of itself -- ranks below authoritative on purpose: a register can move on since the document was written."@en .

ontosage:Tier_Measurement a ontosage:PrecedenceTier ;
    rdfs:label "measurement"@en ;
    ontosage:tierRank 20 ;
    rdfs:comment "A sensor reading, or a calculation over sensor readings."@en .

ontosage:Tier_Inference a ontosage:PrecedenceTier ;
    rdfs:label "inference"@en ;
    ontosage:tierRank 10 ;
    rdfs:comment "Anything derived without measuring or recording the thing itself -- a person's account, for example."@en .

ontosage:Tier_Unknown a ontosage:PrecedenceTier ;
    rdfs:label "unknown"@en ;
    ontosage:tierRank 0 ;
    rdfs:comment "An unrecognised source kind. Can never outrank anything and can never satisfy a claim that demands authority."@en .

ontosage:Kind_AccessControl a ontosage:SourceKind ;
    rdfs:label "access_control"@en ;
    ontosage:hasPrecedenceTier ontosage:Tier_Authoritative .

ontosage:Kind_Alarm a ontosage:SourceKind ;
    rdfs:label "alarm"@en ;
    ontosage:hasPrecedenceTier ontosage:Tier_Authoritative .

ontosage:Kind_Authoritative a ontosage:SourceKind ;
    rdfs:label "authoritative"@en ;
    ontosage:hasPrecedenceTier ontosage:Tier_Authoritative .

ontosage:Kind_Booking a ontosage:SourceKind ;
    rdfs:label "booking"@en ;
    ontosage:hasPrecedenceTier ontosage:Tier_Authoritative .

ontosage:Kind_Document a ontosage:SourceKind ;
    rdfs:label "document"@en ;
    ontosage:hasPrecedenceTier ontosage:Tier_Authoritative .

ontosage:Kind_HumanReport a ontosage:SourceKind ;
    rdfs:label "human_report"@en ;
    ontosage:hasPrecedenceTier ontosage:Tier_Inference .

ontosage:Kind_Register a ontosage:SourceKind ;
    rdfs:label "register"@en ;
    ontosage:hasPrecedenceTier ontosage:Tier_Authoritative .

ontosage:Kind_Sensor a ontosage:SourceKind ;
    rdfs:label "sensor"@en ;
    ontosage:hasPrecedenceTier ontosage:Tier_Measurement .

ontosage:Kind_Timetable a ontosage:SourceKind ;
    rdfs:label "timetable"@en ;
    ontosage:hasPrecedenceTier ontosage:Tier_Authoritative .

