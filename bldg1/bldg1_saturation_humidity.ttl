# SATURATE (V4-T08): simulated humidity sensors for spaces the coverage
# audit found uninstrumented. Every sensor is labeled ontosage:isSimulated.
# Rows live in the narrow table 'humidity_data' (database_registry.yaml key).
@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix ref:   <https://brickschema.org/schema/Brick/ref#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ontosage: <http://ontosage.org/capabilities#> .
@prefix bldg:  <http://abacwsbuilding.cardiff.ac.uk/abacws#> .

<http://abacwsbuilding.cardiff.ac.uk/abacws#humidity_data>
    a ref:Database ;
    rdfs:label "Humidity Data" .

<http://abacwsbuilding.cardiff.ac.uk/abacws#Room4.66_sat_humidity>
    a brick:Relative_Humidity_Sensor ;
    rdfs:label "Room 4.66 — Academic Office humidity (simulated) [percent]"@en ;
    brick:hasLocation <http://abacwsbuilding.cardiff.ac.uk/abacws#Room4.66> ;
    ontosage:isSimulated "true"^^xsd:boolean ;
    rdfs:comment "synthetic-saturation-v4" ;
    ref:hasExternalReference [
        a ref:TimeseriesReference ;
        ref:hasTimeseriesId "c3647bfb-21fa-50c0-8314-79c3dede6bea" ;
        ref:storedAt <http://abacwsbuilding.cardiff.ac.uk/abacws#humidity_data> ;
