# SATURATE (V4-T08): simulated co2 sensors for spaces the coverage
# audit found uninstrumented. Every sensor is labeled ontosage:isSimulated.
# Rows live in the narrow table 'co2_data' (database_registry.yaml key).
@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix ref:   <https://brickschema.org/schema/Brick/ref#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ontosage: <http://ontosage.org/capabilities#> .
@prefix bldg:  <http://abacwsbuilding.cardiff.ac.uk/abacws#> .

<http://abacwsbuilding.cardiff.ac.uk/abacws#co2_data>
    a ref:Database ;
    rdfs:label "Co2 Data" .

<http://abacwsbuilding.cardiff.ac.uk/abacws#Room4.66_sat_co2>
