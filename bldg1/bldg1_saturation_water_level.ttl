# SATURATE (V4-T08): simulated water_level sensors for spaces the coverage
# audit found uninstrumented. Every sensor is labeled ontosage:isSimulated.
# Rows live in the narrow table 'water_data' (database_registry.yaml key).
@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix ref:   <https://brickschema.org/schema/Brick/ref#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ontosage: <http://ontosage.org/capabilities#> .
@prefix bldg:  <http://abacwsbuilding.cardiff.ac.uk/abacws#> .

<http://abacwsbuilding.cardiff.ac.uk/abacws#water_data>
    a ref:Database ;
    rdfs:label "Water Data" .

<http://abacwsbuilding.cardiff.ac.uk/abacws#Floor0_sat_water_level>
    a brick:Water_Level_Sensor ;
    rdfs:label "Floor0 water_level [percent]"@en ;
    brick:hasLocation <http://abacwsbuilding.cardiff.ac.uk/abacws#Floor0> ;
    rdfs:comment "synthetic-saturation-v4" ;
    ref:hasExternalReference [
        a ref:TimeseriesReference ;
        ref:hasTimeseriesId "aecf00cb-bc4a-5a1b-bb4b-1683581f3a59" ;
        ref:storedAt <http://abacwsbuilding.cardiff.ac.uk/abacws#water_data> ;
    ] .

