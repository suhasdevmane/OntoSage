# Per-building .env delta — bldg1 (Abacws Building, Cardiff).
# When THIS building is active (this folder is named input/), the root .env must
# contain exactly these values. Everything else in .env is building-independent:
# start from .env.example and fill secrets locally. NEVER commit the real .env.
BUILDING_ID=bldg1
BUILDING_NAME=Abacws Building
BUILDING_NAMESPACE=http://abacwsbuilding.cardiff.ac.uk/abacws#
BUILDING_PREFIX=bldg
BUILDING_TIMEZONE=Europe/London
MYSQL_DATABASE=sensordb
COMPOSE_PROJECT_NAME=ontosage_bldg1
