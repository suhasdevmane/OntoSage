bldg:AbacwsOntology rdf:type owl:Ontology ;
                    rdfs:label "Abacws Building Ontology" ;
                    rdfs:comment "Building model for Abacws building at Cardiff University using Brick Schema" ;
                    owl:imports <http://data.ashrae.org/bacnet/2020> ,
                                <http://datashapes.org/dash> ,
                                <http://qudt.org/3.1.0/vocab/quantitykind> ,
                                <http://qudt.org/3.1.0/vocab/unit> ,
                                <https://brickschema.org/schema/1.3/Brick> ,
                                <https://brickschema.org/schema/Brick/ref> ,
                                <https://w3id.org/rec/brickpatches> ,
                                <https://w3id.org/rec/recimports> ;
                    dcterms:creator "Cardiff University Smart Buildings Team" ;
                    dcterms:created "2024-01-01" ;
                    dcterms:modified "2025-05-01" ;
                    owl:versionInfo "1.0" .

#    Annotation properties

