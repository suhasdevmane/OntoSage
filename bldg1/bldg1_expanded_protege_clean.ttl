                    sh:targetSubjectsOf brick:deprecation .

_:genid6823 sh:datatype xsd:string ;
             sh:path brick:deprecationMitigationMessage ;
             sh:maxCount "true"^^xsd:boolean ,
                         1 .

_:genid6824 sh:datatype xsd:string ;
