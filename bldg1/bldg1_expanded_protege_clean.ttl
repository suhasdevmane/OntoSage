bsh:DeprecationInferenceForInstancesRule rdf:type owl:NamedIndividual ,
                                                  sh:NodeShape ;
                                         sh:rule _:genid6822 ;
                                         sh:targetClass brick:Entity .

_:genid6822 rdf:type sh:SPARQLRule ;
             sh:prefixes <https://brickschema.org/schema/1.4/Brick> ;
             sh:construct """CONSTRUCT {
$this a ?newClass .
}
WHERE {
$this a ?class .
?class owl:deprecated true .
?class brick:isReplacedBy ?newClass .
FILTER NOT EXISTS {$this a ?newClass}
}""" ;
             sh:message "Deprecated class is temporarily augmented by the new class" .


bsh:DeprecationRule rdf:type sh:NodeShape ;
                    sh:property _:genid6823 ,
                                _:genid6824 ,
                                _:genid6825 ,
                                _:genid6827 ;
