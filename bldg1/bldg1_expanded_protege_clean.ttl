             sh:message "Only meters can have the isVirtualMeter property be true" ;
             sh:select """
            SELECT $this WHERE {
                $this brick:isVirtualMeter/brick:value true .
                FILTER NOT EXISTS { $this rdf:type/rdfs:subClassOf* brick:Meter } .
            }
        """ .


