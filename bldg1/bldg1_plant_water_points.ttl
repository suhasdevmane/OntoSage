# BMS / plant telemetry points (V6-T26).
#
# GENERATED by scripts/provision_plant_points.py from equipment ALREADY in the graph.
# Nothing here invents plant: every point hangs off an AHU or VAV that already
# brick:feeds a zone or space. Master Package D asks for the BMS to be integrated
# rather than duplicated, so these are declared as ordinary Brick points and routed
# by ref:storedAt like any other series -- no new adapter, no new query path.

@prefix bldg: <http://abacwsbuilding.cardiff.ac.uk/abacws#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix brick:<https://brickschema.org/schema/Brick#> .
@prefix ref:  <https://brickschema.org/schema/Brick/ref#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ontosage: <http://ontosage.org/capabilities#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .

bldg:Boiler_1_Entering_Water_Temperature a brick:Entering_Water_Temperature_Sensor ;
    rdfs:label "Gas Boiler 1 — Building Central Plant entering water temperature" ;
    brick:isPointOf bldg:Boiler_1 ;
    brick:hasLocation bldg:Rooftop ;
    brick:hasUnit "degC" ;
    ontosage:isSimulated "true"^^xsd:boolean ;
    qudt:hasUnit <http://qudt.org/vocab/unit/DEG_C> ;
    ref:hasExternalReference [
        a ref:TimeseriesReference ;
        ref:hasTimeseriesId "d01cb867-704d-549b-b479-c0b299334bc0" ;
        ref:storedAt bldg:plant_data
    ] .

bldg:Boiler_1_Leaving_Water_Temperature a brick:Leaving_Water_Temperature_Sensor ;
