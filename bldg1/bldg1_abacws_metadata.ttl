# =============================================================================
# Abacws Building — Brick Schema v1.4 A-Box Metadata
#
# This file adds comprehensive Brick v1.4 metadata to the Abacws building
# (School of Computer Science and Informatics, Cardiff University).
# It is designed to be loaded alongside bldg1_expanded_protege_clean.ttl
# into the same GraphDB repository.
#
# What this file adds:
#   - brick:Building typing for bldg:Abacws (was rec:Building only)
#   - brick:Floor typing for Floors 0-5 + Rooftop (were rec:Space only)
#   - Brick-subclass room types for every room on every floor
#   - brick:HVAC_Zone declarations for all 34 zones on Floor 5
#   - HVAC equipment: AHU per floor, Boiler, Chiller, Heat_Pump
#   - Electrical: Building_Electrical_Meter, Breaker_Panel per floor, Emergency_Generator
#   - Fire safety: Fire_Alarm_Control_Panel, AED locations, First_Aid_Kit per floor
#   - Water: Building_Water_Meter, Hot_Water_System
#   - Vertical transport: 2 Elevators, Stairwell_North, Stairwell_South
#   - IT/Communications: Server rooms, Telecom rooms
#   - Security: Cameras at entrance + each floor
#   - Parking: Parking_Level, 6 EV Charging Stations
#   - Renewable: PV array on Rooftop
#
# Sensor names (all *_5.XX entities) are NOT modified here.
# =============================================================================

@prefix brick:   <https://brickschema.org/schema/Brick#> .
@prefix bldg:    <http://abacwsbuilding.cardiff.ac.uk/abacws#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <http://abacwsbuilding.cardiff.ac.uk/abacws#> .
@prefix ontosage: <http://ontosage.org/capabilities#> .

# ---------------------------------------------------------------------------
# Ontology header
# ---------------------------------------------------------------------------

bldg:AbacwsMetadataOntology
    rdf:type owl:Ontology ;
    rdfs:label "Abacws Building Metadata — Brick v1.4 A-Box" ;
    rdfs:comment "Comprehensive Brick Schema v1.4 instance metadata for the Abacws building at Cardiff University. Companion file to bldg1_expanded_protege_clean.ttl." ;
    owl:imports <https://brickschema.org/schema/1.4/Brick> ;
    dcterms:creator "Cardiff University Smart Buildings Team" ;
    dcterms:created "2026-04-25"^^xsd:date ;
    owl:versionInfo "1.0" .


# ===========================================================================
# BUILDING
# ===========================================================================

bldg:Abacws
    rdf:type owl:NamedIndividual ,
             brick:Building ;
    rdfs:label "Abacws Building" ;
    rdfs:comment "School of Computer Science and Informatics, Cardiff University, Senghennydd Road, Cardiff CF24 4AG" ;
    brick:hasPart bldg:Floor0 ,
                  bldg:Floor1 ,
                  bldg:Floor2 ,
                  bldg:Floor3 ,
                  bldg:Floor4 ,
                  bldg:Floor5 ,
                  bldg:Rooftop ,
                  bldg:Parking_Level_Ground ;
    brick:hasLocation bldg:HVAC_Plant_Building .


