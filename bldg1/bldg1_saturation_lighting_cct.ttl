@prefix ontosage: <http://ontosage.org/capabilities#> .
@prefix bldg:  <http://abacwsbuilding.cardiff.ac.uk/abacws#> .

<http://abacwsbuilding.cardiff.ac.uk/abacws#equipment_data>
    a ref:Database ;
    rdfs:label "Equipment Data" .

<http://abacwsbuilding.cardiff.ac.uk/abacws#Room0.01_sat_lighting_cct>
