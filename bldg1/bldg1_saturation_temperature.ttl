# SATURATE (V4-T08): simulated temperature sensors for spaces the coverage
# audit found uninstrumented. Every sensor is labeled ontosage:isSimulated.
# Rows live in the narrow table 'temperature_data' (database_registry.yaml key).
@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix ref:   <https://brickschema.org/schema/Brick/ref#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ontosage: <http://ontosage.org/capabilities#> .
@prefix bldg:  <http://abacwsbuilding.cardiff.ac.uk/abacws#> .

<http://abacwsbuilding.cardiff.ac.uk/abacws#temperature_data>
    a ref:Database ;
    rdfs:label "Temperature Data" .

<http://abacwsbuilding.cardiff.ac.uk/abacws#Room4.66_sat_temperature>
    a brick:Zone_Air_Temperature_Sensor ;
    rdfs:label "Room 4.66 — Academic Office temperature (simulated) [degC]"@en ;
    brick:hasLocation <http://abacwsbuilding.cardiff.ac.uk/abacws#Room4.66> ;
    ontosage:isSimulated "true"^^xsd:boolean ;
    rdfs:comment "synthetic-saturation-v4" ;
    ref:hasExternalReference [
        a ref:TimeseriesReference ;
        ref:hasTimeseriesId "832d9459-8fa6-5c58-ae43-191f1eedfaa1" ;
        ref:storedAt <http://abacwsbuilding.cardiff.ac.uk/abacws#temperature_data> ;
    ] .

