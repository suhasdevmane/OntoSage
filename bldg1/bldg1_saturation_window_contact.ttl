# SATURATE (V4-T08): simulated window_contact sensors for spaces the coverage
# audit found uninstrumented. Every sensor is labeled ontosage:isSimulated.
# Rows live in the narrow table 'contact_data' (database_registry.yaml key).
@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix ref:   <https://brickschema.org/schema/Brick/ref#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ontosage: <http://ontosage.org/capabilities#> .
@prefix bldg:  <http://abacwsbuilding.cardiff.ac.uk/abacws#> .

<http://abacwsbuilding.cardiff.ac.uk/abacws#contact_data>
    a ref:Database ;
    rdfs:label "Contact Data" .

<http://abacwsbuilding.cardiff.ac.uk/abacws#Room0.01_sat_window_contact>
    a brick:Contact_Sensor ;
    rdfs:label "Room 0.01 — Main Reception window_contact (simulated)"@en ;
    brick:hasLocation <http://abacwsbuilding.cardiff.ac.uk/abacws#Room0.01> ;
    ontosage:isSimulated "true"^^xsd:boolean ;
    rdfs:comment "synthetic-saturation-v4" ;
    ref:hasExternalReference [
        a ref:TimeseriesReference ;
        ref:hasTimeseriesId "b481f7d4-02c6-5c78-968c-23e3f2b27096" ;
        ref:storedAt <http://abacwsbuilding.cardiff.ac.uk/abacws#contact_data> ;
    ] .

