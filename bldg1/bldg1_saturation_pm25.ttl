@prefix bldg:  <http://abacwsbuilding.cardiff.ac.uk/abacws#> .

<http://abacwsbuilding.cardiff.ac.uk/abacws#pm25_data>
    a ref:Database ;
    rdfs:label "Pm25 Data" .

