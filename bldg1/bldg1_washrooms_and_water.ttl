# Washroom and drinking-water provision, as the building states it.
#
# WHAT CHANGED AND WHY. This file replaces the placeholder toilet and drinking-water amenities that
# used to sit in bldg1_amenity_locations.ttl. Those put one toilet per floor into whatever room came
# first -- "toilet facility in Room 0.04 - Mechanical Plant Room" -- and recorded no accessibility at
# all, so "the nearest accessible toilet to room 3.10" was answered from floor 4 when floor 3 has
# two. Every entry below is what the building actually provides.
#
# HOW TO MAINTAIN IT
#   Each floor has: one male washroom block (5 cubicles), one female washroom block (5 cubicles),
#   and two gender-neutral toilets that are wheelchair-accessible. Water: two bottle-filling
#   stations per floor, one at each end, plus the staff kitchens and common room.
#
#   ontosage:genderProvision        male | female | gender-neutral | unisex
#   ontosage:accessibilityVerified  true ONLY where step-free access and accessible fittings have
#                                  been surveyed. Gender-neutral does NOT imply it. This is the
#                                  property the resolver actually reads, together with
#                                  ontosage:accessibilityKind "accessible_wc" and the
#                                  ontosage:AccessibilityFeature type -- an accessible toilet that
#                                  omits them is recorded but will not be found.
#   ontosage:cubicleCount           a block of five cubicles is ONE facility with five, not five.
#   ontosage:positionOnFloor        where the survey says it is, when no room number was recorded.
#
# NO ROOM NUMBERS ARE INVENTED. The washrooms and the end-of-floor water stations are recorded by
# position because that is how they were surveyed; a wrong room number is worse than an honest
# direction. The staff water points DO carry room IRIs, because those rooms are in the model.
#
# A new building copies this pattern with its own floors and provision: nothing here is in code.

@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix ontosage: <http://ontosage.org/capabilities#> .
@prefix bldg:     <http://abacwsbuilding.cardiff.ac.uk/abacws#> .

####################################################################################################
#  Washrooms — every floor: 1 male block (5), 1 female block (5), 2 accessible gender-neutral
####################################################################################################

bldg:Washroom_Male_Floor0 a ontosage:Amenity , ontosage:ToiletFacility ;
    rdfs:label "Male washroom — Floor 0"@en ;
    ontosage:layTerms "toilet, toilets, washroom, restroom, bathroom, wc, mens, gents, male toilet" ;
    ontosage:onFloor "Floor0" ; ontosage:genderProvision "male" ; ontosage:cubicleCount 5 ;
    ontosage:positionOnFloor "by the central stair core" ;
    ontosage:locationText "Male washroom on floor Floor0, by the central stair core (5 cubicles)" ;
    ontosage:answerText "Floor 0 has a male washroom with 5 cubicles, by the central stair core." .

bldg:Washroom_Female_Floor0 a ontosage:Amenity , ontosage:ToiletFacility ;
    rdfs:label "Female washroom — Floor 0"@en ;
    ontosage:layTerms "toilet, toilets, washroom, restroom, bathroom, wc, ladies, womens, female toilet" ;
    ontosage:onFloor "Floor0" ; ontosage:genderProvision "female" ; ontosage:cubicleCount 5 ;
    ontosage:positionOnFloor "by the central stair core" ;
    ontosage:locationText "Female washroom on floor Floor0, by the central stair core (5 cubicles)" ;
    ontosage:answerText "Floor 0 has a female washroom with 5 cubicles, by the central stair core." .

bldg:Toilet_Accessible_Floor0_a a ontosage:Amenity , ontosage:ToiletFacility , ontosage:AccessibleToilet , ontosage:AccessibilityFeature ;
    rdfs:label "Accessible gender-neutral toilet — Floor 0 (one end)"@en ;
    ontosage:layTerms "accessible toilet, disabled toilet, wheelchair toilet, gender neutral toilet, unisex toilet, toilet, wc" ;
    ontosage:onFloor "Floor0" ; ontosage:genderProvision "gender-neutral" ;
    ontosage:accessibilityVerified true ;
    ontosage:accessibilityKind "accessible_wc" ;
    ontosage:locatedIn bldg:Floor0 ; ontosage:cubicleCount 1 ;
    ontosage:positionOnFloor "at one end of the floor" ;
    ontosage:locationText "Accessible gender-neutral toilet on floor Floor0, at one end of the floor" ;
    ontosage:answerText "Floor 0 has an accessible gender-neutral toilet at one end of the floor." .

