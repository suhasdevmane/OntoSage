# SATURATE (V4-T08): simulated parking_free sensors for spaces the coverage
# audit found uninstrumented. Every sensor is labeled ontosage:isSimulated.
# Rows live in the narrow table 'parking_data' (database_registry.yaml key).
@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix ref:   <https://brickschema.org/schema/Brick/ref#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ontosage: <http://ontosage.org/capabilities#> .
@prefix bldg:  <http://abacwsbuilding.cardiff.ac.uk/abacws#> .

<http://abacwsbuilding.cardiff.ac.uk/abacws#parking_data>
    a ref:Database ;
    rdfs:label "Parking Data" .

<http://abacwsbuilding.cardiff.ac.uk/abacws#building_sat_parking_free>
    a brick:Occupancy_Count_Sensor ;
    rdfs:label "building parking_free (simulated) [bays]"@en ;
    brick:hasLocation <http://abacwsbuilding.cardiff.ac.uk/abacws#Abacws> ;
    ontosage:isSimulated "true"^^xsd:boolean ;
    rdfs:comment "synthetic-saturation-v4" ;
    ref:hasExternalReference [
        a ref:TimeseriesReference ;
        ref:hasTimeseriesId "c333294c-676b-5164-b12c-36d0a7243bee" ;
        ref:storedAt <http://abacwsbuilding.cardiff.ac.uk/abacws#parking_data> ;
    ] .
