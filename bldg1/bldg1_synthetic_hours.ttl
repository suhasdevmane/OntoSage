# Opening hours and closure periods (synthetic)
# GENERATED by scripts/provision_synthetic_sources.py -- do not hand-edit.
#
# Opening hours say what is NORMAL; a closure says what overrides it. 271 of the supervisors' 480 questions depend on the override being visible.
#
# EVERY record here declares ontosage:isSimulated true. This is DECLARED simulation,
# not fabrication: answers resting on it say so, and the scorecard reports the
# real/synthetic share. Replace with a real feed by pointing the same source kind at
# the institutional system -- the graph shape does not change.
#
# Deliberately imperfect: some assets are out of service and some accessibility
# features are unverified. A building where everything works would make the hard
# filter and the freshness gate untestable.

@prefix bldg: <http://abacwsbuilding.cardiff.ac.uk/abacws#> .
@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ontosage: <http://ontosage.org/capabilities#> .

bldg:Abacws ontosage:openingHours "Mon-Fri 07:00-21:00; Sat 09:00-17:00; Sun closed" ;
    ontosage:isSimulated true .

bldg:closure_Floor0_0 a ontosage:ClosurePeriod ;
    rdfs:label "Planned closure - Floor 0 (Ground Floor)"@en ;
    ontosage:appliesTo bldg:Floor0 ;
    ontosage:closureReason "deep clean" ;
    ontosage:startedAt "2026-09-13T08:00:00"^^xsd:dateTime ;
    ontosage:endedAt "2026-09-13T17:00:00"^^xsd:dateTime ;
    ontosage:isSimulated true .

bldg:closure_Floor1_1 a ontosage:ClosurePeriod ;
    rdfs:label "Planned closure - Floor 1 (First Floor)"@en ;
    ontosage:appliesTo bldg:Floor1 ;
    ontosage:closureReason "planned electrical maintenance" ;
    ontosage:startedAt "2026-09-18T08:00:00"^^xsd:dateTime ;
    ontosage:endedAt "2026-09-18T17:00:00"^^xsd:dateTime ;
    ontosage:isSimulated true .

bldg:closure_Floor2_2 a ontosage:ClosurePeriod ;
    rdfs:label "Planned closure - Floor 2 (Second Floor)"@en ;
    ontosage:appliesTo bldg:Floor2 ;
    ontosage:closureReason "planned electrical maintenance" ;
    ontosage:startedAt "2026-08-28T08:00:00"^^xsd:dateTime ;
    ontosage:endedAt "2026-08-28T17:00:00"^^xsd:dateTime ;
    ontosage:isSimulated true .

