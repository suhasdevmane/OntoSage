# Waste and recycling bins, with fill level and weight
#
# waste_fill and waste_weight were declared by V6-T43 as 'the largest wholly-missing
# domain the category sweep found' and then never provisioned, so both resolved to
# zero points.
# 
# Two streams per floor — general waste and mixed recycling — because the questions
# that need this ('how much did we divert from landfill?') cannot be answered from a
# single undifferentiated total. Each bin carries BOTH a fill level and a weight:
# fill answers 'does this need emptying now', weight answers 'how much did we throw
# away', and one cannot stand in for the other.
# 
# The room on each floor is whichever of that floor's OWN rooms best matches a
# kitchen, break room, common area, atrium, reception, lobby or corridor.
#
# GENERATED by scripts/provision_damper_and_waste_points.py — re-runnable;
# ids are uuid5 of the point IRI, so running it twice changes nothing.

@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix brick:    <https://brickschema.org/schema/Brick#> .
@prefix ref:      <https://brickschema.org/schema/Brick/ref#> .
@prefix ontosage: <http://ontosage.org/capabilities#> .

@prefix bldg:     <http://abacwsbuilding.cardiff.ac.uk/abacws#> .

bldg:Floor0_General_Waste_Bin_Fill a ontosage:Waste_Fill_Sensor ;
    rdfs:label "Room 0.01 — Main Reception — general waste bin fill (percent full)" ;
    brick:hasLocation bldg:Room0.01 ;
    ref:hasExternalReference [
        a ref:TimeseriesReference ;
        ref:hasTimeseriesId "67d1a32f-2e7f-50f8-9baa-26ec9f028e96" ;
        ref:storedAt bldg:wastefill_data
    ] .

bldg:Floor0_General_Waste_Bin_Weight a ontosage:Waste_Weight_Sensor ;
    rdfs:label "Room 0.01 — Main Reception — general waste bin weight (kg)" ;
