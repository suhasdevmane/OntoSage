# SATURATE (V4-T08): simulated electric_power sensors for spaces the coverage
# audit found uninstrumented. Every sensor is labeled ontosage:isSimulated.
# Rows live in the narrow table 'submeter_data' (database_registry.yaml key).
@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix ref:   <https://brickschema.org/schema/Brick/ref#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ontosage: <http://ontosage.org/capabilities#> .
@prefix bldg:  <http://abacwsbuilding.cardiff.ac.uk/abacws#> .

<http://abacwsbuilding.cardiff.ac.uk/abacws#submeter_data>
    a ref:Database ;
    rdfs:label "Submeter Data" .

<http://abacwsbuilding.cardiff.ac.uk/abacws#Floor0_sat_electric_power>
    a brick:Electric_Power_Sensor ;
    rdfs:label "Floor0 electric_power [kW]"@en ;
    brick:hasLocation <http://abacwsbuilding.cardiff.ac.uk/abacws#Floor0> ;
    ontosage:isSimulated "true"^^xsd:boolean ;
    rdfs:comment "synthetic-saturation-v4" ;
    ref:hasExternalReference [
        a ref:TimeseriesReference ;
        ref:hasTimeseriesId "7132834f-208b-5401-9ae1-9160bd0ee5d7" ;
        ref:storedAt <http://abacwsbuilding.cardiff.ac.uk/abacws#submeter_data> ;
    ] .

<http://abacwsbuilding.cardiff.ac.uk/abacws#Floor1_sat_electric_power>
