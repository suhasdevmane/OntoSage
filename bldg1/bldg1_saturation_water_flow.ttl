# SATURATE (V4-T08): simulated water_flow sensors for spaces the coverage
# audit found uninstrumented. Every sensor is labeled ontosage:isSimulated.
# Rows live in the narrow table 'waterflow_data' (database_registry.yaml key).
@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix ref:   <https://brickschema.org/schema/Brick/ref#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ontosage: <http://ontosage.org/capabilities#> .
@prefix bldg:  <http://abacwsbuilding.cardiff.ac.uk/abacws#> .

<http://abacwsbuilding.cardiff.ac.uk/abacws#waterflow_data>
    a ref:Database ;
    rdfs:label "Waterflow Data" .

<http://abacwsbuilding.cardiff.ac.uk/abacws#Floor0_sat_water_flow>
    a brick:Water_Meter ;
    rdfs:label "Floor0 water_flow [L]"@en ;
    brick:hasLocation <http://abacwsbuilding.cardiff.ac.uk/abacws#Floor0> ;
    ontosage:isSimulated "true"^^xsd:boolean ;
    rdfs:comment "synthetic-saturation-v4" ;
    ref:hasExternalReference [
        a ref:TimeseriesReference ;
        ref:hasTimeseriesId "c74aaadb-e06a-5d4c-ac2b-ec0bb26056dd" ;
        ref:storedAt <http://abacwsbuilding.cardiff.ac.uk/abacws#waterflow_data> ;
    ] .

<http://abacwsbuilding.cardiff.ac.uk/abacws#Floor1_sat_water_flow>
