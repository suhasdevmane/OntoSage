# SATURATE (V4-T08): simulated noise sensors for spaces the coverage
# audit found uninstrumented. Every sensor is labeled ontosage:isSimulated.
# Rows live in the narrow table 'noise_data' (database_registry.yaml key).
@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix ref:   <https://brickschema.org/schema/Brick/ref#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ontosage: <http://ontosage.org/capabilities#> .
@prefix bldg:  <http://abacwsbuilding.cardiff.ac.uk/abacws#> .

<http://abacwsbuilding.cardiff.ac.uk/abacws#noise_data>
    a ref:Database ;
    rdfs:label "Noise Data" .

<http://abacwsbuilding.cardiff.ac.uk/abacws#Room0.01_sat_noise>
    a ontosage:Sound_Level_Sensor ;
    rdfs:label "Room 0.01 — Main Reception noise (simulated) [dB]"@en ;
    brick:hasLocation <http://abacwsbuilding.cardiff.ac.uk/abacws#Room0.01> ;
    ontosage:isSimulated "true"^^xsd:boolean ;
    rdfs:comment "synthetic-saturation-v4" ;
    ref:hasExternalReference [
        a ref:TimeseriesReference ;
        ref:hasTimeseriesId "84ecac3e-df8d-564b-b041-34c8be294922" ;
        ref:storedAt <http://abacwsbuilding.cardiff.ac.uk/abacws#noise_data> ;
    ] .

